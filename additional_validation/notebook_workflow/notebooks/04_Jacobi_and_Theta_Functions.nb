(* Content-type: application/vnd.wolfram.mathematica *)
(* Plain Mathematica notebook; input cells contain editable Wolfram Language. *)
Notebook[{
Cell["Jacobi theta functions and coefficient datasets", "Title"],

Cell["Additive Taylor and Laurent coefficients, eta quotients, and elliptic Fourier modes", "Subtitle"],

Cell["This notebook develops the theta-product families using the same theta convention as final.nb. The definitions, truncations and labels are visible in the cells below. The examples use small exact expansions; increase their orders after checking the displayed coefficients. Dataset generation and export are separate from training.", "Text"],

Cell[CellGroupData[{
Cell["1. Variables and setup", "Section"],

Cell["The repository uses EllipticTheta[a, u, Q], with additive argument u = π z and nome Q = exp(π i τ). The conventional modular variable is q = Q² = exp(2π i τ), and the multiplicative elliptic variable is y = exp(2π i z) = exp(2 i u). Throughout this notebook, a power of u refers to an additive Taylor or Laurent coefficient. A power of y refers to a different, elliptic Fourier expansion.", "Text"],

Cell[BoxData[RowBox[{"$HistoryLength", " ", "=", " ", "5", ";", "\n", "jacobiDatasetReady", " ", "=", " ", "False", ";", "\n", "baseDir", " ", "=", " ", "ParentDirectory", "[", "NotebookDirectory", "[", "]", "]", ";", "\n", "jacobiOutputDirectory", " ", "=", " ", "FileNameJoin", "[", "{", "baseDir", ",", " ", "\"generated\"", ",", " ", "\"jacobi\"", "}", "]", ";", "\n", "ClearAll", "[", "Q", ",", " ", "q", ",", " ", "u", ",", " ", "y", ",", " ", "JThetaUnit", ",", " ", "JThetaProductData", ",", " ", "JE2Nome", ",", "\n", "  ", "JThetaRows", ",", " ", "JAtOrder", ",", " ", "JLegacyEtaExponent", ",", " ", "JLaurentCoefficient", ",", "\n", "  ", "JPhiCoefficients", ",", " ", "JWeakJacobiParent", ",", " ", "JFourierRow", ",", "\n", "  ", "JSelectCoefficients", ",", " ", "JGroupSplit", "]", ";"}]], "Input" , CellTags -> "input-5", InitializationCell -> True],

Cell["For integer exponents p = {k,l,m,n}, the product θ₁ᵏ θ₂ˡ θ₃ᵐ θ₄ⁿ has weight K = (k+l+m+n)/2 and index M = (k+l+m+n)/2, with the relevant characteristics and multipliers. Division by ηʲ changes the weight to K−j/2 and leaves the index unchanged. Individual theta characteristics require a subgroup preserving them; no common full-modular-group scalar transformation is assumed here. Negative theta powers give meromorphic functions of the elliptic variable.", "Text"]
}, Open]],

Cell[CellGroupData[{
Cell["2. Exact theta expansions", "Section"],

Cell["Strip the known factor Q^(1/4) from θ₁ and θ₂, and also strip u from θ₁. The remaining functions have nonzero constant terms at Q=u=0, so their negative integer powers can be expanded without losing the original Laurent degree. The finite sums below contain every term needed through the requested relative Q order.", "Text"],

Cell[BoxData[RowBox[{"JThetaUnit", "[", "a", "_", "Integer", ",", " ", "qq", "_", ",", " ", "uu", "_", ",", " ", "order", "_", "Integer", "]", " ", "/;", " ", "order", " ", ">=", " ", "0", " ", ":=", "\n", "  ", "Switch", "[", "a", ",", "\n", "    ", "1", ",", " ", "2", " ", "Sum", "[", "(", "-", "1", ")", "^", "h", " ", "qq", "^", "(", "h", " ", "(", "h", " ", "+", " ", "1", ")", ")", " ", "Sin", "[", "(", "2", " ", "h", " ", "+", " ", "1", ")", " ", "uu", "]", "/", "uu", ",", "\n", "         ", "{", "h", ",", " ", "0", ",", " ", "Floor", "[", "(", "Sqrt", "[", "1", " ", "+", " ", "4", " ", "order", "]", " ", "-", " ", "1", ")", "/", "2", "]", "}", "]", ",", "\n", "    ", "2", ",", " ", "2", " ", "Sum", "[", "qq", "^", "(", "h", " ", "(", "h", " ", "+", " ", "1", ")", ")", " ", "Cos", "[", "(", "2", " ", "h", " ", "+", " ", "1", ")", " ", "uu", "]", ",", "\n", "         ", "{", "h", ",", " ", "0", ",", " ", "Floor", "[", "(", "Sqrt", "[", "1", " ", "+", " ", "4", " ", "order", "]", " ", "-", " ", "1", ")", "/", "2", "]", "}", "]", ",", "\n", "    ", "3", ",", " ", "1", " ", "+", " ", "2", " ", "Sum", "[", "qq", "^", "(", "h", "^", "2", ")", " ", "Cos", "[", "2", " ", "h", " ", "uu", "]", ",", " ", "{", "h", ",", " ", "1", ",", " ", "Floor", "[", "Sqrt", "[", "order", "]", "]", "}", "]", ",", "\n", "    ", "4", ",", " ", "1", " ", "+", " ", "2", " ", "Sum", "[", "(", "-", "1", ")", "^", "h", " ", "qq", "^", "(", "h", "^", "2", ")", " ", "Cos", "[", "2", " ", "h", " ", "uu", "]", ",", "\n", "         ", "{", "h", ",", " ", "1", ",", " ", "Floor", "[", "Sqrt", "[", "order", "]", "]", "}", "]", ",", "\n", "    ", "_", ",", " ", "Failure", "[", "\"ThetaIndex\"", ",", " ", "<|", "\"MessageTemplate\"", " ", "->", " ", "\"Use theta index 1, 2, 3 or 4.\"", "|>", "]", "\n", "  ", "]", ";", "\n", "JE2Nome", "[", "qq", "_", ",", " ", "order", "_", "Integer", "]", " ", ":=", "\n", "  ", "1", " ", "-", " ", "24", " ", "Sum", "[", "DivisorSigma", "[", "1", ",", " ", "h", "]", " ", "qq", "^", "(", "2", " ", "h", ")", ",", " ", "{", "h", ",", " ", "1", ",", " ", "Floor", "[", "order", "/", "2", "]", "}", "]", ";"}]], "Input" , CellTags -> "input-9", InitializationCell -> True],

Cell[BoxData[RowBox[{"Table", "[", "\n", "  ", "{", "a", ",", " ", "Expand", "[", "Q", "^", "If", "[", "a", " ", "<=", " ", "2", ",", " ", "1", "/", "4", ",", " ", "0", "]", " ", "If", "[", "a", " ", "==", " ", "1", ",", " ", "u", ",", " ", "1", "]", "\n", "      ", "JThetaUnit", "[", "a", ",", " ", "Q", ",", " ", "u", ",", " ", "6", "]", "]", "}", ",", "\n", "  ", "{", "a", ",", " ", "1", ",", " ", "4", "}", "\n", "]", " ", "//", " ", "TableForm"}]], "Input" , CellTags -> "input-10"],

Cell["A product or an eta quotient", "Subsection"],

Cell["JThetaProductData[p, nomeCutoff, uCutoff, j] represents θ₁ᵏ θ₂ˡ θ₃ᵐ θ₄ⁿ/ηʲ. Here nomeCutoff is an absolute upper bound on the exponent of Q, and uCutoff is the largest original additive exponent retained. The full expression is Q^s u^k times the returned reduced polynomial, with s=(k+l)/4−j/12. The calculation first truncates the nome expansion and then the additive expansion. All arithmetic remains exact.", "Text"],

Cell["The eta convention is η(τ)=Q^(1/12)∏ₕ≥₁(1−Q^(2h)). The generator below takes integer theta and eta exponents. It deliberately does not choose branches for arbitrary noninteger theta powers. For negative k, the additive expansion starts at u^k; that degree is retained in the exported labels.", "Text"],

Cell[BoxData[RowBox[{"JThetaProductData", "[", "p", "_", "List", ",", " ", "nomeCutoff", "_", "Integer", ",", " ", "uCutoff", "_", "Integer", ",", "\n", "    ", "etaExponent", "_", "Integer", " ", ":", " ", "0", "]", " ", ":=", " ", "Module", "[", "\n", "  ", "{", "qq", ",", " ", "uu", ",", " ", "shift", ",", " ", "relativeOrder", ",", " ", "additiveOrder", ",", " ", "thetaUnit", ",", " ", "etaUnit", ",", "\n", "   ", "nomeJet", ",", " ", "polynomial", "}", ",", "\n", "  ", "If", "[", "Length", "[", "p", "]", " ", "!=", " ", "4", " ", "||", " ", "!", "AllTrue", "[", "p", ",", " ", "IntegerQ", "]", ",", "\n", "    ", "Return", "[", "Failure", "[", "\"ThetaPowers\"", ",", " ", "<|", "\"MessageTemplate\"", " ", "->", "\n", "      ", "\"Supply four integer theta exponents.\"", "|>", "]", "]", "]", ";", "\n", "  ", "shift", " ", "=", " ", "(", "p", "[", "[", "1", "]", "]", " ", "+", " ", "p", "[", "[", "2", "]", "]", ")", "/", "4", " ", "-", " ", "etaExponent", "/", "12", ";", "\n", "  ", "relativeOrder", " ", "=", " ", "Floor", "[", "nomeCutoff", " ", "-", " ", "shift", "]", ";", "\n", "  ", "additiveOrder", " ", "=", " ", "uCutoff", " ", "-", " ", "p", "[", "[", "1", "]", "]", ";", "\n", "  ", "If", "[", "relativeOrder", " ", "<", " ", "0", " ", "||", " ", "additiveOrder", " ", "<", " ", "0", ",", "\n", "    ", "Return", "[", "Failure", "[", "\"ExpansionRange\"", ",", " ", "<|", "\"MessageTemplate\"", " ", "->", "\n", "      ", "\"Increase the nome or additive cutoff to include the leading term.\"", "|>", "]", "]", "]", ";", "\n", "  ", "thetaUnit", " ", "=", " ", "Times", " ", "@@", " ", "MapThread", "[", "Power", ",", "\n", "    ", "{", "Table", "[", "JThetaUnit", "[", "a", ",", " ", "qq", ",", " ", "uu", ",", " ", "relativeOrder", "]", ",", " ", "{", "a", ",", " ", "1", ",", " ", "4", "}", "]", ",", " ", "p", "}", "]", ";", "\n", "  ", "etaUnit", " ", "=", " ", "Product", "[", "(", "1", " ", "-", " ", "qq", "^", "(", "2", " ", "h", ")", ")", "^", "(", "-", "etaExponent", ")", ",", "\n", "    ", "{", "h", ",", " ", "1", ",", " ", "Floor", "[", "relativeOrder", "/", "2", "]", "}", "]", ";", "\n", "  ", "nomeJet", " ", "=", " ", "Normal", "[", "Series", "[", "thetaUnit", " ", "etaUnit", ",", " ", "{", "qq", ",", " ", "0", ",", " ", "relativeOrder", "}", "]", "]", ";", "\n", "  ", "polynomial", " ", "=", " ", "Expand", "[", "Normal", "[", "Series", "[", "nomeJet", ",", " ", "{", "uu", ",", " ", "0", ",", " ", "additiveOrder", "}", "]", "]", "]", ";", "\n", "  ", "<|", "\"Powers\"", " ", "->", " ", "p", ",", " ", "\"EtaExponent\"", " ", "->", " ", "etaExponent", ",", "\n", "    ", "\"ParentWeight\"", " ", "->", " ", "Total", "[", "p", "]", "/", "2", " ", "-", " ", "etaExponent", "/", "2", ",", "\n", "    ", "\"Index\"", " ", "->", " ", "Total", "[", "p", "]", "/", "2", ",", " ", "\"QShift\"", " ", "->", " ", "shift", ",", "\n", "    ", "\"UMin\"", " ", "->", " ", "p", "[", "[", "1", "]", "]", ",", " ", "\"UMax\"", " ", "->", " ", "uCutoff", ",", "\n", "    ", "\"NomeCutoff\"", " ", "->", " ", "nomeCutoff", ",", " ", "\"RelativeQOrder\"", " ", "->", " ", "relativeOrder", ",", "\n", "    ", "\"QSymbol\"", " ", "->", " ", "qq", ",", " ", "\"USymbol\"", " ", "->", " ", "uu", ",", "\n", "    ", "\"ReducedPolynomial\"", " ", "->", " ", "polynomial", "|>", "\n", "]", ";", "\n", "JThetaProductData", "[", "___", "]", " ", ":=", " ", "Failure", "[", "\"ThetaArguments\"", ",", " ", "<|", "\"MessageTemplate\"", " ", "->", "\n", "  ", "\"Use a list of four integer theta powers, two integer cutoffs and an integer eta exponent.\"", "|>", "]", ";"}]], "Input" , CellTags -> "input-14", InitializationCell -> True],

Cell[BoxData[RowBox[{"parentPowers", " ", "=", " ", "{", "1", ",", " ", "0", ",", " ", "0", ",", " ", "0", "}", ";", "\n", "etaExponent", " ", "=", " ", "0", ";", "\n", "nomeCutoff", " ", "=", " ", "6", ";", "\n", "uCutoff", " ", "=", " ", "7", ";", "\n", "exampleProduct", " ", "=", " ", "JThetaProductData", "[", "parentPowers", ",", " ", "nomeCutoff", ",", "\n", "  ", "uCutoff", ",", " ", "etaExponent", "]", ";", "\n", "exampleProduct", "[", "\"ReducedPolynomial\"", "]", " ", "/.", "\n", "  ", "{", "exampleProduct", "[", "\"QSymbol\"", "]", " ", "->", " ", "Q", ",", " ", "exampleProduct", "[", "\"USymbol\"", "]", " ", "->", " ", "u", "}"}]], "Input" , CellTags -> "input-15"],

Cell["From coefficients to labelled rows", "Subsection"],

Cell["Write the full product as Σᵣ Fᵣ(τ) uʳ. The additive degree r and the parent weight give the total weight label K+r. Raw coefficients generally transform quasimodularly, mixing with lower additive degrees. Positions gives the relative Q degrees used as input coordinates; QPositions and ModularQPositions give the absolute Q and q exponents. The prefactor Q^s is stored separately; removing it for an input vector is a representation choice and is not a claim that the shifted series has the same modular transformation law. Zero coefficient positions are retained.", "Text"],

Cell[BoxData[RowBox[{"JThetaRows", "[", "data", "_", "Association", ",", " ", "corrected", "_", " ", ":", " ", "False", "]", " ", ":=", " ", "Module", "[", "\n", "  ", "{", "qq", " ", "=", " ", "data", "[", "\"QSymbol\"", "]", ",", " ", "uu", " ", "=", " ", "data", "[", "\"USymbol\"", "]", ",", "\n", "   ", "order", " ", "=", " ", "data", "[", "\"RelativeQOrder\"", "]", ",", " ", "low", " ", "=", " ", "data", "[", "\"UMin\"", "]", ",", "\n", "   ", "high", " ", "=", " ", "data", "[", "\"UMax\"", "]", ",", " ", "polynomial", " ", "=", " ", "data", "[", "\"ReducedPolynomial\"", "]", ",", "\n", "   ", "correction", ",", " ", "group", ",", " ", "kind", ",", " ", "coefficients", ",", " ", "nz", ",", " ", "positions", "}", ",", "\n", "  ", "If", "[", "!", "MemberQ", "[", "{", "True", ",", " ", "False", "}", ",", " ", "corrected", "]", ",", "\n", "    ", "Return", "[", "Failure", "[", "\"CorrectionOption\"", ",", " ", "<|", "\"MessageTemplate\"", " ", "->", "\n", "      ", "\"The correction option must be True or False.\"", "|>", "]", "]", "]", ";", "\n", "  ", "If", "[", "TrueQ", "[", "corrected", "]", ",", "\n", "    ", "correction", " ", "=", " ", "Sum", "[", "(", "data", "[", "\"Index\"", "]", " ", "JE2Nome", "[", "qq", ",", " ", "order", "]", " ", "uu", "^", "2", "/", "3", ")", "^", "h", "/", "h", "!", ",", "\n", "      ", "{", "h", ",", " ", "0", ",", " ", "Floor", "[", "(", "high", " ", "-", " ", "low", ")", "/", "2", "]", "}", "]", ";", "\n", "    ", "polynomial", " ", "=", " ", "Expand", "[", "Normal", "[", "Series", "[", "\n", "      ", "Normal", "[", "Series", "[", "polynomial", " ", "correction", ",", " ", "{", "qq", ",", " ", "0", ",", " ", "order", "}", "]", "]", ",", "\n", "      ", "{", "uu", ",", " ", "0", ",", " ", "high", " ", "-", " ", "low", "}", "]", "]", "]", "]", ";", "\n", "  ", "group", " ", "=", " ", "\"theta_\"", " ", "<>", " ", "StringRiffle", "[", "ToString", " ", "/@", " ", "data", "[", "\"Powers\"", "]", ",", " ", "\"_\"", "]", " ", "<>", "\n", "    ", "\"_eta_\"", " ", "<>", " ", "ToString", "[", "data", "[", "\"EtaExponent\"", "]", "]", ";", "\n", "  ", "kind", " ", "=", " ", "If", "[", "TrueQ", "[", "corrected", "]", ",", " ", "\"CorrectedAdditiveJet\"", ",", " ", "\"RawAdditiveJet\"", "]", ";", "\n", "  ", "positions", " ", "=", " ", "data", "[", "\"QShift\"", "]", " ", "+", " ", "Range", "[", "0", ",", " ", "order", "]", ";", "\n", "  ", "Table", "[", "\n", "    ", "coefficients", " ", "=", " ", "Table", "[", "Coefficient", "[", "\n", "      ", "Coefficient", "[", "polynomial", ",", " ", "uu", ",", " ", "r", " ", "-", " ", "low", "]", ",", " ", "qq", ",", " ", "h", "]", ",", " ", "{", "h", ",", " ", "0", ",", " ", "order", "}", "]", ";", "\n", "    ", "nz", " ", "=", " ", "Select", "[", "Range", "[", "Length", "[", "coefficients", "]", "]", ",", " ", "coefficients", "[", "[", "#", "]", "]", " ", "=!=", " ", "0", " ", "&", "]", ";", "\n", "    ", "If", "[", "nz", " ", "===", " ", "{", "}", ",", " ", "Nothing", ",", "\n", "      ", "<|", "\"ID\"", " ", "->", " ", "group", " ", "<>", " ", "\"_\"", " ", "<>", " ", "kind", " ", "<>", " ", "\"_r\"", " ", "<>", " ", "ToString", "[", "r", "]", ",", "\n", "        ", "\"Group\"", " ", "->", " ", "group", ",", " ", "\"Family\"", " ", "->", " ", "kind", ",", "\n", "        ", "\"Target\"", " ", "->", " ", "data", "[", "\"ParentWeight\"", "]", " ", "+", " ", "r", ",", "\n", "        ", "\"TaylorOrder\"", " ", "->", " ", "r", ",", " ", "\"Coefficients\"", " ", "->", " ", "coefficients", ",", "\n", "        ", "\"Positions\"", " ", "->", " ", "Range", "[", "0", ",", " ", "order", "]", ",", " ", "\"QPositions\"", " ", "->", " ", "positions", ",", "\n", "        ", "\"ModularQPositions\"", " ", "->", " ", "positions", "/", "2", ",", "\n", "        ", "\"Metadata\"", " ", "->", " ", "<|", "\"ThetaPowers\"", " ", "->", " ", "data", "[", "\"Powers\"", "]", ",", "\n", "          ", "\"EtaExponent\"", " ", "->", " ", "data", "[", "\"EtaExponent\"", "]", ",", "\n", "          ", "\"ParentWeight\"", " ", "->", " ", "data", "[", "\"ParentWeight\"", "]", ",", " ", "\"Index\"", " ", "->", " ", "data", "[", "\"Index\"", "]", ",", "\n", "          ", "\"AdditiveVariable\"", " ", "->", " ", "\"u=Pi z\"", ",", " ", "\"Nome\"", " ", "->", " ", "\"Q=Exp[Pi I tau]\"", ",", "\n", "          ", "\"ModularVariable\"", " ", "->", " ", "\"q=Q^2\"", ",", " ", "\"QShift\"", " ", "->", " ", "data", "[", "\"QShift\"", "]", ",", "\n", "          ", "\"ActualLeadingQPower\"", " ", "->", " ", "positions", "[", "[", "First", "[", "nz", "]", "]", "]", ",", "\n", "          ", "\"FeaturePositions\"", " ", "->", " ", "\"Relative Q degrees after removing QShift\"", ",", "\n", "          ", "\"AbsoluteQPositions\"", " ", "->", " ", "positions", ",", " ", "\"AbsoluteModularQPositions\"", " ", "->", " ", "positions", "/", "2", ",", "\n", "          ", "\"Corrected\"", " ", "->", " ", "TrueQ", "[", "corrected", "]", ",", "\n", "          ", "\"Correction\"", " ", "->", " ", "If", "[", "TrueQ", "[", "corrected", "]", ",", " ", "\"Exp[Index E2(Q^2) u^2/3]\"", ",", " ", "\"None\"", "]", ",", "\n", "          ", "\"MeromorphicInEllipticVariable\"", " ", "->", " ", "AnyTrue", "[", "data", "[", "\"Powers\"", "]", ",", " ", "#", " ", "<", " ", "0", " ", "&", "]", ",", "\n", "          ", "\"CoefficientSelection\"", " ", "->", " ", "\"AllPositions\"", ",", " ", "\"SplitUnit\"", " ", "->", " ", "\"Group\"", "|>", "|>", "]", ",", "\n", "    ", "{", "r", ",", " ", "low", ",", " ", "high", "}", "]", "\n", "]", ";", "\n", "JAtOrder", "[", "data", "_", "Association", ",", " ", "r", "_", "Integer", ",", " ", "corrected", "_", " ", ":", " ", "False", "]", " ", ":=", " ", "Module", "[", "{", "row", "}", ",", "\n", "  ", "row", " ", "=", " ", "SelectFirst", "[", "JThetaRows", "[", "data", ",", " ", "corrected", "]", ",", " ", "#", " ", "[", "\"TaylorOrder\"", "]", " ", "==", " ", "r", " ", "&", ",", " ", "<|", "|>", "]", ";", "\n", "  ", "Lookup", "[", "row", ",", " ", "\"Coefficients\"", ",", " ", "ConstantArray", "[", "0", ",", " ", "data", "[", "\"RelativeQOrder\"", "]", " ", "+", " ", "1", "]", "]", "\n", "]", ";"}]], "Input" , CellTags -> "input-18", InitializationCell -> True],

Cell[BoxData[RowBox[{"exampleRows", " ", "=", " ", "JThetaRows", "[", "exampleProduct", "]", ";", "\n", "Dataset", "[", "KeyTake", "[", "#", ",", " ", "{", "\"TaylorOrder\"", ",", " ", "\"Target\"", ",", " ", "\"Coefficients\"", ",", " ", "\"QPositions\"", "}", "]", " ", "&", " ", "/@", "\n", "  ", "exampleRows", "]"}]], "Input" , CellTags -> "input-19"],

Cell["Meromorphic example: a negative theta power", "Subsection"],

Cell["A negative θ₁ exponent produces a pole at u=0. The shift used internally makes the expansion regular, but the original Laurent order remains in TaylorOrder. Negative θ₂, θ₃ or θ₄ powers are regular at u=0 for generic τ, although they have poles elsewhere in the elliptic variable. The local Laurent calculation here does not require an elliptic Fourier contour.", "Text"],

Cell[BoxData[RowBox[{"negativeExample", " ", "=", " ", "JThetaProductData", "[", "{", "-", "1", ",", " ", "0", ",", " ", "0", ",", " ", "0", "}", ",", " ", "4", ",", " ", "5", "]", ";", "\n", "Dataset", "[", "KeyTake", "[", "#", ",", " ", "{", "\"TaylorOrder\"", ",", " ", "\"Target\"", ",", " ", "\"Coefficients\"", ",", " ", "\"QPositions\"", "}", "]", " ", "&", " ", "/@", "\n", "  ", "JThetaRows", "[", "negativeExample", "]", "]"}]], "Input" , CellTags -> "input-22"]
}, Open]],

Cell[CellGroupData[{
Cell["3. Eta division and modular additive coefficients", "Section"],

Cell["The quotient parameter used in the repository", "Subsection"],

Cell["The repository also specifies eta division through a parameter βQ and the indicator α=1 when either θ₃ or θ₄ occurs, and α=0 otherwise. Its exponent on Δ₂=η²⁴ is A=½[(k+l)/4+α−βQ]. The corresponding eta exponent is j=24A=3(k+l)+12α−12βQ. Here βQ is expressed in Q units. An individual additive coefficient may start later because its early terms vanish, so the actual leading order is recorded separately.", "Text"],

Cell[BoxData[RowBox[{"JLegacyEtaExponent", "[", "p", "_", "List", ",", " ", "betaQ", "_", "]", " ", "/;", " ", "Length", "[", "p", "]", " ", "==", " ", "4", " ", ":=", "\n", "  ", "3", " ", "(", "p", "[", "[", "1", "]", "]", " ", "+", " ", "p", "[", "[", "2", "]", "]", ")", " ", "+", "\n", "    ", "12", " ", "If", "[", "p", "[", "[", "3", "]", "]", " ", "!=", " ", "0", " ", "||", " ", "p", "[", "[", "4", "]", "]", " ", "!=", " ", "0", ",", " ", "1", ",", " ", "0", "]", " ", "-", " ", "12", " ", "betaQ", ";", "\n", "quotientPowers", " ", "=", " ", "{", "1", ",", " ", "0", ",", " ", "0", ",", " ", "0", "}", ";", "\n", "betaQ", " ", "=", " ", "0", ";", "\n", "quotientEtaExponent", " ", "=", " ", "JLegacyEtaExponent", "[", "quotientPowers", ",", " ", "betaQ", "]", ";", "\n", "quotientExample", " ", "=", " ", "JThetaProductData", "[", "quotientPowers", ",", " ", "6", ",", " ", "7", ",", "\n", "  ", "quotientEtaExponent", "]", ";", "\n", "Dataset", "[", "JThetaRows", "[", "quotientExample", "]", "]"}]], "Input" , CellTags -> "input-26"],

Cell["An optional E₂ correction", "Subsection"],

Cell["For an index-M Jacobi transformation in z=u/π, multiplying by exp[M E₂(τ)u²/3] cancels the quadratic modular anomaly. Thus the coefficient of uʳ in this corrected expression transforms with weight K+r on the subgroup preserving the theta characteristics, with the inherited multiplier. This is a different dataset from the raw additive coefficients. The same formula applies to a local Laurent expansion with a finite principal part; possible poles and cusp growth remain part of its analytic classification.", "Text"],

Cell["The sign and scale of this correction depend on the additive variable. In the variable t=2π i z=2 i u it is exp[−M E₂(τ)t²/12]. Here JE2Nome uses E₂(τ)=1−24 Σₙ≥₁ σ₁(n)Q^(2n). For θ₁/η³, the u coefficient is 2 and the corrected u³ coefficient vanishes.", "Text"],

Cell[BoxData[RowBox[{"rawQuotientRows", " ", "=", " ", "JThetaRows", "[", "quotientExample", ",", " ", "False", "]", ";", "\n", "correctedQuotientRows", " ", "=", " ", "JThetaRows", "[", "quotientExample", ",", " ", "True", "]", ";", "\n", "<|", "\"Raw u coefficient\"", " ", "->", " ", "JAtOrder", "[", "quotientExample", ",", " ", "1", "]", ",", "\n", "  ", "\"Raw u^3 coefficient\"", " ", "->", " ", "JAtOrder", "[", "quotientExample", ",", " ", "3", "]", ",", "\n", "  ", "\"Corrected u^3 coefficient\"", " ", "->", " ", "JAtOrder", "[", "quotientExample", ",", " ", "3", ",", " ", "True", "]", ",", "\n", "  ", "\"Corrected u^5 coefficient\"", " ", "->", " ", "JAtOrder", "[", "quotientExample", ",", " ", "5", ",", " ", "True", "]", "|>"}]], "Input" , CellTags -> "input-30"]
}, Open]],

Cell[CellGroupData[{
Cell["4. Multiplicative elliptic modes", "Section"],

Cell["The preceding rows come from powers of the additive variable u. To study multiplicative modes, write the function in y=exp(2 i u) instead. For example θ₃=Σᵣ Q^(r²)yʳ. Its fixed-yʳ coefficient is Q^(r²), whereas its additive uʳ coefficient comes from expanding the entire sum. These two coefficient operations should be selected explicitly.", "Text"],

Cell[BoxData[RowBox[{"multiplicativeNomeCutoff", " ", "=", " ", "9", ";", "\n", "theta3InY", " ", "=", " ", "Sum", "[", "Q", "^", "(", "r", "^", "2", ")", " ", "y", "^", "r", ",", "\n", "  ", "{", "r", ",", " ", "-", "Floor", "[", "Sqrt", "[", "multiplicativeNomeCutoff", "]", "]", ",", "\n", "       ", "Floor", "[", "Sqrt", "[", "multiplicativeNomeCutoff", "]", "]", "}", "]", ";", "\n", "theta3InY", " ", "//", " ", "Expand"}]], "Input" , CellTags -> "input-33"],

Cell["For a holomorphic or weak Jacobi form of positive integral index M, write φ(τ,z)=Σᵣ Fᵣ(τ)yʳ. The corrected modes Hμ(τ)=q^(−r²/(4M))Fᵣ(τ), with r≡μ mod 2M, give its theta decomposition. The vector H has weight K−1/2 and its components mix under modular transformations. A fixed uncorrected Fᵣ is therefore not assigned an independent scalar modular weight here. For meromorphic Jacobi forms, multiplicative expansions additionally require a contour or chamber prescription; this notebook confines the multiplicative dataset below to weak Jacobi forms.", "Text"],

Cell["A fixed-index family", "Subsection"],

Cell["A useful exact family is φ₋₂,₁ E₄ᵃ E₆ᵇ with a,b nonnegative integers. Its weight is −2+4a+6b and its index is 1. In the additive convention used above, φ₋₂,₁=−θ₁(u,Q)²/η(τ)⁶. The product identity φ₋₂,₁=(y+y⁻¹−2)∏ₙ≥₁[(1−yqⁿ)²(1−y⁻¹qⁿ)²/(1−qⁿ)⁴] supplies finite Laurent-polynomial coefficients at every q order. The following recurrence is obtained by differentiating the logarithm of that product; it uses exact arithmetic and retains the full y dependence.", "Text"],

Cell[BoxData[RowBox[{"JPhiCoefficients", "[", "order", "_", "Integer", ",", " ", "yy", "_", "Symbol", "]", " ", "/;", " ", "order", " ", ">=", " ", "0", " ", ":=", " ", "Module", "[", "\n", "  ", "{", "p", " ", "=", " ", "ConstantArray", "[", "0", ",", " ", "order", " ", "+", " ", "1", "]", ",", " ", "logarithmicDerivative", "}", ",", "\n", "  ", "p", "[", "[", "1", "]", "]", " ", "=", " ", "1", ";", "\n", "  ", "logarithmicDerivative", " ", "=", " ", "Table", "[", "\n", "    ", "Expand", "[", "Total", "[", "(", "h", "/", "#", ")", " ", "(", "4", " ", "-", " ", "2", " ", "yy", "^", "#", " ", "-", " ", "2", " ", "yy", "^", "(", "-", "#", ")", ")", " ", "&", " ", "/@", " ", "Divisors", "[", "h", "]", "]", "]", ",", "\n", "    ", "{", "h", ",", " ", "1", ",", " ", "order", "}", "]", ";", "\n", "  ", "Do", "[", "p", "[", "[", "h", " ", "+", " ", "1", "]", "]", " ", "=", " ", "Expand", "[", "Sum", "[", "\n", "    ", "logarithmicDerivative", "[", "[", "j", "]", "]", " ", "p", "[", "[", "h", " ", "-", " ", "j", " ", "+", " ", "1", "]", "]", ",", " ", "{", "j", ",", " ", "1", ",", " ", "h", "}", "]", "/", "h", "]", ",", "\n", "    ", "{", "h", ",", " ", "1", ",", " ", "order", "}", "]", ";", "\n", "  ", "Expand", "[", "(", "yy", " ", "+", " ", "yy", "^", "-", "1", " ", "-", " ", "2", ")", " ", "#", "]", " ", "&", " ", "/@", " ", "p", "\n", "]", ";", "\n", "JLaurentCoefficient", "[", "polynomial", "_", ",", " ", "yy", "_", "Symbol", ",", " ", "r", "_", "Integer", "]", " ", ":=", " ", "Module", "[", "{", "shift", "}", ",", "\n", "  ", "If", "[", "TrueQ", "[", "polynomial", " ", "==", " ", "0", "]", ",", " ", "Return", "[", "0", "]", "]", ";", "\n", "  ", "shift", " ", "=", " ", "Max", "[", "0", ",", " ", "-", "Exponent", "[", "polynomial", ",", " ", "yy", ",", " ", "Min", "]", "]", ";", "\n", "  ", "If", "[", "r", " ", "+", " ", "shift", " ", "<", " ", "0", ",", " ", "0", ",", "\n", "    ", "Coefficient", "[", "Expand", "[", "yy", "^", "shift", " ", "polynomial", "]", ",", " ", "yy", ",", " ", "r", " ", "+", " ", "shift", "]", "]", "\n", "]", ";", "\n", "JWeakJacobiParent", "[", "a", "_", "Integer", ",", " ", "b", "_", "Integer", ",", " ", "order", "_", "Integer", "]", " ", "/;", "\n", "    ", "Min", "[", "a", ",", " ", "b", ",", " ", "order", "]", " ", ">=", " ", "0", " ", ":=", " ", "Module", "[", "{", "qq", ",", " ", "yy", ",", " ", "phi", ",", " ", "e4", ",", " ", "e6", ",", " ", "polynomial", "}", ",", "\n", "  ", "phi", " ", "=", " ", "JPhiCoefficients", "[", "order", ",", " ", "yy", "]", ";", "\n", "  ", "e4", " ", "=", " ", "1", " ", "+", " ", "240", " ", "Sum", "[", "DivisorSigma", "[", "3", ",", " ", "h", "]", " ", "qq", "^", "h", ",", " ", "{", "h", ",", " ", "1", ",", " ", "order", "}", "]", ";", "\n", "  ", "e6", " ", "=", " ", "1", " ", "-", " ", "504", " ", "Sum", "[", "DivisorSigma", "[", "5", ",", " ", "h", "]", " ", "qq", "^", "h", ",", " ", "{", "h", ",", " ", "1", ",", " ", "order", "}", "]", ";", "\n", "  ", "polynomial", " ", "=", " ", "Expand", "[", "Normal", "[", "Series", "[", "\n", "    ", "Sum", "[", "phi", "[", "[", "h", " ", "+", " ", "1", "]", "]", " ", "qq", "^", "h", ",", " ", "{", "h", ",", " ", "0", ",", " ", "order", "}", "]", " ", "e4", "^", "a", " ", "e6", "^", "b", ",", "\n", "    ", "{", "qq", ",", " ", "0", ",", " ", "order", "}", "]", "]", "]", ";", "\n", "  ", "<|", "\"E4Power\"", " ", "->", " ", "a", ",", " ", "\"E6Power\"", " ", "->", " ", "b", ",", " ", "\"Weight\"", " ", "->", " ", "-", "2", " ", "+", " ", "4", " ", "a", " ", "+", " ", "6", " ", "b", ",", "\n", "    ", "\"Index\"", " ", "->", " ", "1", ",", " ", "\"QOrder\"", " ", "->", " ", "order", ",", " ", "\"YSymbol\"", " ", "->", " ", "yy", ",", "\n", "    ", "\"CoefficientsInQ\"", " ", "->", " ", "Table", "[", "Coefficient", "[", "polynomial", ",", " ", "qq", ",", " ", "h", "]", ",", "\n", "      ", "{", "h", ",", " ", "0", ",", " ", "order", "}", "]", "|>", "\n", "]", ";", "\n", "JWeakJacobiParent", "[", "___", "]", " ", ":=", " ", "Failure", "[", "\"WeakJacobiArguments\"", ",", " ", "<|", "\"MessageTemplate\"", " ", "->", "\n", "  ", "\"Use nonnegative integer E4 and E6 powers and a nonnegative integer q order.\"", "|>", "]", ";"}]], "Input" , CellTags -> "input-37", InitializationCell -> True],

Cell[BoxData[RowBox[{"JFourierRow", "[", "parent", "_", "Association", ",", " ", "r", "_", "Integer", ",", " ", "thetaComponent", "_", " ", ":", " ", "False", "]", " ", ":=", " ", "Module", "[", "\n", "  ", "{", "coefficients", ",", " ", "group", ",", " ", "shift", ",", " ", "kind", "}", ",", "\n", "  ", "If", "[", "!", "MemberQ", "[", "{", "True", ",", " ", "False", "}", ",", " ", "thetaComponent", "]", ",", "\n", "    ", "Return", "[", "Failure", "[", "\"ComponentOption\"", ",", " ", "<|", "\"MessageTemplate\"", " ", "->", "\n", "      ", "\"The theta-component option must be True or False.\"", "|>", "]", "]", "]", ";", "\n", "  ", "If", "[", "TrueQ", "[", "thetaComponent", "]", " ", "&&", " ", "!", "MemberQ", "[", "{", "0", ",", " ", "1", "}", ",", " ", "r", "]", ",", "\n", "    ", "Return", "[", "Failure", "[", "\"ThetaComponent\"", ",", " ", "<|", "\"MessageTemplate\"", " ", "->", "\n", "      ", "\"For index 1 choose representative 0 or 1.\"", "|>", "]", "]", "]", ";", "\n", "  ", "coefficients", " ", "=", " ", "JLaurentCoefficient", "[", "#", ",", " ", "parent", "[", "\"YSymbol\"", "]", ",", " ", "r", "]", " ", "&", " ", "/@", "\n", "    ", "parent", "[", "\"CoefficientsInQ\"", "]", ";", "\n", "  ", "group", " ", "=", " ", "\"phi_a\"", " ", "<>", " ", "ToString", "[", "parent", "[", "\"E4Power\"", "]", "]", " ", "<>", "\n", "    ", "\"_b\"", " ", "<>", " ", "ToString", "[", "parent", "[", "\"E6Power\"", "]", "]", ";", "\n", "  ", "shift", " ", "=", " ", "If", "[", "TrueQ", "[", "thetaComponent", "]", ",", " ", "-", "r", "^", "2", "/", "4", ",", " ", "0", "]", ";", "\n", "  ", "kind", " ", "=", " ", "If", "[", "TrueQ", "[", "thetaComponent", "]", ",", " ", "\"ThetaComponent\"", ",", " ", "\"FixedYMode\"", "]", ";", "\n", "  ", "<|", "\"ID\"", " ", "->", " ", "group", " ", "<>", " ", "\"_\"", " ", "<>", " ", "kind", " ", "<>", " ", "\"_r\"", " ", "<>", " ", "ToString", "[", "r", "]", ",", "\n", "    ", "\"Group\"", " ", "->", " ", "group", ",", " ", "\"Family\"