Cell[CellGroupData[{
Cell["5. Small exact checks", "Section"],

Cell["These checks exercise the theta normalization, the Laurent leading degree, eta division, the E₂ correction and the multiplicative product. They do not train a network. The numerical check compares the finite theta sums with built-in EllipticTheta at a small positive nome, where the omitted tail is much smaller than the test tolerance.", "Text"],

Cell[BoxData[RowBox[{"jacobiChecks", " ", "=", " ", "TestReport", "[", "{", "\n", "  ", "VerificationTest", "[", "\n", "    ", "JAtOrder", "[", "JThetaProductData", "[", "{", "1", ",", " ", "0", ",", " ", "0", ",", " ", "0", "}", ",", " ", "5", ",", " ", "3", "]", ",", " ", "1", "]", ",", "\n", "    ", "{", "2", ",", " ", "0", ",", " ", "-", "6", ",", " ", "0", ",", " ", "0", "}", ",", " ", "TestID", " ", "->", " ", "\"theta1-additive-normalization\"", "]", ",", "\n", "  ", "VerificationTest", "[", "\n", "    ", "JAtOrder", "[", "JThetaProductData", "[", "{", "0", ",", " ", "1", ",", " ", "0", ",", " ", "0", "}", ",", " ", "5", ",", " ", "2", "]", ",", " ", "0", "]", ",", "\n", "    ", "{", "2", ",", " ", "0", ",", " ", "2", ",", " ", "0", ",", " ", "0", "}", ",", " ", "TestID", " ", "->", " ", "\"theta2-additive-normalization\"", "]", ",", "\n", "  ", "VerificationTest", "[", "\n", "    ", "JAtOrder", "[", "JThetaProductData", "[", "{", "0", ",", " ", "0", ",", " ", "1", ",", " ", "0", "}", ",", " ", "4", ",", " ", "2", "]", ",", " ", "0", "]", ",", "\n", "    ", "{", "1", ",", " ", "2", ",", " ", "0", ",", " ", "0", ",", " ", "2", "}", ",", " ", "TestID", " ", "->", " ", "\"theta3-nome-positions\"", "]", ",", "\n", "  ", "VerificationTest", "[", "\n", "    ", "JAtOrder", "[", "JThetaProductData", "[", "{", "0", ",", " ", "0", ",", " ", "0", ",", " ", "1", "}", ",", " ", "4", ",", " ", "2", "]", ",", " ", "0", "]", ",", "\n", "    ", "{", "1", ",", " ", "-", "2", ",", " ", "0", ",", " ", "0", ",", " ", "2", "}", ",", " ", "TestID", " ", "->", " ", "\"theta4-nome-positions\"", "]", ",", "\n", "  ", "VerificationTest", "[", "\n", "    ", "JAtOrder", "[", "JThetaProductData", "[", "{", "-", "1", ",", " ", "0", ",", " ", "0", ",", " ", "0", "}", ",", " ", "4", ",", " ", "1", "]", ",", " ", "-", "1", "]", ",", "\n", "    ", "{", "1", "/", "2", ",", " ", "0", ",", " ", "3", "/", "2", ",", " ", "0", ",", " ", "9", "/", "2", "}", ",", " ", "TestID", " ", "->", " ", "\"theta1-Laurent-pole\"", "]", ",", "\n", "  ", "VerificationTest", "[", "\n", "    ", "JAtOrder", "[", "JThetaProductData", "[", "{", "1", ",", " ", "0", ",", " ", "0", ",", " ", "0", "}", ",", " ", "4", ",", " ", "5", ",", " ", "3", "]", ",", " ", "1", "]", ",", "\n", "    ", "{", "2", ",", " ", "0", ",", " ", "0", ",", " ", "0", ",", " ", "0", "}", ",", " ", "TestID", " ", "->", " ", "\"theta1-prime-equals-two-eta-cubed\"", "]", ",", "\n", "  ", "VerificationTest", "[", "\n", "    ", "JAtOrder", "[", "JThetaProductData", "[", "{", "1", ",", " ", "0", ",", " ", "0", ",", " ", "0", "}", ",", " ", "4", ",", " ", "5", ",", " ", "3", "]", ",", " ", "3", ",", " ", "True", "]", ",", "\n", "    ", "ConstantArray", "[", "0", ",", " ", "5", "]", ",", " ", "TestID", " ", "->", " ", "\"corrected-cubic-jet-vanishes\"", "]", ",", "\n", "  ", "VerificationTest", "[", "\n", "    ", "JAtOrder", "[", "JThetaProductData", "[", "{", "1", ",", " ", "0", ",", " ", "0", ",", " ", "0", "}", ",", " ", "4", ",", " ", "5", ",", " ", "3", "]", ",", " ", "5", ",", " ", "True", "]", ",", "\n", "    ", "{", "-", "1", "/", "90", ",", " ", "0", ",", " ", "-", "8", "/", "3", ",", " ", "0", ",", " ", "-", "24", "}", ",", " ", "TestID", " ", "->", " ", "\"corrected-quintic-jet-is-minus-E4-over-90\"", "]", ",", "\n", "  ", "VerificationTest", "[", "\n", "    ", "Expand", "[", "JPhiCoefficients", "[", "1", ",", " ", "y", "]", " ", "-", "\n", "      ", "{", "y", " ", "+", " ", "y", "^", "-", "1", " ", "-", " ", "2", ",", " ", "-", "2", " ", "y", "^", "2", " ", "+", " ", "8", " ", "y", " ", "-", " ", "12", " ", "+", " ", "8", "/", "y", " ", "-", " ", "2", "/", "y", "^", "2", "}", "]", ",", "\n", "    ", "{", "0", ",", " ", "0", "}", ",", " ", "TestID", " ", "->", " ", "\"weak-Jacobi-first-two-coefficients\"", "]", ",", "\n", "  ", "VerificationTest", "[", "\n", "    ", "Max", "[", "Table", "[", "Abs", "[", "N", "[", "\n", "      ", "(", "1", "/", "20", ")", "^", "If", "[", "a", " ", "<=", " ", "2", ",", " ",