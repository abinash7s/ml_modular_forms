}, Open]],

Cell[CellGroupData[{
Cell["6. Dataset choices and export", "Section"],

Cell["Edit the parent tuples, eta exponent, additive orders and number of coefficients below. Different additive coefficients from the same parent share a Group identifier. A train/validation/test split should keep each entire group together. The chosen labels can include zero, so percentage errors require an explicit zero-target policy; RMSE is defined without dividing by a target.", "Text"],

Cell["AllPositions retains zeros and their q positions. NonzeroOnly is available for comparisons using the first retained nonzero coefficients. Both retain position metadata. The option excludeTheta34Constant mirrors the repository selection that omits the u⁰ row when θ₁ and θ₂ are absent. These choices are independent of the theta convention and should be recorded with any new results.", "Text"],

Cell[BoxData[RowBox[{"JSelectCoefficients", "[", "row", "_", "Association", ",", " ", "mode", "_", "String", ",", " ", "count", "_", "Integer", "]", " ", ":=", " ", "Module", "[", "\n", "  ", "{", "indices", ",", " ", "selected", "}", ",", "\n", "  ", "If", "[", "count", " ", "<=", " ", "0", " ", "||", " ", "!", "MemberQ", "[", "{", "\"AllPositions\"", ",", " ", "\"NonzeroOnly\"", "}", ",", " ", "mode", "]", ",", "\n", "    ", "Return", "[", "Failure", "[", "\"CoefficientSelection\"", ",", " ", "<|", "\"MessageTemplate\"", " ", "->", "\n", "      ", "\"Choose AllPositions or NonzeroOnly and a positive count.\"", "|>", "]", "]", "]", ";", "\n", "  ", "indices", " ", "=", " ", "If", "[", "mode", " ", "==", " ", "\"AllPositions\"", ",", " ", "Range", "[", "Length", "[", "row", "[", "\"Coefficients\"", "]", "]", "]", ",", "\n", "    ", "Select", "[", "Range", "[", "Length", "[", "row", "[", "\"Coefficients\"", "]", "]", "]", ",", " ", "row", "[", "\"Coefficients\"", "]", "[", "[", "#", "]", "]", " ", "=!=", " ", "0", " ", "&", "]", "]", ";", "\n", "  ", "If", "[", "Length", "[", "indices", "]", " ", "<", " ", "count", ",", "\n", "    ", "Return", "[", "Failure", "[", "\"InsufficientCoefficients\"", ",", " ", "<|", "\"ID\"", " ", "->", " ", "row", "[", "\"ID\"", "]", ",", "\n", "      ", "\"Available\"", " ", "->", " ", "Length", "[", "indices", "]", ",", " ", "\"Requested\"", " ", "->", " ", "count", "|>", "]", "]", "]", ";", "\n", "  ", "indices", " ", "=", " ", "Take", "[", "indices", ",", " ", "count", "]", ";", "\n", "  ", "selected", " ", "=", " ", "Join", "[", "row", ",", " ", "<|", "\"Coefficients\"", " ", "->", " ", "row", "[", "\"Coefficients\"", "]", "[", "[", "indices", "]", "]", ",", "\n", "    ", "\"Positions\"", " ", "->", " ", "row", "[", "\"Positions\"", "]", "[", "[", "indices", "]", "]", ",", "\n", "    ", "\"Metadata\"", " ", "->", " ", "Join", "[", "row", "[", "\"Metadata\"", "]", ",", " ", "<|", "\"CoefficientSelection\"", " ", "->", " ", "mode", "|>", "]", "|>", "]", ";", "\n", "  ", "If", "[", "KeyExistsQ", "[", "row", ",", " ", "\"QPositions\"", "]", ",", "\n", "    ", "selected", " ", "=", " ", "Join", "[", "selected", ",", " ", "<|", "\"QPositions\"", " ", "->", " ", "row", "[", "\"QPositions\"", "]", "[", "[", "indices", "]", "]", "|>", "]", "]", ";", "\n", "  ", "If", "[", "KeyExistsQ", "[", "row", ",", " ", "\"ModularQPositions\"", "]", ",", "\n", "    ", "selected", " ", "=", " ", "Join", "[", "selected", ",", " ", "<|", "\"ModularQPositions\"", " ", "->", " ", "row", "[", "\"ModularQPositions\"", "]", "[", "[", "indices", "]", "]", "|>", "]", "]", ";", "\n", "  ", "selected", "\n", "]", ";", "\n", "JGroupSplit", "[", "rows", "_", "List", ",", " ", "seed", "_", "Integer", " ", ":", " ", "101", "]", " ", ":=", " ", "Module", "[", "\n", "  ", "{", "groups", ",", " ", "shuffled", ",", " ", "ntrain", ",", " ", "nvalidation", ",", " ", "trainGroups", ",", " ", "validationGroups", "}", ",", "\n", "  ", "groups", " ", "=", " ", "DeleteDuplicates", "[", "Lookup", "[", "rows", ",", " ", "\"Group\"", "]", "]", ";", "\n", "  ", "If", "[", "Length", "[", "groups", "]", " ", "<", " ", "3", ",", "\n", "    ", "Return", "[", "Failure", "[", "\"TooFewGroups\"", ",", " ", "<|", "\"MessageTemplate\"", " ", "->", "\n", "      ", "\"At least three parent groups are required.\"", "|>", "]", "]", "]", ";", "\n", "  ", "shuffled", " ", "=", " ", "BlockRandom", "[", "SeedRandom", "[", "seed", "]", ";", " ", "RandomSample", "[", "groups", "]", "]", ";", "\n", "  ", "ntrain", " ", "=", " ", "Min", "[", "Length", "[", "groups", "]", " ", "-", " ", "2", ",", " ", "Max", "[", "1", ",", " ", "Floor", "[", "3", " ", "Length", "[", "groups", "]", "/", "4", "]", "]", "]", ";", "\n", "  ", "nvalidation", " ", "=", " ", "Min", "[", "Length", "[", "groups", "]", " ", "-", " ", "ntrain", " ", "-", " ", "1", ",", "\n", "    ", "Max", "[", "1", ",", " ", "Floor", "[", "3", " ", "Length", "[", "groups", "]", "/", "20", "]", "]", "]", ";", "\n", "  ", "trainGroups", " ", "=", " ", "Take", "[", "shuffled", ",", " ", "ntrain", "]", ";", "\n", "  ", "validationGroups", " ", "=", " ", "Take", "[", "shuffled", ",", " ", "{", "ntrain", " ", "+", " ", "1", ",", " ", "ntrain", " ", "+", " ", "nvalidation", "}", "]", ";", "\n", "  ", "<|", "\"Train\"", " ", "->", " ", "Select", "[", "Range", "[", "Length", "[", "rows", "]", "]", ",", " ", "MemberQ", "[", "trainGroups", ",", " ", "rows", "[", "[", "#", "]", "]", "[", "\"Group\"", "]", "]", " ", "&", "]", ",", "\n", "    ", "\"Validation\"", " ", "->", " ", "Select", "[", "Range", "[", "Length", "[", "rows", "]", "]", ",", "\n", "      ", "MemberQ", "[", "validationGroups", ",", " ", "rows", "[", "[", "#", "]", "]", "[", "\"Group\"", "]", "]", " ", "&", "]", ",", "\n", "    ", "\"Test\"", " ", "->", " ", "Select", "[", "Range", "[", "Length", "[", "rows", "]", "]", ",", "\n", "      ", "!", "MemberQ", "[", "Join", "[", "trainGroups", ",", " ", "validationGroups", "]", ",", " ", "rows", "[", "[", "#", "]", "]", "[", "\"Group\"", "]", "]", " ", "&", "]", ",", "\n", "    ", "\"Seed\"", " ", "->", " ", "seed", ",", " ", "\"SplitUnit\"", " ", "->", " ", "\"Group\"", "|>", "\n", "]", ";"}]], "Input" , CellTags -> "input-46", InitializationCell -> True],

Cell[BoxData[RowBox[{"datasetOptions", " ", "=", " ", "<|", "\n", "  ", "\"ParentPowers\"", " ", "->", " ", "Flatten", "[", "Table", "[", "ReplacePart", "[", "{", "0", ",", " ", "0", ",", " ", "0", ",", " ", "0", "}", ",", " ", "a", " ", "->", " ", "p", "]", ",", "\n", "    ", "{", "a", ",", " ", "1", ",", " ", "4", "}", ",", " ", "{", "p", ",", " ", "{", "-", "3", ",", " ", "-", "2", ",", " ", "-", "1", ",", " ", "1", ",", " ", "2", ",", " ", "3", "}", "}", "]", ",", " ", "1", "]", ",", "\n", "  ", "\"EtaExponent\"", " ", "->", " ", "0", ",", "\n", "  ", "\"MaximumAdditiveOrder\"", " ", "->", " ", "6", ",", "\n", "  ", "\"ExpansionCoefficientCount\"", " ", "->", " ", "12", ",", "\n", "  ", "\"InputCoefficientCount\"", " ", "->", " ", "8", ",", "\n", "  ", "\"CoefficientSelection\"", " ", "->", " ", "\"AllPositions\"", ",", "\n", "  ", "\"CorrectedJets\"", " ", "->", " ", "False", ",", "\n", "  ", "\"ExcludeTheta34Constant\"", " ", "->", " ", "True", ",", "\n", "  ", "\"SplitSeed\"", " ", "->", " ", "101", "|>", ";", "\n", "runJacobiDatasetGeneration", " ", "=", " ", "False", ";", "\n", "exportJacobiDatasets", " ", "=", " ", "False", ";"}]], "Input" , CellTags -> "input-47"],

Cell["Set runJacobiDatasetGeneration=True to make the selected additive dataset. Export is a separate switch. The WXF file stores exact numbers and associations; the long CSV records one coefficient per row with both nome conventions. The export directory is identified by the actual settings, generator definitions and row contents. Changed options must be regenerated before export.", "Text"],

Cell[BoxData[RowBox[{"If", "[", "TrueQ", "[", "runJacobiDatasetGeneration", "]", ",", "\n", "  ", "jacobiDatasetReady", " ", "=", " ", "False", ";", "\n", "  ", "jacobiSettingsUsed", " ", "=", " ", "datasetOptions", ";", "\n", "  ", "jacobiDefinitionsUsed", " ", "=", " ", "{", "DownValues", "[", "JThetaUnit", "]", ",", " ", "DownValues", "[", "JThetaProductData", "]", ",", "\n", "    ", "DownValues", "[", "JE2Nome", "]", ",", " ", "DownValues", "[", "JThetaRows", "]", ",", " ", "DownValues", "[", "JSelectCoefficients", "]", ",", "\n", "    ", "DownValues", "[", "JGroupSplit", "]", "}", ";", "\n", "  ", "jacobiParentData", " ", "=", " ", "Table", "[", "\n", "    ", "JThetaProductData", "[", "p", ",", "\n", "      ", "Ceiling", "[", "(", "p", "[", "[", "1", "]", "]", " ", "+", " ", "p", "[", "[", "2", "]", "]", ")", "/", "4", " ", "-", " ", "jacobiSettingsUsed", "[", "\"EtaExponent\"", "]", "/", "12", "]", " ", "+", "\n", "        ", "jacobiSettingsUsed", "[", "\"ExpansionCoefficientCount\"", "]", " ", "-", " ", "1", ",", "\n", "      ", "jacobiSettingsUsed", "[", "\"MaximumAdditiveOrder\"", "]", ",", " ", "jacobiSettingsUsed", "[", "\"EtaExponent\"", "]", "]", ",", "\n", "    ", "{", "p", ",", " ", "jacobiSettingsUsed", "[", "\"ParentPowers\"", "]", "}", "]", ";", "\n", "  ", "If", "[", "AnyTrue", "[", "jacobiParentData", ",", " ", "FailureQ", "]", ",", "\n", "    ", "Print", "[", "Select", "[", "jacobiParentData", ",", " ", "FailureQ", "]", "]", ";", " ", "Abort", "[", "]", "]", ";", "\n", "  ", "additiveRows", " ", "=", " ", "Flatten", "[", "JThetaRows", "[", "#", ",", " ", "jacobiSettingsUsed", "[", "\"CorrectedJets\"", "]", "]", " ", "&", " ", "/@", "\n", "    ", "jacobiParentData", ",", " ", "1", "]", ";", "\n", "  ", "If", "[", "TrueQ", "[", "jacobiSettingsUsed", "[", "\"ExcludeTheta34Constant\"", "]", "]", ",", "\n", "    ", "additiveRows", " ", "=", " ", "Select", "[", "additiveRows", ",", "\n", "      ", "!", "(", "Take", "[", "#", "[", "\"Metadata\"", "]", "[", "\"ThetaPowers\"", "]", ",", " ", "2", "]", " ", "==", " ", "{", "0", ",", " ", "0", "}", " ", "&&", "\n", "        ", "#", "[", "\"TaylorOrder\"", "]", " ", "==", " ", "0", ")", " ", "&", "]", "]", ";", "\n", "  ", "additiveRows", " ", "=", " ", "JSelectCoefficients", "[", "#", ",", " ", "jacobiSettingsUsed", "[", "\"CoefficientSelection\"", "]", ",", "\n", "    ", "jacobiSettingsUsed", "[", "\"InputCoefficientCount\"", "]", "]", " ", "&", " ", "/@", " ", "additiveRows", ";", "\n", "  ", "If", "[", "AnyTrue", "[", "additiveRows", ",", " ", "FailureQ", "]", ",", "\n", "    ", "Print", "[", "Select", "[", "additiveRows", ",", " ", "FailureQ", "]", "]", ";", " ", "Abort", "[", "]", "]", ";", "\n", "  ", "additiveSplit", " ", "=", " ", "JGroupSplit", "[", "additiveRows", ",", " ", "jacobiSettingsUsed", "[", "\"SplitSeed\"", "]", "]", ";", "\n", "  ", "If", "[", "FailureQ", "[", "additiveSplit", "]", ",", " ", "Print", "[", "additiveSplit", "]", ";", " ", "Abort", "[", "]", "]", ";", "\n", "  ", "jacobiDatasetReady", " ", "=", " ", "True", ";", "\n", "  ", "Print", "[", "<|", "\"Rows\"", " ", "->", " ", "Length", "[", "additiveRows", "]", ",", "\n", "    ", "\"ParentGroups\"", " ", "->", " ", "Length", "[", "DeleteDuplicates", "[", "Lookup", "[", "additiveRows", ",", " ", "\"Group\"", "]", "]", "]", ",", "\n", "    ", "\"SplitRows\"", " ", "->", " ", "Map", "[", "Length", ",", " ", "KeyTake", "[", "additiveSplit", ",", "\n", "      ", "{", "\"Train\"", ",", " ", "\"Validation\"", ",", " ", "\"Test\"", "}", "]", "]", "|>", "]", ";", "\n", "  ", "Dataset", "[", "Take", "[", "additiveRows", ",", " ", "UpTo", "[", "6", "]", "]", "]", ",", "\n", "  ", "\"Set runJacobiDatasetGeneration=True to generate the selected rows.\"", "\n", "]"}]], "Input" , CellTags -> "input-49"],

Cell[BoxData[RowBox[{"If", "[", "TrueQ", "[", "exportJacobiDatasets", "]", ",", "\n", "  ", "If", "[", "!", "TrueQ", "[", "jacobiDatasetReady", "]", " ", "||", " ", "!", "ListQ", "[", "additiveRows", "]", " ", "||", "\n", "      ", "jacobiSettingsUsed", " ", "=!=", " ", "datasetOptions", ",", "\n", "    ", "Print", "[", "\"Generate the dataset with the current options before exporting.\"", "]", ";", " ", "Abort", "[", "]", "]", ";", "\n", "  ", "jacobiRunDirectory", " ", "=", " ", "FileNameJoin", "[", "{", "jacobiOutputDirectory", ",", "\n", "    ", "\"theta_\"", " ", "<>", " ", "StringTake", "[", "IntegerString", "[", "Hash", "[", "{", "jacobiSettingsUsed", ",", " ", "jacobiDefinitionsUsed", ",", " ", "additiveRows", "}", ",", " ", "\"SHA256\"", "]", ",", " ", "16", ",", " ", "64", "]", ",", " ", "12", "]", "}", "]", ";", "\n", "  ", "If", "[", "!", "DirectoryQ", "[", "jacobiRunDirectory", "]", ",", "\n", "    ", "CreateDirectory", "[", "jacobiRunDirectory", ",", " ", "CreateIntermediateDirectories", " ", "->", " ", "True", "]", "]", ";", "\n", "  ", "Export", "[", "FileNameJoin", "[", "{", "jacobiRunDirectory", ",", " ", "\"additive_rows.wxf\"", "}", "]", ",", " ", "additiveRows", ",", " ", "\"WXF\"", "]", ";", "\n", "  ", "Export", "[", "FileNameJoin", "[", "{", "jacobiRunDirectory", ",", " ", "\"split.wxf\"", "}", "]", ",", " ", "additiveSplit", ",", " ", "\"WXF\"", "]", ";", "\n", "  ", "Put", "[", "jacobiSettingsUsed", ",", " ", "FileNameJoin", "[", "{", "jacobiRunDirectory", ",", " ", "\"settings.wl\"", "}", "]", "]", ";", "\n", "  ", "Put", "[", "jacobiDefinitionsUsed", ",", " ", "FileNameJoin", "[", "{", "jacobiRunDirectory", ",", " ", "\"generator_definitions.wl\"", "}", "]", "]", ";", "\n", "  ", "coefficientCSV", " ", "=", " ", "Prepend", "[", "Flatten", "[", "Table", "[", "\n", "    ", "Table", "[", "{", "row", "[", "\"ID\"", "]", ",", " ", "row", "[", "\"Group\"", "]", ",", " ", "row", "[", "\"TaylorOrder\"", "]", ",", " ", "row", "[", "\"Target\"", "]", ",", "\n", "      ", "row", "[", "\"Positions\"", "]", "[", "[", "h", "]", "]", ",", " ", "row", "[", "\"QPositions\"", "]", "[", "[", "h", "]", "]", ",", " ", "row", "[", "\"ModularQPositions\"", "]", "[", "[", "h", "]", "]", ",", "\n", "      ", "ToString", "[", "row", "[", "\"Coefficients\"", "]", "[", "[", "h", "]", "]", ",", " ", "InputForm", "]", "}", ",", "\n", "      ", "{", "h", ",", " ", "Length", "[", "row", "[", "\"Coefficients\"", "]", "]", "}", "]", ",", " ", "{", "row", ",", " ", "additiveRows", "}", "]", ",", " ", "1", "]", ",", "\n", "    ", "{", "\"ID\"", ",", " ", "\"Group\"", ",", " ", "\"AdditiveOrder\"", ",", " ", "\"TargetWeight\"", ",", " ", "\"RelativeQDegree\"", ",", " ", "\"QExponent\"", ",", " ", "\"qExponent\"", ",", " ", "\"ExactCoefficient\"", "}", "]", ";", "\n", "  ", "Export", "[", "FileNameJoin", "[", "{", "jacobiRunDirectory", ",", " ", "\"coefficients.csv\"", "}", "]", ",", " ", "coefficientCSV", ",", " ", "\"CSV\"", "]", ";", "\n", "  ", "splitCSV", " ", "=", " ", "Prepend", "[", "Flatten", "[", "Table", "[", "\n", "    ", "{", "additiveRows", "[", "[", "h", "]", "]", "[", "\"ID\"", "]", ",", " ", "additiveRows", "[", "[", "h", "]", "]", "[", "\"Group\"", "]", ",", " ", "part", "}", ",", "\n", "    ", "{", "part", ",", " ", "{", "\"Train\"", ",", " ", "\"Validation\"", ",", " ", "\"Test\"", "}", "}", ",", " ", "{", "h", ",", " ", "additiveSplit", "[", "part", "]", "}", "]", ",", " ", "1", "]", ",", "\n", "    ", "{", "\"ID\"", ",", " ", "\"Group\"", ",", " ", "\"Split\"", "}", "]", ";", "\n", "  ", "Export", "[", "FileNameJoin", "[", "{", "jacobiRunDirectory", ",", " ", "\"split.csv\"", "}", "]", ",", " ", "splitCSV", ",", " ", "\"CSV\"", "]", ";", "\n", "  ", "jacobiRunDirectory", ",", "\n", "  ", "\"Set exportJacobiDatasets=True after generating the dataset to save it.\"", "\n", "]"}]], "Input" , CellTags -> "input-50"],

Cell["Optional multiplicative dataset", "Subsection"],

Cell["This independent example uses twenty parent forms and makes both uncorrected fixed-y modes and theta-decomposition components. Their target definitions differ, so keep the two families separate when training. The common parent identifiers also allow all versions of one parent to be placed in the same split. The exports fixed_mode_rows.wxf and theta_component_rows.wxf are separate inputs for notebook 02; their common Positions arrays are relative q degrees, while their absolute q exponents are retained separately.", "Text"],

Cell[BoxData[RowBox[{"multiplicativeOptions", " ", "=", " ", "<|", "\"E4Powers\"", " ", "->", " ", "Range", "[", "0", ",", " ", "4", "]", ",", " ", "\"E6Powers\"", " ", "->", " ", "Range", "[", "0", ",", " ", "3", "]", ",", "\n", "  ", "\"QOrder\"", " ", "->", " ", "12", ",", " ", "\"FixedModes\"", " ", "->", " ", "{", "0", ",", " ", "1", ",", " ", "2", "}", ",", " ", "\"ThetaComponents\"", " ", "->", " ", "{", "0", ",", " ", "1", "}", ",", "\n", "  ", "\"SplitSeed\"", " ", "->", " ", "101", "|>", ";", "\n", "runMultiplicativeDatasetGeneration", " ", "=", " ", "False", ";", "\n", "If", "[", "TrueQ", "[", "runMultiplicativeDatasetGeneration", "]", ",", "\n", "  ", "multiplicativeSettingsUsed", " ", "=", " ", "multiplicativeOptions", ";", "\n", "  ", "multiplicativeParents", " ", "=", " ", "Flatten", "[", "Table", "[", "JWeakJacobiParent", "[", "a", ",", " ", "b", ",", "\n", "    ", "multiplicativeSettingsUsed", "[", "\"QOrder\"", "]", "]", ",", "\n", "    ", "{", "a", ",", " ", "multiplicativeSettingsUsed", "[", "\"E4Powers\"", "]", "}", ",", "\n", "    ", "{", "b", ",", " ", "multiplicativeSettingsUsed", "[", "\"E6Powers\"", "]", "}", "]", ",", " ", "1", "]", ";", "\n", "  ", "If", "[", "AnyTrue", "[", "multiplicativeParents", ",", " ", "FailureQ", "]", ",", "\n", "    ", "Print", "[", "Select", "[", "multiplicativeParents", ",", " ", "FailureQ", "]", "]", ";", " ", "Abort", "[", "]", "]", ";", "\n", "  ", "fixedModeRows", " ", "=", " ", "Flatten", "[", "Table", "[", "JFourierRow", "[", "parent", ",", " ", "r", "]", ",", "\n", "    ", "{", "parent", ",", " ", "multiplicativeParents", "}", ",", " ", "{", "r", ",", " ", "multiplicativeSettingsUsed", "[", "\"FixedModes\"", "]", "}", "]", ",", " ", "1", "]", ";", "\n", "  ", "thetaComponentRows", " ", "=", " ", "Flatten", "[", "Table", "[", "JFourierRow", "[", "parent", ",", " ", "mu", ",", " ", "True", "]", ",", "\n", "    ", "{", "parent", ",", " ", "multiplicativeParents", "}", ",", " ", "{", "mu", ",", " ", "multiplicativeSettingsUsed", "[", "\"ThetaComponents\"", "]", "}", "]", ",", " ", "1", "]", ";", "\n", "  ", "If", "[", "AnyTrue", "[", "Join", "[", "fixedModeRows", ",", " ", "thetaComponentRows", "]", ",", " ", "FailureQ", "]", ",", "\n", "    ", "Print", "[", "\"Check the multiplicative mode choices.\"", "]", ";", " ", "Abort", "[", "]", "]", ";", "\n", "  ", "fixedModeSplit", " ", "=", " ", "JGroupSplit", "[", "fixedModeRows", ",", " ", "multiplicativeSettingsUsed", "[", "\"SplitSeed\"", "]", "]", ";", "\n", "  ", "thetaComponentSplit", " ", "=", " ", "JGroupSplit", "[", "thetaComponentRows", ",", " ", "multiplicativeSettingsUsed", "[", "\"SplitSeed\"", "]", "]", ";", "\n", "  ", "If", "[", "AnyTrue", "[", "{", "fixedModeSplit", ",", " ", "thetaComponentSplit", "}", ",", " ", "FailureQ", "]", ",", "\n", "    ", "Print", "[", "\"Choose at least three parent forms for a group split.\"", "]", ";", " ", "Abort", "[", "]", "]", ";", "\n", "  ", "If", "[", "TrueQ", "[", "exportJacobiDatasets", "]", ",", "\n", "    ", "multiplicativeDefinitionsUsed", " ", "=", " ", "{", "DownValues", "[", "JPhiCoefficients", "]", ",", "\n", "      ", "DownValues", "[", "JLaurentCoefficient", "]", ",", " ", "DownValues", "[", "JWeakJacobiParent", "]", ",", "\n", "      ", "DownValues", "[", "JFourierRow", "]", ",", " ", "DownValues", "[", "JGroupSplit", "]", "}", ";", "\n", "    ", "multiplicativeDirectory", " ", "=", " ", "FileNameJoin", "[", "{", "jacobiOutputDirectory", ",", "\n", "      ", "\"phi_index1_\"", " ", "<>", " ", "StringTake", "[", "IntegerString", "[", "Hash", "[", "\n", "        ", "{", "multiplicativeSettingsUsed", ",", " ", "multiplicativeDefinitionsUsed", ",", "\n", "          ", "fixedModeRows", ",", " ", "thetaComponentRows", "}", ",", " ", "\"SHA256\"", "]", ",", " ", "16", ",", " ", "64", "]", ",", " ", "12", "]", "}", "]", ";", "\n", "    ", "If", "[", "!", "DirectoryQ", "[", "multiplicativeDirectory", "]", ",", "\n", "      ", "CreateDirectory", "[", "multiplicativeDirectory", ",", " ", "CreateIntermediateDirectories", " ", "->", " ", "True", "]", "]", ";", "\n", "    ", "Export", "[", "FileNameJoin", "[", "{", "multiplicativeDirectory", ",", " ", "\"fixed_mode_rows.wxf\"", "}", "]", ",", " ", "fixedModeRows", ",", " ", "\"WXF\"", "]", ";", "\n", "    ", "Export", "[", "FileNameJoin", "[", "{", "multiplicativeDirectory", ",", " ", "\"fixed_mode_split.wxf\"", "}", "]", ",", " ", "fixedModeSplit", ",", " ", "\"WXF\"", "]", ";", "\n", "    ", "Export", "[", "FileNameJoin", "[", "{", "multiplicativeDirectory", ",", " ", "\"theta_component_rows.wxf\"", "}", "]", ",", " ", "thetaComponentRows", ",", " ", "\"WXF\"", "]", ";", "\n", "    ", "Export", "[", "FileNameJoin", "[", "{", "multiplicativeDirectory", ",", " ", "\"theta_component_split.wxf\"", "}", "]", ",", " ", "thetaComponentSplit", ",", " ", "\"WXF\"", "]", ";", "\n", "    ", "Put", "[", "multiplicativeSettingsUsed", ",", " ", "FileNameJoin", "[", "{", "multiplicativeDirectory", ",", " ", "\"settings.wl\"", "}", "]", "]", ";", "\n", "    ", "Put", "[", "multiplicativeDefinitionsUsed", ",", " ", "FileNameJoin", "[", "{", "multiplicativeDirectory", ",", " ", "\"generator_definitions.wl\"", "}", "]", "]", "]", ";", "\n", "  ", "<|", "\"FixedModeRows\"", " ", "->", " ", "Length", "[", "fixedModeRows", "]", ",", "\n", "    ", "\"ThetaComponentRows\"", " ", "->", " ", "Length", "[", "thetaComponentRows", "]", "|>", ",", "\n", "  ", "\"Set runMultiplicativeDatasetGeneration=True to generate the fixed-index example.\"", "\n", "]"}]], "Input" , CellTags -> "input-53"]
}, Open]],

Cell[CellGroupData[{
Cell["7. Reading the data and choosing experiments", "Section"],

Cell["For an additive study, choose either RawAdditiveJet or CorrectedAdditiveJet, one consistent coefficient selection, and a parent-group split. For the default AllPositions dataset, notebook 02 can load additive_rows.wxf as custom rows. The common Positions array describes the relative Q grid; absolute shifts remain in the additional position arrays and metadata. Those shifts are not automatically supplied to the network. NonzeroOnly can produce different selected positions in different rows and requires a separately specified input representation before using the common-grid training workflow. Signed logarithms retain signs, whereas log-absolute-value inputs identify opposite signs. Keep any fitted standardization restricted to the training subset. Training and architecture choices can then be explored in notebook 02 using the explicit rows and split.", "Text"],

Cell["For a fixed-y study, Target is the parent Jacobi weight. For a theta-component study, Target is the vector-valued weight K−1/2. These target meanings should remain distinct in plots and tables. Meromorphic multiplicative expansions and noninteger theta powers require additional analytic choices and are outside the generator used here.", "Text"],

Cell["This notebook makes reproducible examples and new datasets. The large archived theta tables additionally depend on their selected parent ranges, truncations, removal of zero entries and training settings. Matching those numerical tables requires selecting the corresponding settings, rather than treating the small demonstration as a historical replay.", "Text"]
}, Open]],

Cell[CellGroupData[{
Cell["References and conventions", "Section"],

Cell["Repository: https://github.com/abinash7s/ml_modular_forms\nWolfram EllipticTheta definitions: https://reference.wolfram.com/language/ref/EllipticTheta.html\nNIST DLMF theta definitions and modular transformations: https://dlmf.nist.gov/20.2 and https://dlmf.nist.gov/20.7\nTaylor coefficients of Jacobi forms: https://arxiv.org/abs/1707.02703\nTheta decomposition and meromorphic Jacobi forms: https://arxiv.org/abs/1208.4074", "Text"]
}, Open]]
},
 WindowSize -> {1100, 850}, WindowMargins -> {{Automatic, Automatic}, {Automatic, Automatic}},
 WindowTitle -> "Jacobi theta functions and coefficient datasets",
 CellContext -> Notebook, ShowCellBracket -> True, Magnification -> 1.,
 TaggingRules -> <|"Bundle" -> "ModularFormsNotebooks", "NotebookNumber" -> 4|>,
 StyleDefinitions -> Notebook[{
 Cell[StyleData[StyleDefinitions -> "Default.nb"]],
 Cell[StyleData["Title"], FontFamily -> "Helvetica", FontSize -> 28,
  FontWeight -> "Plain", FontColor -> RGBColor[0.16, 0.23, 0.31], CellMargins -> {{36, 24}, {12, 28}}],
 Cell[StyleData["Subtitle"], FontFamily -> "Helvetica", FontSize -> 14,
  FontColor -> GrayLevel[0.4], CellMargins -> {{36, 24}, {18, 0}}],
 Cell[StyleData["Section"], FontFamily -> "Helvetica", FontSize -> 21,
  FontColor -> RGBColor[0.16, 0.23, 0.31], CellMargins -> {{36, 24}, {10, 24}}],
 Cell[StyleData["Subsection"], FontFamily -> "Helvetica", FontSize -> 16,
  FontColor -> GrayLevel[0.22], CellMargins -> {{36, 24}, {8, 18}}],
 Cell[StyleData["Text"], FontFamily -> "Helvetica", FontSize -> 13,
  LineSpacing -> {1.15, 2}, CellMargins -> {{36, 30}, {9, 7}}],
 Cell[StyleData["Input"], FontSize -> 12, CellMargins -> {{54, 24}, {9, 9}}],
 Cell[StyleData["Output"], FontSize -> 12, CellMargins -> {{54, 24}, {9, 5}}]
 }, Visible -> False]]
