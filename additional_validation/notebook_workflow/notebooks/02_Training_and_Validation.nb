(* Content-type: application/vnd.wolfram.mathematica *)
(* Plain Mathematica notebook; input cells contain editable Wolfram Language. *)
Notebook[{
Cell["Training and additional validation", "Title"],

Cell["Editable networks, paired training runs and the CHL experiments", "Subtitle"],

Cell["This notebook starts with one editable experiment and then assembles the full study. Read or evaluate the definition cells first. Training is controlled by the run flags below; opening the notebook or evaluating its setup does not train a network. Large outputs are written to the generated directory.", "Text"],

Cell[CellGroupData[{
Cell["1. Setup and run controls", "Section"],

Cell[BoxData[RowBox[{"$HistoryLength", " ", "=", " ", "5", ";", "\n", "baseDir", " ", "=", " ", "ParentDirectory", "[", "NotebookDirectory", "[", "]", "]", ";", "\n", "supportDir", " ", "=", " ", "FileNameJoin", "[", "{", "baseDir", ",", " ", "\"support\"", "}", "]", ";", "\n", "outputRoot", " ", "=", " ", "FileNameJoin", "[", "{", "baseDir", ",", " ", "\"generated\"", "}", "]", ";", "\n", "Get", "[", "FileNameJoin", "[", "{", "supportDir", ",", " ", "\"src\"", ",", " ", "\"Data.wl\"", "}", "]", "]", ";", "\n", "Get", "[", "FileNameJoin", "[", "{", "supportDir", ",", " ", "\"src\"", ",", " ", "\"Training.wl\"", "}", "]", "]", ";", "\n", "Get", "[", "FileNameJoin", "[", "{", "supportDir", ",", " ", "\"src\"", ",", " ", "\"Study.wl\"", "}", "]", "]", ";", "\n", "ClearAll", "[", "must", "]", ";", "\n", "must", "[", "value", "_", "]", " ", ":=", " ", "If", "[", "FailureQ", "[", "value", "]", " ", "||", " ", "value", " ", "===", " ", "$Failed", ",", "\n", "  ", "Print", "[", "value", "]", ";", " ", "Abort", "[", "]", ",", " ", "value", "]", ";"}]], "Input" , CellTags -> "input-4", InitializationCell -> True],

Cell[BoxData[RowBox[{"runExample", " ", "=", " ", "False", ";", "\n", "runCustomNetwork", " ", "=", " ", "False", ";", "\n", "runStudy", " ", "=", " ", "False", ";", "\n", "quickExample", " ", "=", " ", "False", ";"}]], "Input" , CellTags -> "input-5"],

Cell["For a short compatibility example, set quickExample = True and runExample = True, then evaluate Sections 2–5 in order. Bundled datasets are reduced to at most 64 selected power groups and the budget is 5 epochs. Imported custom rows are retained in full. For a scientific fit, leave quickExample = False; the default budget is 10,000 epochs. The full study has a separate runStudy switch.", "Text"],

Cell[BoxData[RowBox[{"defaultSettings", " ", "=", " ", "Import", "[", "FileNameJoin", "[", "{", "supportDir", ",", " ", "\"config\"", ",", " ", "\"defaults.json\"", "}", "]", ",", " ", "\"RawJSON\"", "]", ";", "\n", "datasetDefinitions", " ", "=", " ", "Import", "[", "FileNameJoin", "[", "{", "supportDir", ",", " ", "\"config\"", ",", " ", "\"datasets.json\"", "}", "]", ",", " ", "\"RawJSON\"", "]", ";", "\n", "experimentDefinitions", " ", "=", " ", "Import", "[", "FileNameJoin", "[", "{", "supportDir", ",", " ", "\"config\"", ",", " ", "\"experiments.json\"", "}", "]", ",", " ", "\"RawJSON\"", "]", ";", "\n", "If", "[", "!", "AssociationQ", "[", "defaultSettings", "]", " ", "||", " ", "!", "AssociationQ", "[", "datasetDefinitions", "]", " ", "||", "\n", "   ", "!", "ListQ", "[", "experimentDefinitions", "]", ",", " ", "Print", "[", "\"Cannot read the bundled configuration.\"", "]", ";", " ", "Abort", "[", "]", "]", ";"}]], "Input" , CellTags -> "input-7", InitializationCell -> True]
}, Open]],

Cell[CellGroupData[{
Cell["2. Choose the data and the target", "Section"],

Cell["The first example uses eta_negative: eta(tau)^p with p = -1, ..., -400 and target weight p/2. Its 30 inputs are the coefficients of q^0 through q^29 after removing q^(p/24). To use the representative CHL example, change datasetID to chl_N3_positive_integer and select the CHL choices in Section 3. Powers shared by several rows remain in the same split.", "Text"],

Cell[BoxData[RowBox[{"useCustomData", " ", "=", " ", "False", ";", "\n", "customRowsFile", " ", "=", " ", "FileNameJoin", "[", "{", "outputRoot", ",", " ", "\"data\"", ",", " ", "\"custom_rows.wxf\"", "}", "]", ";", "\n", "datasetID", " ", "=", " ", "\"eta_negative\"", ";", "\n", "If", "[", "TrueQ", "[", "useCustomData", "]", ",", "\n", "  ", "If", "[", "!", "FileExistsQ", "[", "customRowsFile", "]", ",", "\n", "    ", "Print", "[", "\"The custom row file does not exist: \"", ",", " ", "customRowsFile", "]", ";", " ", "Abort", "[", "]", "]", ";", "\n", "  ", "rows", " ", "=", " ", "must", "[", "Quiet", "[", "Check", "[", "Import", "[", "customRowsFile", ",", " ", "\"WXF\"", "]", ",", " ", "$Failed", "]", "]", "]", ";", "\n", "  ", "ClearAll", "[", "finiteReal", ",", " ", "validRow", "]", ";", "\n", "  ", "finiteReal", "[", "x", "_", "]", " ", ":=", " ", "NumberQ", "[", "x", "]", " ", "&&", "\n", "    ", "FreeQ", "[", "x", ",", " ", "Indeterminate", " ", "|", " ", "ComplexInfinity", " ", "|", " ", "DirectedInfinity", "[", "_", "]", "]", " ", "&&", " ", "TrueQ", "[", "Im", "[", "x", "]", " ", "==", " ", "0", "]", ";", "\n", "  ", "validRow", "[", "row", "_", "]", " ", ":=", " ", "AssociationQ", "[", "row", "]", " ", "&&", "\n", "    ", "AllTrue", "[", "{", "\"ID\"", ",", " ", "\"Group\"", ",", " ", "\"Target\"", ",", " ", "\"Coefficients\"", ",", " ", "\"Positions\"", "}", ",", " ", "KeyExistsQ", "[", "row", ",", " ", "#", "]", " ", "&", "]", " ", "&&", "\n", "    ", "StringQ", "[", "row", "[", "\"ID\"", "]", "]", " ", "&&", " ", "StringQ", "[", "row", "[", "\"Group\"", "]", "]", " ", "&&", " ", "finiteReal", "[", "row", "[", "\"Target\"", "]", "]", " ", "&&", "\n", "    ", "ListQ", "[", "row", "[", "\"Coefficients\"", "]", "]", " ", "&&", " ", "row", "[", "\"Coefficients\"", "]", " ", "=!=", " ", "{", "}", " ", "&&", "\n", "    ", "VectorQ", "[", "row", "[", "\"Coefficients\"", "]", ",", " ", "finiteReal", "]", " ", "&&", "\n", "    ", "VectorQ", "[", "row", "[", "\"Positions\"", "]", ",", " ", "IntegerQ", "[", "#", "]", " ", "&&", " ", "#", " ", ">=", " ", "0", " ", "&", "]", " ", "&&", "\n", "    ", "DuplicateFreeQ", "[", "row", "[", "\"Positions\"", "]", "]", " ", "&&", "\n", "    ", "Length", "[", "row", "[", "\"Positions\"", "]", "]", " ", "==", " ", "Length", "[", "row", "[", "\"Coefficients\"", "]", "]", ";", "\n", "  ", "If", "[", "!", "ListQ", "[", "rows", "]", " ", "||", " ", "rows", " ", "===", " ", "{", "}", " ", "||", " ", "!", "AllTrue", "[", "rows", ",", " ", "validRow", "]", ",", "\n", "    ", "Print", "[", "\"Custom rows require ID, Group, a finite real Target, finite real Coefficients, and matching integer Positions.\"", "]", ";", "\n", "    ", "Abort", "[", "]", "]", ";", "\n", "  ", "If", "[", "!", "DuplicateFreeQ", "[", "Lookup", "[", "rows", ",", " ", "\"ID\"", "]", "]", " ", "||", "\n", "     ", "Length", "[", "DeleteDuplicates", "[", "Lookup", "[", "rows", ",", " ", "\"Positions\"", "]", "]", "]", " ", "!=", " ", "1", ",", "\n", "    ", "Print", "[", "\"Custom row IDs must be unique and all rows must use the same coefficient positions.\"", "]", ";", "\n", "    ", "Abort", "[", "]", "]", ";", "\n", "  ", "datasetID", " ", "=", " ", "\"custom_\"", " ", "<>", " ", "FileBaseName", "[", "customRowsFile", "]", ";", "\n", "  ", "exampleDataset", " ", "=", " ", "<|", "\"ID\"", " ", "->", " ", "datasetID", ",", " ", "\"Rows\"", " ", "->", " ", "rows", ",", "\n", "    ", "\"DatasetHash\"", " ", "->", " ", "IntegerString", "[", "Hash", "[", "rows", ",", " ", "\"SHA256\"", "]", ",", " ", "16", ",", " ", "64", "]", ",", "\n", "    ", "\"SourceFile\"", " ", "->", " ", "customRowsFile", "|>", ",", "\n", "  ", "datasetSpec", " ", "=", " ", "must", "[", "ValidationData`ResolveDatasetSpec", "[", "\n", "    ", "datasetDefinitions", "[", "datasetID", "]", ",", " ", "supportDir", "]", "]", ";", "\n", "  ", "If", "[", "quickExample", ",", "\n", "    ", "examplePowers", " ", "=", " ", "datasetSpec", "[", "\"Powers\"", "]", ";", "\n", "    ", "sampleIndices", " ", "=", " ", "DeleteDuplicates", "[", "Round", "[", "Subdivide", "[", "1", ",", " ", "Length", "[", "examplePowers", "]", ",", "\n", "      ", "Min", "[", "63", ",", " ", "Length", "[", "examplePowers", "]", " ", "-", " ", "1", "]", "]", "]", "]", ";", "\n", "    ", "datasetSpec", " ", "=", " ", "Join", "[", "datasetSpec", ",", " ", "<|", "\"Powers\"", " ", "->", " ", "examplePowers", "[", "[", "sampleIndices", "]", "]", "|>", "]", "\n", "  ", "]", ";", "\n", "  ", "datasetSpec", " ", "=", " ", "Join", "[", "datasetSpec", ",", " ", "<|", "\"CoefficientCount\"", " ", "->", " ", "30", "|>", "]", ";", "\n", "  ", "exampleDataset", " ", "=", " ", "must", "[", "ValidationData`GetDataset", "[", "datasetID", ",", " ", "datasetSpec", ",", "\n", "    ", "supportDir", ",", " ", "FileNameJoin", "[", "{", "outputRoot", ",", " ", "\"data\"", "}", "]", "]", "]", ";", "\n", "  ", "rows", " ", "=", " ", "exampleDataset", "[", "\"Rows\"", "]", "\n", "]", ";", "\n", "splitSeed", " ", "=", " ", "20260926", ";", "\n", "split", " ", "=", " ", "must", "[", "UnifiedStudy`MakeSplit", "[", "rows", ",", " ", "splitSeed", "]", "]", ";", "\n", "Dataset", "[", "<|", "\"Dataset\"", " ", "->", " ", "datasetID", ",", " ", "\"Rows\"", " ", "->", " ", "Length", "[", "rows", "]", ",", "\n", "  ", "\"Coefficients per row\"", " ", "->", " ", "Length", "[", "rows", "[", "[", "1", "]", "]", "[", "\"Coefficients\"", "]", "]", ",", "\n", "  ", "\"Training rows\"", " ", "->", " ", "Length", "[", "split", "[", "\"Train\"", "]", "]", ",", "\n", "  ", "\"Validation rows\"", " ", "->", " ", "Length", "[", "split", "[", "\"Validation\"", "]", "]", ",", "\n", "  ", "\"Test rows\"", " ", "->", " ", "Length", "[", "split", "[", "\"Test\"", "]", "]", "|>", "]"}]], "Input" , CellTags -> "input-10"],

Cell["The split uses 75% of distinct groups for training, approximately 15% for validation and the remainder for testing. At least 20 groups are required. It is fixed across models and initialization seeds. To load the custom family exported by Notebook 1, set useCustomData = True. For Jacobi rows, point customRowsFile at the exported Jacobi WXF file. Leave targetTransform = \"StandardizedWeight\" below to train on each row’s Target directly. Bundled exact coefficients are cached as WXF and exported as readable CSV alongside their metadata.", "Text"]
}, Open]],

Cell[CellGroupData[{
Cell["3. Editable architecture and training settings", "Section"],

Cell["Architecture", "Subsection"],

Cell["A list specifies the number of neurons in each hidden layer; all these hidden layers use Ramp (ReLU). For example, {128,128,128} is depth 3 and width 128. Change modelSpec below to edit the architecture used by TrainRun. Named specifications Net1, Net2 and Net3 retain their own activation patterns; Net1 includes a LogisticSigmoid in its second hidden layer.", "Text"],

Cell[BoxData[RowBox[{"modelSpec", " ", "=", " ", "{", "128", ",", " ", "128", ",", " ", "128", "}", ";", "\n", "featurePositions", " ", "=", " ", "Range", "[", "Length", "[", "rows", "[", "[", "1", "]", "]", "[", "\"Coefficients\"", "]", "]", "]", ";", "\n", "inputDimension", " ", "=", " ", "Length", "[", "featurePositions", "]", ";", "\n", "networkPreview", " ", "=", " ", "must", "[", "UnifiedTraining`BuildModel", "[", "inputDimension", ",", " ", "modelSpec", "]", "]", ";", "\n", "parameterCount", " ", "=", " ", "must", "[", "UnifiedTraining`ParameterCount", "[", "inputDimension", ",", " ", "modelSpec", "]", "]", ";", "\n", "{", "networkPreview", ",", " ", "parameterCount", "}"}]], "Input" , CellTags -> "input-15"],

Cell["The corresponding editable NetChain for a list of hidden widths is shown below. This cell constructs a network for inspection; the saved example in Section 5 takes its architecture from modelSpec above. Section 6 shows how to train a freely edited NetChain directly.", "Text"],

Cell[BoxData[RowBox[{"visibleNetwork", " ", "=", " ", "If", "[", "ListQ", "[", "modelSpec", "]", ",", "\n", "  ", "NetChain", "[", "Append", "[", "Flatten", "[", "Table", "[", "\n", "    ", "{", "LinearLayer", "[", "width", "]", ",", " ", "ElementwiseLayer", "[", "Ramp", "]", "}", ",", " ", "{", "width", ",", " ", "modelSpec", "}", "]", ",", " ", "1", "]", ",", "\n", "    ", "LinearLayer", "[", "1", "]", "]", ",", " ", "\"Input\"", " ", "->", " ", "inputDimension", "]", ",", "\n", "  ", "networkPreview", "\n", "]", ";", "\n", "visibleNetwork"}]], "Input" , CellTags -> "input-17"],

Cell["Preprocessing, targets and optimizer", "Subsection"],

Cell["The eta example uses samplewise L2 normalization and a standardized weight target. For the CHL example, select LogAbsL2 and LogAbsPower, set weightFactor = 6 and powerSign = 1, and use RMSProp with an Automatic learning-rate schedule. CHL predictions are decoded to physical weights before MAPE and RMSE are calculated. Feature positions are one-based indices: {1,2} selects the q^0 and q^1 coefficients in these datasets.", "Text"],

Cell[BoxData[RowBox[{"inputTransform", " ", "=", " ", "\"L2\"", ";", "\n", "targetTransform", " ", "=", " ", "\"StandardizedWeight\"", ";", "\n", "weightFactor", " ", "=", " ", "1", "/", "2", ";", "\n", "powerSign", " ", "=", " ", "-", "1", ";", "\n", "optimizerName", " ", "=", " ", "\"ADAM\"", ";", "\n", "learningRate", " ", "=", " ", "0.001", ";", "\n", "learningRateSchedule", " ", "=", " ", "\"Constant\"", ";", "\n", "initializerName", " ", "=", " ", "\"Kaiming\"", ";", "\n", "seed", " ", "=", " ", "101", ";", "\n", "epochs", " ", "=", " ", "If", "[", "quickExample", ",", " ", "5", ",", " ", "10000", "]", ";", "\n", "batchSize", " ", "=", " ", "64", ";", "\n", "workingPrecision", " ", "=", " ", "\"Real64\"", ";", "\n", "targetDevice", " ", "=", " ", "\"CPU\"", ";", "\n", "exampleSettings", " ", "=", " ", "<|", "\n", "  ", "\"ExperimentID\"", " ", "->", " ", "\"notebook_example\"", ",", " ", "\"Dataset\"", " ", "->", " ", "datasetID", ",", "\n", "  ", "\"Model\"", " ", "->", " ", "modelSpec", ",", " ", "\"FeaturePositions\"", " ", "->", " ", "featurePositions", ",", "\n", "  ", "\"InputTransform\"", " ", "->", " ", "inputTransform", ",", " ", "\"TargetTransform\"", " ", "->", " ", "targetTransform", ",", "\n", "  ", "\"WeightFactor\"", " ", "->", " ", "weightFactor", ",", " ", "\"PowerSign\"", " ", "->", " ", "powerSign", ",", "\n", "  ", "\"Optimizer\"", " ", "->", " ", "optimizerName", ",", " ", "\"LearningRate\"", " ", "->", " ", "learningRate", ",", "\n", "  ", "\"LearningRateSchedule\"", " ", "->", " ", "learningRateSchedule", ",", " ", "\"MethodOptions\"", " ", "->", " ", "<|", "|>", ",", "\n", "  ", "\"Initializer\"", " ", "->", " ", "initializerName", ",", " ", "\"Seed\"", " ", "->", " ", "seed", ",", "\n", "  ", "\"InitializationSeed\"", " ", "->", " ", "10000", " ", "+", " ", "seed", ",", " ", "\"TrainingSeed\"", " ", "->", " ", "20000", " ", "+", " ", "seed", ",", "\n", "  ", "\"SplitSeed\"", " ", "->", " ", "splitSeed", ",", " ", "\"Rounds\"", " ", "->", " ", "epochs", ",", " ", "\"BatchSize\"", " ", "->", " ", "batchSize", ",", "\n", "  ", "\"WorkingPrecision\"", " ", "->", " ", "workingPrecision", ",", " ", "\"TargetDevice\"", " ", "->", " ", "targetDevice", ",", "\n", "  ", "\"Smoke\"", " ", "->", " ", "quickExample", "|>", ";", "\n", "Dataset", "[", "exampleSettings", "]"}]], "Input" , CellTags -> "input-20"],

Cell["L2 divides each coefficient vector by its Euclidean norm. LogAbsL2 takes log(|a_n|), maps an exactly zero coefficient to zero, and then applies L2 normalization; coefficient positions are retained. SignedLogStandardized instead takes sign(a_n/a_0) log(1+|a_n/a_0|) and standardizes each coordinate using training rows only. It requires a nonzero first selected coefficient; choose the selected positions with that normalization convention in mind.", "Text"],

Cell["See the transformed data before training", "Subsection"],

Cell[BoxData[RowBox[{"trainingIndices", " ", "=", " ", "split", "[", "\"Train\"", "]", ";", "\n", "validationIndices", " ", "=", " ", "split", "[", "\"Validation\"", "]", ";", "\n", "coefficientMatrix", " ", "=", " ", "Lookup", "[", "rows", ",", " ", "\"Coefficients\"", "]", "[", "[", "All", ",", " ", "featurePositions", "]", "]", ";", "\n", "transformedInputs", " ", "=", " ", "must", "[", "UnifiedTraining`TransformInputs", "[", "coefficientMatrix", ",", " ", "inputTransform", "]", "]", ";", "\n", "inputPreprocessor", " ", "=", " ", "<|", "\"Mode\"", " ", "->", " ", "inputTransform", ",", "\n", "  ", "\"FeaturePositions\"", " ", "->", " ", "featurePositions", ",", " ", "\"Dimension\"", " ", "->", " ", "inputDimension", "|>", ";", "\n", "If", "[", "inputTransform", " ", "===", " ", "\"SignedLogStandardized\"", ",", "\n", "  ", "inputMean", " ", "=", " ", "Mean", "[", "transformedInputs", "[", "[", "trainingIndices", "]", "]", "]", ";", "\n", "  ", "inputScale", " ", "=", " ", "StandardDeviation", "[", "transformedInputs", "[", "[", "trainingIndices", "]", "]", "]", ";", "\n", "  ", "inputScale", " ", "=", " ", "Replace", "[", "inputScale", ",", " ", "x", "_", " ", "/;", " ", "TrueQ", "[", "x", " ", "==", " ", "0", "]", " ", ":>", " ", "1.", ",", " ", "{", "1", "}", "]", ";", "\n", "  ", "transformedInputs", " ", "=", " ", "(", "(", "#", " ", "-", " ", "inputMean", ")", "/", "inputScale", ")", " ", "&", " ", "/@", " ", "transformedInputs", ";", "\n", "  ", "inputPreprocessor", " ", "=", " ", "Join", "[", "inputPreprocessor", ",", "\n", "    ", "<|", "\"Mean\"", " ", "->", " ", "inputMean", ",", " ", "\"Scale\"", " ", "->", " ", "inputScale", "|>", "]", "\n", "]", ";", "\n", "encodedTargets", " ", "=", " ", "must", "[", "UnifiedTraining`EncodeTargets", "[", "rows", ",", " ", "trainingIndices", ",", " ", "exampleSettings", "]", "]", ";", "\n", "latentTargets", " ", "=", " ", "encodedTargets", "[", "\"Values\"", "]", ";", "\n", "Dataset", "[", "<|", "\"Input dimensions\"", " ", "->", " ", "Dimensions", "[", "transformedInputs", "]", ",", "\n", "  ", "\"Target transformation\"", " ", "->", " ", "encodedTargets", "[", "\"Transform\"", "]", ",", "\n", "  ", "\"First five physical weights\"", " ", "->", " ", "Take", "[", "Lookup", "[", "rows", ",", " ", "\"Target\"", "]", ",", " ", "UpTo", "[", "5", "]", "]", ",", "\n", "  ", "\"First five training targets\"", " ", "->", " ", "Take", "[", "latentTargets", ",", " ", "UpTo", "[", "5", "]", "]", "|>", "]"}]], "Input" , CellTags -> "input-23"],

Cell["For StandardizedWeight the training target is (K - mu)/s, where mu and s are the mean and sample standard deviation of the training weights. The validation and test weights use those same values. For LogAbsPower the target is log(|p|), and decoding uses K = powerSign × weightFactor × exp(prediction). A target with an additive weight offset, such as the E2Eta family, should use Weight or StandardizedWeight.", "Text"]
}, Open]],

Cell[CellGroupData[{
Cell["4. Initialization and the training objective", "Section"],

Cell["Each run explicitly initializes the weights and records the initialization seed separately from the training seed. Paired optimizer runs at a fixed seed use the same initialized architecture and data split. The training objective is mean squared error in the declared target space. The full epoch budget is completed, with both the final network and the network selected by lowest validation MSE retained.", "Text"],

Cell[BoxData[RowBox[{"initializationMethod", " ", "=", " ", "Switch", "[", "initializerName", ",", "\n", "  ", "\"Kaiming\"", " ", "|", " ", "\"Xavier\"", ",", " ", "{", "initializerName", ",", " ", "\"Distribution\"", " ", "->", " ", "\"Normal\"", "}", ",", "\n", "  ", "\"Orthogonal\"", ",", " ", "\"Orthogonal\"", ",", "\n", "  ", "_", ",", " ", "Print", "[", "\"Choose Kaiming, Xavier or Orthogonal.\"", "]", ";", " ", "Abort", "[", "]", "]", ";", "\n", "initializedPreview", " ", "=", " ", "NetInitialize", "[", "networkPreview", ",", " ", "All", ",", "\n", "  ", "Method", " ", "->", " ", "initializationMethod", ",", "\n", "  ", "RandomSeeding", " ", "->", " ", "exampleSettings", "[", "\"InitializationSeed\"", "]", "]", ";", "\n", "initializedPreview"}]], "Input" , CellTags -> "input-27"],

Cell["The initializedPreview is for inspection. TrainRun recreates the initialization from these same settings when a new fit is needed. A completed fit is reused only when its settings, input rows, split, training source and Wolfram system identity match the saved run.", "Text"]
}, Open]],

Cell[CellGroupData[{
Cell["5. Run and inspect the saved example", "Section"],

Cell[BoxData[RowBox[{"exampleRun", " ", "=", " ", "If", "[", "TrueQ", "[", "runExample", "]", ",", "\n", "  ", "must", "[", "UnifiedTraining`TrainRun", "[", "rows", ",", " ", "split", ",", " ", "exampleSettings", ",", "\n", "    ", "FileNameJoin", "[", "{", "outputRoot", ",", " ", "\"example_runs\"", "}", "]", "]", "]", ",", "\n", "  ", "Missing", "[", "\"NotRun\"", ",", " ", "\"Set runExample = True to train the example.\"", "]", "\n", "]", ";", "\n", "If", "[", "AssociationQ", "[", "exampleRun", "]", ",", "\n", "  ", "Dataset", "[", "exampleRun", "[", "\"Metrics\"", "]", "[", "\"Best\"", "]", "]", ",", " ", "exampleRun", "]"}]], "Input" , CellTags -> "input-30"],

Cell["Best denotes the checkpoint with the lowest validation MSE, not the lowest test error. Final denotes the last epoch. MAPE is 100 times the mean absolute relative error on the physical weight; RMSE has the same units as that weight. Neither quantity is the logarithmic target loss used in the CHL fits. If any target is zero, the ordinary MAPE is undefined and the output records this explicitly.", "Text"],

Cell[BoxData[RowBox[{"If", "[", "AssociationQ", "[", "exampleRun", "]", ",", "\n", "  ", "Dataset", "[", "Join", "[", "exampleRun", "[", "\"Settings\"", "]", ",", "\n", "    ", "KeyTake", "[", "exampleRun", ",", " ", "{", "\"Signature\"", ",", " ", "\"Parameters\"", ",", " ", "\"TrainCount\"", ",", " ", "\"ValidationCount\"", ",", "\n", "      ", "\"TestCount\"", ",", " ", "\"TotalRounds\"", ",", " ", "\"BestValidationRound\"", ",", " ", "\"Seconds\"", ",", " ", "\"Version\"", ",", " ", "\"SystemID\"", "}", "]", "]", "]", ",", "\n", "  ", "\"No saved example has been loaded in this session.\"", "\n", "]"}]], "Input" , CellTags -> "input-32"],

Cell[BoxData[RowBox[{"If", "[", "AssociationQ", "[", "exampleRun", "]", ",", "\n", "  ", "ListLinePlot", "[", "{", "\n", "    ", "Transpose", "[", "{", "exampleRun", "[", "\"RoundPositions\"", "]", ",", " ", "exampleRun", "[", "\"RoundLossList\"", "]", "}", "]", ",", "\n", "    ", "Transpose", "[", "{", "exampleRun", "[", "\"ValidationPositions\"", "]", ",", " ", "exampleRun", "[", "\"ValidationLossList\"", "]", "}", "]", "}", ",", "\n", "    ", "Frame", " ", "->", " ", "True", ",", " ", "FrameLabel", " ", "->", " ", "{", "\"Training batch\"", ",", " ", "\"MSE in training-target space\"", "}", ",", "\n", "    ", "PlotLegends", " ", "->", " ", "{", "\"Online training loss\"", ",", " ", "\"Validation loss\"", "}", ",", "\n", "    ", "PlotRange", " ", "->", " ", "All", ",", " ", "ImageSize", " ", "->", " ", "540", "]", ",", "\n", "  ", "\"Run the example to display its loss history.\"", "\n", "]"}]], "Input" , CellTags -> "input-33"]
}, Open]],

Cell[CellGroupData[{
Cell["6. Optional: a freely edited NetChain", "Section"],

Cell["Use this section when changing activations, adding layers or experimenting with a network that is not described by the shared model specifications. It trains customNetwork directly. The transformed inputs, encoded targets and initialization method are those prepared above. This is a separate exploratory fit, with its own saved result; it is not included in the 174-fit study.", "Text"],

Cell[BoxData[RowBox[{"customNetwork", " ", "=", " ", "NetChain", "[", "{", "\n", "  ", "LinearLayer", "[", "128", "]", ",", " ", "ElementwiseLayer", "[", "Ramp", "]", ",", "\n", "  ", "LinearLayer", "[", "128", "]", ",", " ", "ElementwiseLayer", "[", "Ramp", "]", ",", "\n", "  ", "LinearLayer", "[", "128", "]", ",", " ", "ElementwiseLayer", "[", "Ramp", "]", ",", "\n", "  ", "LinearLayer", "[", "1", "]", "}", ",", " ", "\"Input\"", " ", "->", " ", "inputDimension", "]", ";", "\n", "customNetwork"}]], "Input" , CellTags -> "input-36"],

Cell[BoxData[RowBox[{"customMethod", " ", "=", " ", "Switch", "[", "optimizerName", ",", "\n", "  ", "\"ADAM\"", ",", " ", "{", "\"ADAM\"", ",", " ", "\"Beta1\"", " ", "->", " ", "0.9", ",", " ", "\"Beta2\"", " ", "->", " ", "0.999", ",", "\n", "    ", "\"Epsilon\"", " ", "->", " ", "10", "^", "-", "5", ",", " ", "\"L2Regularization\"", " ", "->", " ", "None", "}", ",", "\n", "  ", "\"RMSProp\"", ",", " ", "{", "\"RMSProp\"", ",", " ", "\"Beta\"", " ", "->", " ", "0.95", ",", " ", "\"Momentum\"", " ", "->", " ", "0.9", ",", "\n", "    ", "\"Epsilon\"", " ", "->", " ", "10", "^", "-", "6", ",", " ", "\"L2Regularization\"", " ", "->", " ", "None", "}", ",", "\n", "  ", "\"SGD\"", ",", " ", "{", "\"SGD\"", ",", " ", "\"Momentum\"", " ", "->", " ", "0.93", ",", " ", "\"L2Regularization\"", " ", "->", " ", "None", "}", ",", "\n", "  ", "_", ",", " ", "Print", "[", "\"Unknown optimizer.\"", "]", ";", " ", "Abort", "[", "]", "]", ";", "\n", "If", "[", "learningRateSchedule", " ", "===", " ", "\"Constant\"", ",", "\n", "  ", "customMethod", " ", "=", " ", "Append", "[", "customMethod", ",", "\n", "    ", "\"LearningRateSchedule\"", " ", "->", " ", "Function", "[", "{", "batch", ",", " ", "total", "}", ",", " ", "1", "]", "]", "\n", "]", ";"}]], "Input" , CellTags -> "input-37"],

Cell[BoxData[RowBox[{"If", "[", "TrueQ", "[", "runCustomNetwork", "]", ",", "\n", "  ", "customInitial", " ", "=", " ", "must", "[", "Check", "[", "NetInitialize", "[", "customNetwork", ",", " ", "All", ",", "\n", "    ", "Method", " ", "->", " ", "initializationMethod", ",", "\n", "    ", "RandomSeeding", " ", "->", " ", "exampleSettings", "[", "\"InitializationSeed\"", "]", "]", ",", " ", "$Failed", "]", "]", ";", "\n", "  ", "customAnswer", " ", "=", " ", "must", "[", "Check", "[", "NetTrain", "[", "customInitial", ",", "\n", "    ", "Thread", "[", "transformedInputs", "[", "[", "trainingIndices", "]", "]", " ", "->", " ", "List", " ", "/@", " ", "latentTargets", "[", "[", "trainingIndices", "]", "]", "]", ",", "\n", "    ", "{", "\"FinalNet\"", ",", " ", "\"TrainedNet\"", ",", " ", "\"ResultsObject\"", "}", ",", "\n", "    ", "ValidationSet", " ", "->", " ", "{", "Thread", "[", "transformedInputs", "[", "[", "validationIndices", "]", "]", " ", "->", "\n", "      ", "List", " ", "/@", " ", "latentTargets", "[", "[", "validationIndices", "]", "]", "]", ",", " ", "\"Interval\"", " ", "->", " ", "1", "}", ",", "\n", "    ", "LossFunction", " ", "->", " ", "MeanSquaredLossLayer", "[", "]", ",", " ", "Method", " ", "->", " ", "customMethod", ",", "\n", "    ", "LearningRate", " ", "->", " ", "learningRate", ",", " ", "BatchSize", " ", "->", " ", "batchSize", ",", "\n", "    ", "MaxTrainingRounds", " ", "->", " ", "epochs", ",", " ", "TrainingStoppingCriterion", " ", "->", " ", "None", ",", "\n", "    ", "RandomSeeding", " ", "->", " ", "exampleSettings", "[", "\"TrainingSeed\"", "]", ",", " ", "TargetDevice", " ", "->", " ", "targetDevice", ",", "\n", "    ", "WorkingPrecision", " ", "->", " ", "workingPrecision", ",", " ", "TrainingProgressReporting", " ", "->", " ", "None", "]", ",", " ", "$Failed", "]", "]", ";", "\n", "  ", "If", "[", "!", "ListQ", "[", "customAnswer", "]", " ", "||", " ", "Length", "[", "customAnswer", "]", " ", "!=", " ", "3", ",", "\n", "    ", "Print", "[", "\"NetTrain did not return the requested results.\"", "]", ";", " ", "Abort", "[", "]", "]", ";", "\n", "  ", "If", "[", "!", "TrueQ", "[", "customAnswer", "[", "[", "3", "]", "]", "[", "\"TotalRounds\"", "]", " ", ">=", " ", "epochs", "]", ",", "\n", "    ", "Print", "[", "\"The requested epoch budget was not completed.\"", "]", ";", " ", "Abort", "[", "]", "]", ";", "\n", "  ", "customRun", " ", "=", " ", "<|", "\"FinalNet\"", " ", "->", " ", "customAnswer", "[", "[", "1", "]", "]", ",", " ", "\"BestNet\"", " ", "->", " ", "customAnswer", "[", "[", "2", "]", "]", ",", "\n", "    ", "\"Settings\"", " ", "->", " ", "Join", "[", "exampleSettings", ",", " ", "<|", "\"Model\"", " ", "->", " ", "\"CustomNetChain\"", "|>", "]", ",", "\n", "    ", "\"UninitializedNetwork\"", " ", "->", " ", "customNetwork", ",", " ", "\"InitialNetwork\"", " ", "->", " ", "customInitial", ",", "\n", "    ", "\"Preprocessor\"", " ", "->", " ", "inputPreprocessor", ",", "\n", "    ", "\"TargetTransform\"", " ", "->", " ", "encodedTargets", "[", "\"Transform\"", "]", ",", "\n", "    ", "\"TrainingTargetSD\"", " ", "->", " ", "encodedTargets", "[", "\"TrainingTargetSD\"", "]", ",", "\n", "    ", "\"Split\"", " ", "->", " ", "split", ",", " ", "\"DatasetHash\"", " ", "->", " ", "exampleDataset", "[", "\"DatasetHash\"", "]", ",", "\n", "    ", "\"RowIDs\"", " ", "->", " ", "Lookup", "[", "rows", ",", " ", "\"ID\"", "]", ",", " ", "\"Version\"", " ", "->", " ", "$Version", ",", " ", "\"SystemID\"", " ", "->", " ", "$SystemID", ",", "\n", "    ", "\"TotalRounds\"", " ", "->", " ", "customAnswer", "[", "[", "3", "]", "]", "[", "\"TotalRounds\"", "]", ",", "\n", "    ", "\"BestValidationRound\"", " ", "->", " ", "customAnswer", "[", "[", "3", "]", "]", "[", "\"BestValidationRound\"", "]", ",", "\n", "    ", "\"RoundPositions\"", " ", "->", " ", "customAnswer", "[", "[", "3", "]", "]", "[", "\"RoundPositions\"", "]", ",", "\n", "    ", "\"RoundLossList\"", " ", "->", " ", "customAnswer", "[", "[", "3", "]", "]", "[", "\"RoundLossList\"", "]", ",", "\n", "    ", "\"ValidationPositions\"", " ", "->", " ", "customAnswer", "[", "[", "3", "]", "]", "[", "\"ValidationPositions\"", "]", ",", "\n", "    ", "\"ValidationLossList\"", " ", "->", " ", "customAnswer", "[", "[", "3", "]", "]", "[", "\"ValidationLossList\"", "]", "|>", ";", "\n", "  ", "customEvaluation", " ", "=", " ", "AssociationMap", "[", "\n", "    ", "must", "[", "UnifiedTraining`EvaluateRun", "[", "customRun", ",", " ", "rows", ",", " ", "split", ",", " ", "#", "]", "]", " ", "&", ",", " ", "{", "\"Final\"", ",", " ", "\"Best\"", "}", "]", ";", "\n", "  ", "customRun", " ", "=", " ", "Join", "[", "customRun", ",", " ", "<|", "\n", "    ", "\"Metrics\"", " ", "->", " ", "AssociationMap", "[", "customEvaluation", "[", "#", "]", "[", "\"Metrics\"", "]", " ", "&", ",", " ", "{", "\"Final\"", ",", " ", "\"Best\"", "}", "]", ",", "\n", "    ", "\"Predictions\"", " ", "->", " ", "AssociationMap", "[", "customEvaluation", "[", "#", "]", "[", "\"Predictions\"", "]", " ", "&", ",", " ", "{", "\"Final\"", ",", " ", "\"Best\"", "}", "]", "|>", "]", ";", "\n", "  ", "customDirectory", " ", "=", " ", "FileNameJoin", "[", "{", "outputRoot", ",", " ", "\"custom_runs\"", "}", "]", ";", "\n", "  ", "If", "[", "!", "DirectoryQ", "[", "customDirectory", "]", ",", " ", "CreateDirectory", "[", "customDirectory", ",", "\n", "    ", "CreateIntermediateDirectories", " ", "->", " ", "True", "]", "]", ";", "\n", "  ", "customFile", " ", "=", " ", "FileNameJoin", "[", "{", "customDirectory", ",", "\n", "    ", "\"custom_\"", " ", "<>", " ", "StringReplace", "[", "CreateUUID", "[", "]", ",", " ", "\"-\"", " ", "->", " ", "\"\"", "]", " ", "<>", " ", "\".wxf\"", "}", "]", ";", "\n", "  ", "must", "[", "Export", "[", "customFile", ",", " ", "customRun", ",", " ", "\"WXF\"", "]", "]", ";", "\n", "  ", "Dataset", "[", "customRun", "[", "\"Metrics\"", "]", "[", "\"Best\"", "]", "]", ",", "\n", "  ", "\"Set runCustomNetwork = True to train the literal NetChain above.\"", "\n", "]"}]], "Input" , CellTags -> "input-38"],

Cell["A custom fit receives a new file name each time. For repeated large sweeps, encode the desired architecture as a shared model specification so that the study runner can record parameter counts and reuse completed fits consistently. Do not select architectures or learning rates by inspecting the test errors.", "Text"]
}, Open]],

Cell[CellGroupData[{
Cell["7. Assemble the width/depth and CHL study", "Section"],

Cell["The default selection contains 26 width/depth configurations and 32 manuscript-table configurations. Three seeds give 78 + 96 = 174 fits. The depth/width configurations include three hidden layers of width 128 for both representative datasets. The optional E2 suite consists of three configurations, also repeated over three seeds.", "Text"],

Cell[BoxData[RowBox[{"studyEpochs", " ", "=", " ", "10000", ";", "\n", "studySeeds", " ", "=", " ", "{", "101", ",", " ", "102", ",", " ", "103", "}", ";", "\n", "studySuite", " ", "=", " ", "\"all\"", ";", "\n", "includeE2", " ", "=", " ", "False", ";", "\n", "onlyExperimentIDs", " ", "=", " ", "{", "}", ";", "\n", "studyExperiments", " ", "=", " ", "experimentDefinitions", ";", "\n", "studyDatasets", " ", "=", " ", "datasetDefinitions", ";", "\n", "studyDefaults", " ", "=", " ", "Join", "[", "defaultSettings", ",", " ", "<|", "\"Rounds\"", " ", "->", " ", "studyEpochs", ",", "\n", "  ", "\"Seeds\"", " ", "->", " ", "studySeeds", ",", " ", "\"SplitSeed\"", " ", "->", " ", "splitSeed", "|>", "]", ";"}]], "Input" , CellTags -> "input-42"],

Cell["Edit studyEpochs or studySeeds to change the budget or repetitions. Use studySuite = \"width-depth\", \"chl\" or \"e2\" to select one suite. Leave \"all\" for the default 174 fits. To run particular configurations, set onlyExperimentIDs to their names, for example {\"table2_N3\"}. The list below is a plan only and does not train or generate coefficients.", "Text"],

Cell[BoxData[RowBox[{"selectedExperiments", " ", "=", " ", "Select", "[", "studyExperiments", ",", "\n", "  ", "Switch", "[", "studySuite", ",", "\n", "    ", "\"all\"", ",", " ", "MemberQ", "[", "If", "[", "includeE2", ",", " ", "{", "\"width_depth\"", ",", " ", "\"chl\"", ",", " ", "\"e2\"", "}", ",", "\n", "      ", "{", "\"width_depth\"", ",", " ", "\"chl\"", "}", "]", ",", " ", "#", "[", "\"Study\"", "]", "]", ",", "\n", "    ", "\"width-depth\"", ",", " ", "#", "[", "\"Study\"", "]", " ", "===", " ", "\"width_depth\"", ",", "\n", "    ", "\"chl\"", ",", " ", "#", "[", "\"Study\"", "]", " ", "===", " ", "\"chl\"", ",", " ", "\"e2\"", ",", " ", "#", "[", "\"Study\"", "]", " ", "===", " ", "\"e2\"", ",", " ", "_", ",", " ", "False", "]", " ", "&", "]", ";", "\n", "If", "[", "onlyExperimentIDs", " ", "=!=", " ", "{", "}", ",", " ", "selectedExperiments", " ", "=", " ", "Select", "[", "selectedExperiments", ",", "\n", "  ", "MemberQ", "[", "onlyExperimentIDs", ",", " ", "#", "[", "\"ExperimentID\"", "]", "]", " ", "&", "]", "]", ";", "\n", "planSummary", " ", "=", " ", "<|", "\"Configurations\"", " ", "->", " ", "Length", "[", "selectedExperiments", "]", ",", "\n", "  ", "\"Seeds\"", " ", "->", " ", "studySeeds", ",", " ", "\"Fits\"", " ", "->", " ", "Length", "[", "selectedExperiments", "]", " ", "Length", "[", "studySeeds", "]", ",", "\n", "  ", "\"Epochs per fit\"", " ", "->", " ", "studyEpochs", ",", " ", "\"Batch size\"", " ", "->", " ", "studyDefaults", "[", "\"BatchSize\"", "]", "|>", ";", "\n", "Dataset", "[", "planSummary", "]"}]], "Input" , CellTags -> "input-44"],

Cell[BoxData[RowBox[{"Dataset", "[", "KeyTake", "[", "#", ",", " ", "{", "\"ExperimentID\"", ",", " ", "\"Study\"", ",", " ", "\"Dataset\"", ",", " ", "\"Model\"", ",", " ", "\"LayerWidths\"", ",", "\n", "  ", "\"Optimizer\"", ",", " ", "\"InputTransform\"", ",", " ", "\"TargetTransform\"", ",", " ", "\"LearningRateSchedule\"", "}", "]", " ", "&", " ", "/@", "\n", "  ", "selectedExperiments", "]"}]], "Input" , CellTags -> "input-45"],

Cell["An example of editing or extending the study", "Subsection"],

Cell["The following cell constructs an additional configuration without adding it automatically. Set its dataset, architecture and target conventions explicitly. To include it, append newExperiment to studyExperiments, then reevaluate the plan. When changing Model, update LayerWidths to the same hidden widths; the latter supplies the depth/width labels in the output tables.", "Text"],

Cell[BoxData[RowBox[{"newExperiment", " ", "=", " ", "Join", "[", "\n", "  ", "SelectFirst", "[", "experimentDefinitions", ",", "\n", "    ", "#", "[", "\"ExperimentID\"", "]", " ", "===", " ", "\"wd_eta_negative_Depth3Width128_ADAM\"", " ", "&", "]", ",", "\n", "  ", "<|", "\"ExperimentID\"", " ", "->", " ", "\"wd_eta_negative_Depth3Width64_ADAM\"", ",", "\n", "    ", "\"Model\"", " ", "->", " ", "{", "64", ",", " ", "64", ",", " ", "64", "}", ",", " ", "\"LayerWidths\"", " ", "->", " ", "{", "64", ",", " ", "64", ",", " ", "64", "}", "|>", "]", ";", "\n", "(* To include it, evaluate: studyExperiments = Append[studyExperiments, newExperiment]; *)"}]], "Input" , CellTags -> "input-48"],

Cell["To add a dataset from an existing family, add a named specification to studyDatasets and point a new experiment at that name. JSON specifications use PowerRange, PowerHalfIntegerRange or a bundled PowersFile to preserve exact powers. A genuinely new coefficient formula can be explored through the row associations from Notebook 1 and the single-fit workflow above; integrating it into the full study requires adding that generator to the shared data package.", "Text"],

Cell["Run the selected study", "Subsection"],

Cell["A study input directory is created under generated/studies using a hash of its configuration and supporting source. Changed configurations receive a different directory; previously generated configurations are not overwritten. Matching runs can be resumed by reevaluating this cell. Its CSV results are read by Notebook 3. Do not launch two copies of the same study concurrently.", "Text"],

Cell[BoxData[RowBox[{"If", "[", "TrueQ", "[", "runStudy", "]", ",", "\n", "  ", "If", "[", "selectedExperiments", " ", "===", " ", "{", "}", ",", " ", "Print", "[", "\"The study selection is empty.\"", "]", ";", " ", "Abort", "[", "]", "]", ";", "\n", "  ", "If", "[", "!", "IntegerQ", "[", "studyEpochs", "]", " ", "||", " ", "studyEpochs", " ", "<", " ", "1", " ", "||", " ", "!", "ListQ", "[", "studySeeds", "]", " ", "||", "\n", "     ", "studySeeds", " ", "===", " ", "{", "}", " ", "||", " ", "!", "VectorQ", "[", "studySeeds", ",", " ", "IntegerQ", "]", " ", "||", " ", "!", "DuplicateFreeQ", "[", "studySeeds", "]", ",", "\n", "    ", "Print", "[", "\"Use a positive integer epoch budget and distinct integer seeds.\"", "]", ";", " ", "Abort", "[", "]", "]", ";", "\n", "  ", "If", "[", "!", "DuplicateFreeQ", "[", "Lookup", "[", "studyExperiments", ",", " ", "\"ExperimentID\"", "]", "]", ",", "\n", "    ", "Print", "[", "\"Experiment IDs must be unique.\"", "]", ";", " ", "Abort", "[", "]", "]", ";", "\n", "  ", "studyDefaults", " ", "=", " ", "Join", "[", "studyDefaults", ",", " ", "<|", "\"Rounds\"", " ", "->", " ", "studyEpochs", ",", " ", "\"Seeds\"", " ", "->", " ", "studySeeds", "|>", "]", ";", "\n", "  ", "studyOptions", " ", "=", " ", "<|", "\"Suite\"", " ", "->", " ", "studySuite", ",", " ", "\"WithE2\"", " ", "->", " ", "includeE2", ",", "\n", "    ", "\"Only\"", " ", "->", " ", "StringRiffle", "[", "onlyExperimentIDs", ",", " ", "\",\"", "]", ",", " ", "\"Smoke\"", " ", "->", " ", "False", ",", "\n", "    ", "\"Rounds\"", " ", "->", " ", "studyEpochs", "|>", ";", "\n", "  ", "sourceFiles", " ", "=", " ", "Sort", "[", "Join", "[", "FileNames", "[", "\"*.wl\"", ",", " ", "FileNameJoin", "[", "{", "supportDir", ",", " ", "\"src\"", "}", "]", "]", ",", "\n", "    ", "FileNames", "[", "\"*.wl\"", ",", " ", "FileNameJoin", "[", "{", "supportDir", ",", " ", "\"resources\"", "}", "]", "]", "]", "]", ";", "\n", "  ", "studyKey", " ", "=", " ", "StringTake", "[", "IntegerString", "[", "Hash", "[", "{", "studyDefaults", ",", " ", "studyDatasets", ",", "\n", "    ", "studyExperiments", ",", " ", "(", "{", "FileNameTake", "[", "#", "]", ",", " ", "FileHash", "[", "#", ",", " ", "\"SHA256\"", "]", "}", " ", "&", " ", "/@", " ", "sourceFiles", ")", "}", ",", "\n", "    ", "\"SHA256\"", "]", ",", " ", "16", ",", " ", "64", "]", ",", " ", "16", "]", ";", "\n", "  ", "studyDirectory", " ", "=", " ", "FileNameJoin", "[", "{", "outputRoot", ",", " ", "\"studies\"", ",", " ", "studyKey", "}", "]", ";", "\n", "  ", "If", "[", "!", "DirectoryQ", "[", "studyDirectory", "]", ",", "\n", "    ", "CreateDirectory", "[", "studyDirectory", ",", " ", "CreateIntermediateDirectories", " ", "->", " ", "True", "]", ";", "\n", "    ", "Do", "[", "CopyDirectory", "[", "FileNameJoin", "[", "{", "supportDir", ",", " ", "part", "}", "]", ",", "\n", "      ", "FileNameJoin", "[", "{", "studyDirectory", ",", " ", "part", "}", "]", "]", ",", " ", "{", "part", ",", " ", "{", "\"src\"", ",", " ", "\"resources\"", "}", "}", "]", ";", "\n", "    ", "CreateDirectory", "[", "FileNameJoin", "[", "{", "studyDirectory", ",", " ", "\"config\"", "}", "]", "]", ";", "\n", "    ", "must", "[", "Export", "[", "FileNameJoin", "[", "{", "studyDirectory", ",", " ", "\"config\"", ",", " ", "\"defaults.json\"", "}", "]", ",", " ", "studyDefaults", ",", " ", "\"RawJSON\"", "]", "]", ";", "\n", "    ", "must", "[", "Export", "[", "FileNameJoin", "[", "{", "studyDirectory", ",", " ", "\"config\"", ",", " ", "\"datasets.json\"", "}", "]", ",", " ", "studyDatasets", ",", " ", "\"RawJSON\"", "]", "]", ";", "\n", "    ", "must", "[", "Export", "[", "FileNameJoin", "[", "{", "studyDirectory", ",", " ", "\"config\"", ",", " ", "\"experiments.json\"", "}", "]", ",", " ", "studyExperiments", ",", " ", "\"RawJSON\"", "]", "]", "\n", "  ", "]", ";", "\n", "  ", "Do", "[", "Get", "[", "FileNameJoin", "[", "{", "studyDirectory", ",", " ", "\"src\"", ",", " ", "file", "}", "]", "]", ",", "\n", "    ", "{", "file", ",", " ", "{", "\"Data.wl\"", ",", " ", "\"Training.wl\"", ",", " ", "\"Study.wl\"", "}", "}", "]", ";", "\n", "  ", "studyResult", " ", "=", " ", "must", "[", "UnifiedStudy`RunStudy", "[", "studyDirectory", ",", " ", "studyOptions", "]", "]", ";", "\n", "  ", "must", "[", "Export", "[", "FileNameJoin", "[", "{", "outputRoot", ",", " ", "\"LATEST_STUDY.txt\"", "}", "]", ",", "\n", "    ", "studyResult", "[", "\"OutputDirectory\"", "]", ",", " ", "\"Text\"", "]", "]", ";", "\n", "  ", "studyResult", ",", "\n", "  ", "\"Set runStudy = True after reviewing the plan to start or resume the selected fits.\"", "\n", "]"}]], "Input" , CellTags -> "input-52"]
}, Open]],

Cell[CellGroupData[{
Cell["8. Read the outputs", "Section"],

Cell["experiment_manifest.csv records the settings for each scheduled fit. metrics_best.csv and metrics_final.csv contain physical-weight MAPE and RMSE alongside the loss in training-target space. run_index.csv connects those rows to the saved network, predictions and loss histories. splits/ contains the exact row assignments. failures.csv must be checked before treating a study as complete. Notebook 3 loads these files and generates comparisons and manuscript tables.", "Text"],

Cell["Changing the architecture, epoch budget, target transform or data defines a new fit. Keep the default study as one documented comparison and exploratory changes as separately named experiments. Mean errors across seeds should always be accompanied by the number of completed seeds and a measure of variation.", "Text"]
}, Open]]
},
 WindowSize -> {1100, 850}, WindowMargins -> {{Automatic, Automatic}, {Automatic, Automatic}},
 WindowTitle -> "Training and additional validation",
 CellContext -> Notebook, ShowCellBracket -> True, Magnification -> 1.,
 TaggingRules -> <|"Bundle" -> "ModularFormsNotebooks", "NotebookNumber" -> 2|>,
 StyleDefinitions -> Notebook[{
 Cell[StyleData[StyleDefinitions -> "Default.nb"]],
 Cell[StyleData["Title"], FontFamily -> "Helvetica", FontSize -> 28,
  FontWeight -> "Plain", FontColor -> RGBColor[0.16, 0.23, 0.31], CellMargins -> {{36, 24}, {12, 28}}],
 Cell[StyleData["Subtitle"], FontFamily -> "Helvetica", FontSize -> 14,
  FontColor -> GrayLevel[0.4], CellMargins -> {{36, 24}, {18, 0}}],
 Cell[StyleData["Section"], FontFamily -> "Helvetica", FontSize -> 21,
  FontColor -> RGBColor[0.16, 0.23, 0.31], CellMargins -> {{36, 24}, {10, 24}}],
 Cell[StyleData["Subsection"], FontFamily -> "Helvetica", FontSize -> 16,
  FontColor -> GrayLevel[0.22], CellMargins -> {{36, 24}, {8, 18}}],
 Cell[StyleData["Text"], FontFamily -> "Helvetica", FontSize -> 13,
  LineSpacing -> {1.15, 2}, CellMargins -> {{36, 30}, {9, 7}}],
 Cell[StyleData["Input"], FontSize -> 12, CellMargins -> {{54, 24}, {9, 9}}],
 Cell[StyleData["Output"], FontSize -> 12, CellMargins -> {{54, 24}, {9, 5}}]
 }, Visible -> False]]
