Cell[CellGroupData[{

Cell["2. Expansion variables and target weights", "Section",ExpressionUUID->"06278556-ba7e-4591-8110-b8bf866c5699"],

Cell["\<\
Throughout this notebook q = exp(2 pi i tau). A coefficient vector represents \
the regular series after removing its leading q power. If F(q) = q^lambda (a0 \
+ a1 q + ...), the vector contains a0, a1, ... and lambda is stored \
separately. Exact zeros remain in their original positions. In the Jacobi \
notebook the theta nome is Q = exp(pi i tau), so q = Q^2.\
\>", "Text",ExpressionUUID->"eda29639-cb10-4f22-a192-1b1f6910186c"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<Family\>\"", ",", " ", "\"\<Function\>\"", ",", 
       " ", "\"\<Leading q power\>\"", ",", " ", "\"\<Weight target\>\""}], 
      "}"}], ",", "\n", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Eta\>\"", ",", " ", 
       RowBox[{"HoldForm", "[", 
        RowBox[{
         RowBox[{"DedekindEta", "[", "tau", "]"}], "^", "r"}], "]"}], ",", 
       " ", 
       RowBox[{"r", "/", "24"}], ",", " ", 
       RowBox[{"r", "/", "2"}]}], "}"}], ",", "\n", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<CHL\>\"", ",", " ", 
       RowBox[{"HoldForm", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"DedekindEta", "[", "tau", "]"}], " ", 
           RowBox[{"DedekindEta", "[", 
            RowBox[{"n", " ", "tau"}], "]"}]}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{"24", " ", 
           RowBox[{"s", "/", 
            RowBox[{"(", 
             RowBox[{"n", " ", "+", " ", "1"}], ")"}]}]}], ")"}]}], "]"}], ",",
        " ", "s", ",", " ", 
       RowBox[{"24", " ", 
        RowBox[{"s", "/", 
         RowBox[{"(", 
          RowBox[{"n", " ", "+", " ", "1"}], ")"}]}]}]}], "}"}], ",", "\n", 
     " ", 
     RowBox[{"{", 
      RowBox[{"\"\<E2 eta\>\"", ",", " ", 
       RowBox[{"HoldForm", "[", 
        RowBox[{"2", " ", 
         RowBox[{"e2", "[", "tau", "]"}], " ", 
         RowBox[{
          RowBox[{"DedekindEta", "[", "tau", "]"}], "^", 
          RowBox[{"(", 
           RowBox[{"2", " ", "w"}], ")"}]}]}], "]"}], ",", " ", 
       RowBox[{"w", "/", "12"}], ",", " ", 
       RowBox[{"w", " ", "+", " ", "2"}]}], "}"}], ",", "\n", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Positive integer E2 powers\>\"", ",", " ", 
       RowBox[{"HoldForm", "[", 
        RowBox[{
         RowBox[{"e2", "[", "tau", "]"}], "^", "p"}], "]"}], ",", " ", "0", ",",
        " ", 
       RowBox[{"2", " ", "p"}]}], "}"}]}], "\n", " ", "}"}], ",", " ", 
   RowBox[{"Alignment", " ", "->", " ", "Left"}], ",", " ", 
   RowBox[{"Dividers", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"{", 
       RowBox[{"False", ",", " ", "True"}], "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "1"}], "}"}]}]}], "]"}]], "Input",
 CellTags->"input-8",ExpressionUUID->"ddf59177-f50a-4adc-84e3-e44d70222a6c"],

Cell["\<\
For eta^(2 w), w is the weight and 2 w is the eta exponent. Thus integer eta \
exponents include half-integral weights. Eta powers carry their inherited \
multiplier; negative powers have poles at cusps. Rational powers require a \
branch convention and are not automatically ordinary scalar modular forms. \
The E2 examples are quasimodular; E2 times an eta power has the corresponding \
multiplier and cusp behaviour.\
\>", "Text",ExpressionUUID->"3c409327-f6b6-40ce-bab8-12f41d51e29b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Exact coefficients from a short recurrence", "Section",ExpressionUUID->"ce97df03-9110-44fe-bb67-8013be01fac8"],

Cell["\<\
The following definition is deliberately visible and editable. For a product \
of eta(d tau)^r, remove q^(Sum[d r]/24). Its logarithmic derivative gives n \
a_n = Sum[b_k a_(n-k), k=1..n], where b_k = -Sum[r d sigma_1(k/d), d divides \
k]. The shared generator implements this same recurrence with input checks. \
Use exact integers or rationals rather than decimal exponents. Editing \
etaProductExample changes this demonstration. GenerateRows uses the shared \
package definition; the custom-family section below shows how to train and \
export a formula defined directly in this notebook.\
\>", "Text",ExpressionUUID->"019f5163-0661-4883-b192-6f3899e4e679"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "etaProductExample", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"etaProductExample", "[", 
    RowBox[{
     RowBox[{"terms", "_", "List"}], ",", " ", 
     RowBox[{"count", "_", 
      RowBox[{"Integer", "?", "Positive"}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", " ", "count"}], "]"}]}], ",", " ", "b", ",", " ", 
       "n", ",", " ", "k"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"a", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", "1"}], ";", "\n", " ", 
      
      RowBox[{"b", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Mod", "[", 
                  RowBox[{"k", ",", " ", 
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "]"}], " ", "==", " ", 
                 "0"}], ",", "\n", "       ", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], " ", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], " ", 
                 RowBox[{"DivisorSigma", "[", 
                  RowBox[{"1", ",", " ", 
                   RowBox[{"k", "/", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}]}], ",", " ", 
                "0"}], "]"}], " ", "&"}], ")"}], " ", "/@", " ", "terms"}], 
           "]"}]}], ",", "\n", "    ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "1", ",", " ", 
           RowBox[{"count", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"a", "[", 
          RowBox[{"[", 
           RowBox[{"n", " ", "+", " ", "1"}], "]"}], "]"}], " ", "=", " ", 
         RowBox[{"Together", "[", 
          RowBox[{
           RowBox[{"Sum", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"b", "[", 
               RowBox[{"[", "k", "]"}], "]"}], " ", 
              RowBox[{"a", "[", 
               RowBox[{"[", 
                RowBox[{"n", " ", "-", " ", "k", " ", "+", " ", "1"}], "]"}], 
               "]"}]}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"k", ",", " ", "1", ",", " ", "n"}], "}"}]}], "]"}], "/",
            "n"}], "]"}]}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "1", ",", " ", 
          RowBox[{"count", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ";", "\n", 
      " ", "a"}]}], "\n", " ", "]"}]}], ";"}], "\n", 
 RowBox[{"etaProductExample", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "24"}], "}"}], "}"}], ",", " ", "8"}], 
  "]"}]}], "Input",
 CellTags->"input-12",ExpressionUUID->"dbd1b3a4-1f93-4bbd-aef5-1da7ada82abf"],

Cell["\<\
The preceding example is Delta/q. Its first coefficients are {1, -24, 252, \
-1472, 4830, -6048, -16744, 84480}. These can be checked without any \
numerical training.\
\>", "Text",ExpressionUUID->"b4cb8840-9083-419e-8b2c-22609ecb4fcb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"coefficientChecks", " ", "=", " ", 
   RowBox[{"TestReport", "[", 
    RowBox[{"{", "\n", " ", 
     RowBox[{
      RowBox[{"VerificationTest", "[", 
       RowBox[{
        RowBox[{"etaProductExample", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "24"}], "}"}], "}"}], ",", " ", "8"}], 
         "]"}], ",", "\n", "   ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"-", "24"}], ",", " ", "252", ",", " ", 
          RowBox[{"-", "1472"}], ",", " ", "4830", ",", " ", 
          RowBox[{"-", "6048"}], ",", " ", 
          RowBox[{"-", "16744"}], ",", " ", "84480"}], "}"}], ",", " ", 
        RowBox[{"TestID", " ", "->", " ", "\"\<Delta coefficients\>\""}]}], 
       "]"}], ",", "\n", " ", 
      RowBox[{"VerificationTest", "[", 
       RowBox[{
        RowBox[{"etaProductExample", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{"1", ",", " ", 
             RowBox[{"-", "1"}]}], "}"}], "}"}], ",", " ", "8"}], "]"}], ",", 
        "\n", "   ", 
        RowBox[{"{", 
         RowBox[{
         "1", ",", " ", "1", ",", " ", "2", ",", " ", "3", ",", " ", "5", ",",
           " ", "7", ",", " ", "11", ",", " ", "15"}], "}"}], ",", " ", 
        RowBox[{
        "TestID", " ", "->", " ", "\"\<Partition coefficients\>\""}]}], "]"}],
       ",", "\n", " ", 
      RowBox[{"VerificationTest", "[", 
       RowBox[{
        RowBox[{"etaProductExample", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "6"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"3", ",", " ", "6"}], "}"}]}], "}"}], ",", " ", "12"}], 
         "]"}], ",", "\n", "   ", 
        RowBox[{"ValidationData`EtaProductCoefficients", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "6"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"3", ",", " ", "6"}], "}"}]}], "}"}], ",", " ", "12"}], 
         "]"}], ",", "\n", "   ", 
        RowBox[{
        "TestID", " ", "->", " ", "\"\<CHL recurrence agreement\>\""}]}], 
       "]"}]}], "\n", " ", "}"}], "]"}]}], 
  ";"}], "\n", "coefficientChecks"}], "Input",
 CellTags->"input-14",ExpressionUUID->"b2bc43d4-33ae-45d0-973b-2bb40e11ec46"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4. Eta: choose weights and generate examples", "Section",ExpressionUUID->"b44c1537-91e2-48d7-a7df-ed75eb1fcc37"],

Cell["\<\
Edit etaWeights and coefficientCount here. The generator expects eta \
exponents, so the conversion Powers -> 2 etaWeights is explicit. This example \
spans both signs; the recorded eta-negative study uses weights -1/2, -1, ..., \
-200.\
\>", "Text",ExpressionUUID->"b1a95a62-476f-454b-be08-8a99645694c9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"etaWeights", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "3"}], "/", "2"}], ",", " ", 
     RowBox[{"-", "1"}], ",", " ", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}], ",", " ", 
     RowBox[{"1", "/", "2"}], ",", " ", "1", ",", " ", 
     RowBox[{"3", "/", "2"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"coefficientCount", " ", "=", " ", "30"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"etaSpec", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Family\>\"", " ", "->", " ", "\"\<Eta\>\""}], ",", " ", 
     RowBox[{"\"\<Powers\>\"", " ", "->", " ", 
      RowBox[{"2", " ", "etaWeights"}]}], ",", "\n", "  ", 
     RowBox[{"\"\<CoefficientCount\>\"", " ", "->", " ", 
      "coefficientCount"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"etaRows", " ", "=", " ", 
   RowBox[{"ValidationData`GenerateRows", "[", 
    RowBox[{"\"\<eta_examples\>\"", ",", " ", "etaSpec"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<ID\>\"", " ", "->", " ", 
        RowBox[{"#", "[", "\"\<ID\>\"", "]"}]}], ",", " ", 
       RowBox[{"\"\<Eta exponent\>\"", " ", "->", " ", 
        RowBox[{"#", "[", "\"\<Power\>\"", "]"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<Weight\>\"", " ", "->", " ", 
        RowBox[{"#", "[", "\"\<Target\>\"", "]"}]}], ",", " ", 
       RowBox[{"\"\<Leading q power\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"#", "[", "\"\<Metadata\>\"", "]"}], 
         "[", "\"\<LeadingQPower\>\"", "]"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<First six coefficients\>\"", " ", "->", " ", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"#", "[", "\"\<Coefficients\>\"", "]"}], ",", " ", "6"}], 
         "]"}]}]}], "|>"}], " ", "&"}], ")"}], " ", "/@", " ", "etaRows"}], 
  "]"}]}], "Input",
 CellTags->"input-17",ExpressionUUID->"e6dbf842-c496-48e8-b158-e75196943314"],

Cell[CellGroupData[{

Cell["An analytic reference prediction", "Subsection",ExpressionUUID->"973cd8ae-fcf2-4e71-a281-47f053f3f715"],

Cell["\<\
For the unit-leading eta series, a1/a0 = -r. Hence its weight is exactly \
-a1/(2 a0). This identity is useful for checking data and labels. It uses the \
first two coefficients; it is not an equal-input comparison with an \
experiment that deliberately omits either of them.\
\>", "Text",ExpressionUUID->"48576294-ced8-4deb-bab8-ad84b00f955c"],

Cell[BoxData[
 RowBox[{"Dataset", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Weight\>\"", " ", "->", " ", 
        RowBox[{"#", "[", "\"\<Target\>\"", "]"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<Coefficient-ratio prediction\>\"", " ", "->", " ", 
        RowBox[{"ValidationData`ExactBaseline", "[", "#", "]"}]}], ",", "\n", 
       "  ", 
       RowBox[{"\"\<Exact agreement\>\"", " ", "->", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"ValidationData`ExactBaseline", "[", "#", "]"}], " ", "===",
           " ", 
          RowBox[{"#", "[", "\"\<Target\>\"", "]"}]}], ")"}]}]}], "|>"}], " ",
      "&"}], ")"}], " ", "/@", " ", "etaRows"}], "]"}]], "Input",
 CellTags->"input-20",ExpressionUUID->"129da50d-a369-465f-ab82-15168f93010d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["5. CHL eta products", "Section",ExpressionUUID->"0675426e-3d56-466a-a4e0-a38e24d3515d"],

Cell["\<\
For N = 1, 2, 3, 5, 7, let c_N = 24/(N+1) and f_N = (eta(tau) eta(N \
tau))^c_N. This is the repository convention k(N)+2 = c_N. The series of \
f_N^s begins with q^s, and its weight target is c_N s. At N=1 the two eta \
factors coincide; both must contribute to the coefficient recurrence.\
\>", "Text",ExpressionUUID->"29967ee5-8fd8-48b7-ba53-3046fe88f50c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"chlLevel", " ", "=", " ", "3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"chlPowers", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "3"}], ",", " ", 
     RowBox[{"-", "2"}], ",", " ", 
     RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "2", ",", " ", "3"}], 
    "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"chlSpec", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Family\>\"", " ", "->", " ", "\"\<CHL\>\""}], ",", " ", 
     RowBox[{"\"\<Level\>\"", " ", "->", " ", "chlLevel"}], ",", "\n", "  ", 
     RowBox[{"\"\<Powers\>\"", " ", "->", " ", "chlPowers"}], ",", " ", 
     RowBox[{"\"\<CoefficientCount\>\"", " ", "->", " ", "30"}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"chlRows", " ", "=", " ", 
   RowBox[{"ValidationData`GenerateRows", "[", 
    RowBox[{"\"\<chl_examples\>\"", ",", " ", "chlSpec"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Power\>\"", " ", "->", " ", 
        RowBox[{"#", "[", "\"\<Power\>\"", "]"}]}], ",", " ", 
       RowBox[{"\"\<Weight\>\"", " ", "->", " ", 
        RowBox[{"#", "[", "\"\<Target\>\"", "]"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<Leading q power\>\"", " ", "->", " ", 
        RowBox[{
         RowBox[{"#", "[", "\"\<Metadata\>\"", "]"}], 
         "[", "\"\<LeadingQPower\>\"", "]"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<First six coefficients\>\"", " ", "->", " ", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"#", "[", "\"\<Coefficients\>\"", "]"}], ",", " ", "6"}], 
         "]"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<Analytic weight\>\"", " ", "->", " ", 
        RowBox[{"ValidationData`ExactBaseline", "[", "#", "]"}]}]}], "|>"}], 
     " ", "&"}], ")"}], " ", "/@", " ", "chlRows"}], "]"}]}], "Input",
 CellTags->"input-23",ExpressionUUID->"62798f1b-1f7b-483c-bc1c-8c02154e4bac"],

Cell["\<\
The completed integer CHL training presets retain powers of magnitude 2 \
through 1000, following the rows selected for those fits. The full \
coefficient generators can also include power 1, as the small example does. \
The stored rational lists are bundled separately; reusing them retains their \
exact values and order.\
\>", "Text",ExpressionUUID->"301b91cc-194d-4db2-a28a-1e33c5331310"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"datasetPresets", " ", "=", " ", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "supportDir", ",", " ", "\"\<config\>\"", ",", 
        " ", "\"\<datasets.json\>\""}], "}"}], "]"}], ",", 
     " ", "\"\<RawJSON\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rationalSpec", " ", "=", " ", 
   RowBox[{"ValidationData`ResolveDatasetSpec", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"datasetPresets", "[", "\"\<chl_N3_positive_rational\>\"", "]"}],
      ",", " ", "supportDir"}], "]"}]}], ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<Number of powers\>\"", " ", "->", " ", 
    RowBox[{"Length", "[", 
     RowBox[{"rationalSpec", "[", "\"\<Powers\>\"", "]"}], "]"}]}], ",", "\n",
    "  ", 
   RowBox[{"\"\<First five exact powers\>\"", " ", "->", " ", 
    RowBox[{"Take", "[", 
     RowBox[{
      RowBox[{"rationalSpec", "[", "\"\<Powers\>\"", "]"}], ",", " ", "5"}], 
     "]"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Number of distinct powers\>\"", " ", "->", " ", 
    RowBox[{"Length", "[", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"rationalSpec", "[", "\"\<Powers\>\"", "]"}], "]"}], "]"}]}]}], 
  "|>"}]}], "Input",
 CellTags->"input-25",ExpressionUUID->"38f48ed0-17b8-4300-8f74-00d5f240276d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. E2 examples and positive eta powers", "Section",ExpressionUUID->"5b0ea8ff-7309-43c7-8d9e-89b3798bdc3d"],

Cell["\<\
The repository family used here is 2 E2 eta^(2 w), with E2(q) = 1 - 24 \
Sum[sigma_1(n) q^n]. It is distinct from E2^p. The former has total weight \
w+2; the latter has weight 2p for positive integer p. The optional E2 study \
uses the first family. Its results are separate from the bundled 174 \
completed fits.\
\>", "Text",ExpressionUUID->"f5e235b6-359c-463c-8b86-58c74d80c54c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"e2EtaWeights", " ", "=", " ", 
   RowBox[{
    RowBox[{"Range", "[", 
     RowBox[{"1", ",", " ", "12"}], "]"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"e2Spec", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Family\>\"", " ", "->", " ", "\"\<E2Eta\>\""}], ",", " ", 
     RowBox[{"\"\<Powers\>\"", " ", "->", " ", "e2EtaWeights"}], ",", "\n", 
     "  ", 
     RowBox[{"\"\<CoefficientCount\>\"", " ", "->", " ", "30"}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"e2Rows", " ", "=", " ", 
   RowBox[{"ValidationData`GenerateRows", "[", 
    RowBox[{"\"\<e2eta_examples\>\"", ",", " ", "e2Spec"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"e2PowerRows", " ", "=", " ", 
   RowBox[{"ValidationData`GenerateRows", "[", 
    RowBox[{"\"\<e2power_examples\>\"", ",", "\n", "  ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Family\>\"", " ", "->", " ", "\"\<E2Power\>\""}], ",", 
       " ", 
       RowBox[{"\"\<Powers\>\"", " ", "->", " ", 
        RowBox[{"Range", "[", 
         RowBox[{"1", ",", " ", "6"}], "]"}]}], ",", " ", 
       RowBox[{"\"\<CoefficientCount\>\"", " ", "->", " ", "30"}]}], "|>"}]}],
     "]"}]}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Eta weight w\>\"", " ", "->", " ", 
        RowBox[{"#", "[", "\"\<Power\>\"", "]"}]}], ",", " ", 
       RowBox[{"\"\<Total weight\>\"", " ", "->", " ", 
        RowBox[{"#", "[", "\"\<Target\>\"", "]"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<First four coefficients\>\"", " ", "->", " ", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"#", "[", "\"\<Coefficients\>\"", "]"}], ",", " ", "4"}], 
         "]"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<Analytic total weight\>\"", " ", "->", " ", 
        RowBox[{"ValidationData`ExactBaseline", "[", "#", "]"}]}]}], "|>"}], 
     " ", "&"}], ")"}], " ", "/@", " ", "e2Rows"}], "]"}]}], "Input",
 CellTags->"input-28",ExpressionUUID->"1c269ca9-9496-4b32-ae20-4e4cdcfd9109"],

Cell["\<\
For 2 E2 eta^(2 w), a0 = 2 and a1/a0 = -24 - 2w, so the total weight is \
-a1/(2a0) - 10. Keeping the signs and reducing coefficient dynamic range \
gives an alternative representation to test. This changes the input \
representation and should be treated as a separate experiment; it does not \
establish a performance improvement before training.\
\>", "Text",ExpressionUUID->"2cba7421-ee10-4c51-b9b3-c02e99477d07"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"positiveEtaRows", " ", "=", " ", 
   RowBox[{"ValidationData`GenerateRows", "[", 
    RowBox[{"\"\<eta_positive_preview\>\"", ",", "\n", "  ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Family\>\"", " ", "->", " ", "\"\<Eta\>\""}], ",", " ", 
       RowBox[{"\"\<Powers\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "10", ",", " ", "100", ",", " ", "400"}], 
         "}"}]}], ",", " ", 
       RowBox[{"\"\<CoefficientCount\>\"", " ", "->", " ", "30"}]}], "|>"}]}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rawPreview", " ", "=", " ", 
   RowBox[{"Lookup", "[", 
    RowBox[{"positiveEtaRows", ",", " ", "\"\<Coefficients\>\""}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"l2Preview", " ", "=", " ", 
   RowBox[{"UnifiedTraining`TransformInputs", "[", 
    RowBox[{"rawPreview", ",", " ", "\"\<L2\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"signedLogPreview", " ", "=", " ", 
   RowBox[{"UnifiedTraining`TransformInputs", "[", 
    RowBox[{"rawPreview", ",", " ", "\"\<SignedLogStandardized\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{"MapThread", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Weight\>\"", " ", "->", " ", 
        RowBox[{"#", "1"}]}], ",", " ", 
       RowBox[{"\"\<First two L2 features\>\"", " ", "->", " ", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"#", "2"}], ",", " ", "2"}], "]"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<First two signed-log features before standardization\>\"",
         " ", "->", " ", 
        RowBox[{"Take", "[", 
         RowBox[{
          RowBox[{"#", "3"}], ",", " ", "2"}], "]"}]}]}], "|>"}], " ", "&"}], 
    ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Lookup", "[", 
       RowBox[{"positiveEtaRows", ",", " ", "\"\<Target\>\""}], "]"}], ",", 
      " ", "l2Preview", ",", " ", "signedLogPreview"}], "}"}]}], "]"}], 
  "]"}]}], "Input",
 CellTags->"input-30",ExpressionUUID->"ab4fe4cb-3784-4e68-9bed-456994c7a846"],

Cell["\<\
The signed-log values above are sign(a_n/a0) log(1+|a_n/a0|). Coordinate \
means and standard deviations are fitted later using training rows only. L2 \
normalization preserves the exact coefficient ratio, but may make its \
individual entries very small. Log-magnitude preprocessing discards signs; \
its treatment of zero coefficients is recorded in the training settings.\
\>", "Text",ExpressionUUID->"bbc6cfcd-061f-4322-99ad-6000546f8e00"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Retained coefficients and dataset export", "Section",ExpressionUUID->"b82405b8-e645-40f4-ba76-ddf878faf146"],

Cell["\<\
Positions in a dataset specification are zero-based q degrees. \
FeaturePositions in the training notebook are one-based positions in the \
stored coefficient vector. A single selected set is shared by all rows. Keep \
this distinction when experimenting with missing coefficients.\
\>", "Text",ExpressionUUID->"8b4d5122-5bf4-4e47-9e41-eb1510d99686"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"slicePositions", " ", "=", " ", 
   RowBox[{"BlockRandom", "[", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "31415", "]"}], ";", " ", 
     RowBox[{"Sort", "[", 
      RowBox[{"RandomSample", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", "29"}], "]"}], ",", " ", "15"}], "]"}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"slicedSpec", " ", "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{"chlSpec", ",", " ", 
     RowBox[{"<|", 
      RowBox[{"\"\<Positions\>\"", " ", "->", " ", "slicePositions"}], 
      "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"slicedRows", " ", "=", " ", 
   RowBox[{"ValidationData`GenerateRows", "[", 
    RowBox[{"\"\<chl_slice_example\>\"", ",", " ", "slicedSpec"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"<|", 
  RowBox[{
   RowBox[{"\"\<Retained q degrees\>\"", " ", "->", " ", 
    RowBox[{
     RowBox[{"slicedRows", "[", 
      RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<Positions\>\"", "]"}]}], ",", 
   "\n", "  ", 
   RowBox[{"\"\<Vector length\>\"", " ", "->", " ", 
    RowBox[{"Length", "[", 
     RowBox[{
      RowBox[{"slicedRows", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<Coefficients\>\"", "]"}], 
     "]"}]}]}], "|>"}]}], "Input",
 CellTags->"input-34",ExpressionUUID->"8da2c0ca-318c-4d68-9738-856f637ab52d"],

Cell["\<\
To save a dataset, set exportData to True and evaluate the next cell. \
GetDataset writes an exact WXF cache plus coefficient and metadata CSVs. The \
file identity incorporates the exact specification and generator source. It \
reloads a matching dataset instead of regenerating it. No dataset is exported \
by default.\
\>", "Text",ExpressionUUID->"90fceea3-7e67-46f0-9d80-6efa415ed20c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"exportData", " ", "=", " ", "False"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"datasetToExport", " ", "=", " ", "\"\<eta_examples\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"specToExport", " ", "=", " ", "etaSpec"}], ";"}], "\n", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"TrueQ", "[", "exportData", "]"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"exportedDataset", " ", "=", " ", 
     RowBox[{"ValidationData`GetDataset", "[", 
      RowBox[{
      "datasetToExport", ",", " ", "specToExport", ",", "\n", "   ", 
       "supportDir", ",", " ", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"outputRoot", ",", " ", "\"\<data\>\""}], "}"}], "]"}]}], 
      "]"}]}], ";", "\n", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"FailureQ", "[", "exportedDataset", "]"}], ",", " ", 
      "exportedDataset", ",", " ", 
      RowBox[{"exportedDataset", "[", "\"\<Files\>\"", "]"}]}], "]"}]}], ",", 
   "\n", " ", "\"\<Set exportData = True to save this dataset.\>\""}], "\n", 
  " ", "]"}]}], "Input",
 CellTags->"input-36",ExpressionUUID->"9944473a-4de1-4f81-a4e7-7f4db6eb8568"]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Add another exact family", "Section",ExpressionUUID->"399de724-bf20-48cb-ba8a-2d44c8d6382f"],

Cell["\<\
The row association is the interface to the training notebook. Supply a \
unique ID, a Group shared by related examples, an explicit Target, \
coefficient values and their positions. For a custom family use \
StandardizedWeight, which reads Target directly. The following example \
multiplies E4 by eta^(2w). Editing only the displayed formula above does not \
change a generator: edit the coefficient definition and the target together.\
\>", "Text",ExpressionUUID->"8b1d8ca5-4ad9-4690-bab6-7a88a8fcea29"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "e4EtaRow", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"e4EtaRow", "[", 
    RowBox[{
     RowBox[{"w", "_"}], ",", " ", 
     RowBox[{"count", "_", 
      RowBox[{"Integer", "?", "Positive"}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"eta", ",", " ", "e4", ",", " ", "c"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"eta", " ", "=", " ", 
       RowBox[{"ValidationData`EtaProductCoefficients", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", 
            RowBox[{"2", " ", "w"}]}], "}"}], "}"}], ",", " ", "count"}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"e4", " ", "=", " ", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"240", " ", 
            RowBox[{"DivisorSigma", "[", 
             RowBox[{"3", ",", " ", "n"}], "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"n", ",", " ", "1", ",", " ", 
             RowBox[{"count", " ", "-", " ", "1"}]}], "}"}]}], "]"}], ",", 
         " ", "1"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"e4", "[", 
             RowBox[{"[", 
              RowBox[{"j", " ", "+", " ", "1"}], "]"}], "]"}], " ", 
            RowBox[{"eta", "[", 
             RowBox[{"[", 
              RowBox[{"n", " ", "-", " ", "j", " ", "+", " ", "1"}], "]"}], 
             "]"}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "0", ",", " ", "n"}], "}"}]}], "]"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "0", ",", " ", 
           RowBox[{"count", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<ID\>\"", " ", "->", " ", 
         RowBox[{"\"\<e4eta-\>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"w", ",", " ", "InputForm"}], "]"}]}]}], ",", "\n", "   ", 
        
        RowBox[{"\"\<Group\>\"", " ", "->", " ", 
         RowBox[{"\"\<e4eta-parent-\>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"w", ",", " ", "InputForm"}], "]"}]}]}], ",", "\n", "   ", 
        
        RowBox[{"\"\<Family\>\"", " ", "->", " ", "\"\<E4Eta\>\""}], ",", " ", 
        RowBox[{"\"\<Power\>\"", " ", "->", " ", "w"}], ",", " ", 
        RowBox[{"\"\<Target\>\"", " ", "->", " ", 
         RowBox[{"w", " ", "+", " ", "4"}]}], ",", "\n", "   ", 
        RowBox[{"\"\<Coefficients\>\"", " ", "->", " ", "c"}], ",", " ", 
        RowBox[{"\"\<Positions\>\"", " ", "->", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"count", " ", "-", " ", "1"}]}], "]"}]}], ",", "\n", "   ", 
        RowBox[{"\"\<Metadata\>\"", " ", "->", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<LeadingQPower\>\"", " ", "->", " ", 
            RowBox[{"w", "/", "12"}]}], ",", " ", 
           
           RowBox[{"\"\<TargetDefinition\>\"", " ", "->", 
            " ", "\"\<eta weight + 4\>\""}]}], "|>"}]}]}], "|>"}]}]}], "\n", 
    " ", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"customRows", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"e4EtaRow", "[", 
      RowBox[{"#", ",", " ", "30"}], "]"}], " ", "&"}], " ", "/@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"1", ",", " ", "80"}], "]"}], "/", "2"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"KeyTake", "[", 
     RowBox[{"#", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<ID\>\"", ",", " ", "\"\<Group\>\"", ",", 
        " ", "\"\<Target\>\""}], "}"}]}], "]"}], " ", "&"}], " ", "/@", " ", 
   RowBox[{"Take", "[", 
    RowBox[{"customRows", ",", " ", "5"}], "]"}]}], "]"}]}], "Input",
 CellTags->"input-39",ExpressionUUID->"8f03cd1c-0a9e-4175-a54f-1a41c6c75b3d"],

Cell["\<\
Eighty distinct parent groups are supplied here so a train/validation/test \
split is possible. To use these rows in notebook 2, save them with the \
optional cell below and follow its custom-data section. If several rows come \
from the same parent form, give them the same Group. Changing the coefficient \
definition or target creates a new experiment.\
\>", "Text",ExpressionUUID->"7c3c6219-eaa2-4ca0-9f85-58308af2ee7f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"exportCustomRows", " ", "=", " ", "False"}], ";"}], "\n", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"TrueQ", "[", "exportCustomRows", "]"}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"customDirectory", " ", "=", " ", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{"outputRoot", ",", " ", "\"\<data\>\""}], "}"}], "]"}]}], ";", 
    "\n", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"DirectoryQ", "[", "customDirectory", "]"}]}], ",", " ", 
      RowBox[{"CreateDirectory", "[", 
       RowBox[{"customDirectory", ",", " ", 
        RowBox[{"CreateIntermediateDirectories", " ", "->", " ", "True"}]}], 
       "]"}]}], "]"}], ";", "\n", " ", 
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"customDirectory", ",", " ", "\"\<custom_rows.wxf\>\""}], 
        "}"}], "]"}], ",", " ", "customRows", ",", " ", "\"\<WXF\>\""}], 
     "]"}]}], ",", "\n", 
   " ", "\"\<Set exportCustomRows = True to save custom_rows.wxf.\>\""}], 
  "\n", " ", "]"}]}], "Input",
 CellTags->"input-41",ExpressionUUID->"e8fd0cc7-9aca-484b-bc8c-15e612c88d5b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Reference and next step", "Section",ExpressionUUID->"7b4573a7-8de2-4a13-8979-37223db43247"],

Cell["\<\
Repository: https://github.com/abinash7s/ml_modular_forms (source snapshot \
3159005815d40e6542432e2d7969f980f56e9f01). Wolfram function conventions: \
https://reference.wolfram.com/language/ref/DedekindEta.html and \
https://reference.wolfram.com/language/ref/EllipticTheta.html. Continue with \
notebook 2 to train an example, or notebook 3 to inspect completed results. \
Notebook 4 treats theta products and Jacobi coefficients separately.\
\>", "Text",ExpressionUUID->"de6b8ba5-83ce-429a-a11a-f3eec531ff99"]
}, Open  ]]
}, Open  ]]
},
