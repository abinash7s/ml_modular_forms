(* Content-type: application/vnd.wolfram.mathematica *)
(* Plain Mathematica notebook; input cells contain editable Wolfram Language. *)
Notebook[{
Cell["Results and manuscript tables", "Title"],

Cell["Machine learning automorphic forms\nAdditional validation and CHL experiments", "Subtitle"],

Cell["This notebook reads completed experiments, displays their settings, compares architectures and optimizers, and writes manuscript-ready tables. The supplied example_results directory contains the recorded 174-fit study. No network training, Python installation, or trained-model cache is needed to inspect these summaries. Evaluate the sections in order in a fresh kernel.", "Text"],

Cell[CellGroupData[{
Cell["1. Choose the results", "Section"],

Cell["Change resultsDirectory to inspect a new output directory, or set useGeneratedResults = True to read the latest study saved by notebook 02. Best means the checkpoint minimizing validation loss within each fit; Final means the last training round. These are two checkpoints of the same fit, not two independent repetitions. File export is disabled until explicitly enabled below.", "Text"],

Cell[BoxData[RowBox[{"$HistoryLength", " ", "=", " ", "5", ";", "\n", "baseDir", " ", "=", " ", "ParentDirectory", "[", "NotebookDirectory", "[", "]", "]", ";", "\n", "resultsDirectory", " ", "=", " ", "FileNameJoin", "[", "{", "baseDir", ",", " ", "\"example_results\"", "}", "]", ";", "\n", "useGeneratedResults", " ", "=", " ", "False", ";", "\n", "If", "[", "TrueQ", "[", "useGeneratedResults", "]", ",", "\n", "  ", "latestMarker", " ", "=", " ", "FileNameJoin", "[", "{", "baseDir", ",", " ", "\"generated\"", ",", " ", "\"LATEST_STUDY.txt\"", "}", "]", ";", "\n", "  ", "If", "[", "FileExistsQ", "[", "latestMarker", "]", ",", " ", "resultsDirectory", " ", "=", " ", "StringTrim", "[", "Import", "[", "latestMarker", ",", " ", "\"Text\"", "]", "]", ",", "\n", "    ", "Print", "[", "\"No generated study marker exists. Run a study in notebook 02 first.\"", "]", ";", " ", "Abort", "[", "]", "]", "]", ";", "\n", "checkpoint", " ", "=", " ", "\"Best\"", ";", "                         ", "(* \"Best\" or \"Final\" *)", "\n", "expectedSeeds", " ", "=", " ", "{", "101", ",", " ", "102", ",", " ", "103", "}", ";", "             ", "(* Edit for a different study. *)", "\n", "exportReports", " ", "=", " ", "False", ";", "\n", "outputDirectory", " ", "=", " ", "FileNameJoin", "[", "{", "baseDir", ",", " ", "\"generated\"", ",", " ", "\"reports\"", "}", "]", ";"}]], "Input" , CellTags -> "input-5"],

Cell["Read numerical fields without evaluating imported text", "Subsection"],

Cell["CSV files are interpreted as data. The parser accepts decimal and scientific notation, including Wolfram notation such as 1.2*^-5. Fields containing lists, paths or method options remain strings; they are never evaluated as Wolfram code.", "Text"],

Cell[BoxData[RowBox[{"ClearAll", "[", "readNumber", ",", " ", "readRows", "]", ";", "\n", "readNumber", "[", "x", "_", "?", "NumberQ", "]", " ", ":=", " ", "x", ";", "\n", "readNumber", "[", "x", "_", "String", "]", " ", ":=", " ", "Module", "[", "{", "s", " ", "=", " ", "StringTrim", "[", "x", "]", ",", " ", "pieces", ",", " ", "mantissa", ",", " ", "exponent", ",", "\n", "    ", "sign", ",", " ", "digits", ",", " ", "afterPoint", "}", ",", "\n", "  ", "s", " ", "=", " ", "StringReplace", "[", "s", ",", " ", "RegularExpression", "[", "\"`[0-9.]*\"", "]", " ", "->", " ", "\"\"", "]", ";", "\n", "  ", "If", "[", "!", "StringMatchQ", "[", "s", ",", " ", "RegularExpression", "[", "\n", "      ", "\"[+-]?(?:[0-9]+(?:\\\\.[0-9]*)?|\\\\.[0-9]+)(?:(?:[eE]|\\\\*\\\\^)[+-]?[0-9]+)?\"", "]", "]", ",", "\n", "    ", "Return", "[", "Missing", "[", "\"NotNumeric\"", ",", " ", "x", "]", "]", "]", ";", "\n", "  ", "pieces", " ", "=", " ", "StringSplit", "[", "s", ",", " ", "RegularExpression", "[", "\"[eE]|\\\\*\\\\^\"", "]", "]", ";", "\n", "  ", "mantissa", " ", "=", " ", "First", "[", "pieces", "]", ";", "\n", "  ", "exponent", " ", "=", " ", "If", "[", "Length", "[", "pieces", "]", " ", "==", " ", "1", ",", " ", "0", ",", "\n", "    ", "With", "[", "{", "e", " ", "=", " ", "Last", "[", "pieces", "]", "}", ",", " ", "If", "[", "StringTake", "[", "e", ",", " ", "1", "]", " ", "===", " ", "\"-\"", ",", " ", "-", "1", ",", " ", "1", "]", " ", "*", "\n", "      ", "FromDigits", "[", "StringReplace", "[", "e", ",", " ", "{", "\"+\"", " ", "->", " ", "\"\"", ",", " ", "\"-\"", " ", "->", " ", "\"\"", "}", "]", "]", "]", "]", ";", "\n", "  ", "If", "[", "Abs", "[", "exponent", "]", " ", ">", " ", "10000", ",", " ", "Return", "[", "Missing", "[", "\"ExponentOutOfRange\"", ",", " ", "x", "]", "]", "]", ";", "\n", "  ", "sign", " ", "=", " ", "If", "[", "StringTake", "[", "mantissa", ",", " ", "1", "]", " ", "===", " ", "\"-\"", ",", " ", "-", "1", ",", " ", "1", "]", ";", "\n", "  ", "mantissa", " ", "=", " ", "StringReplace", "[", "mantissa", ",", " ", "{", "\"+\"", " ", "->", " ", "\"\"", ",", " ", "\"-\"", " ", "->", " ", "\"\"", "}", "]", ";", "\n", "  ", "afterPoint", " ", "=", " ", "If", "[", "StringContainsQ", "[", "mantissa", ",", " ", "\".\"", "]", ",", "\n", "    ", "StringLength", "[", "mantissa", "]", " ", "-", " ", "First", "[", "First", "[", "StringPosition", "[", "mantissa", ",", " ", "\".\"", "]", "]", "]", ",", " ", "0", "]", ";", "\n", "  ", "digits", " ", "=", " ", "FromDigits", "[", "StringReplace", "[", "mantissa", ",", " ", "\".\"", " ", "->", " ", "\"\"", "]", "]", ";", "\n", "  ", "If", "[", "afterPoint", " ", "==", " ", "0", " ", "&&", " ", "exponent", " ", ">=", " ", "0", ",", " ", "sign", " ", "digits", " ", "10", "^", "exponent", ",", "\n", "    ", "N", "[", "sign", " ", "digits", " ", "10", "^", "(", "exponent", " ", "-", " ", "afterPoint", ")", ",", " ", "16", "]", "]", "\n", "]", ";", "\n", "readNumber", "[", "x", "_", "]", " ", ":=", " ", "Missing", "[", "\"NotNumeric\"", ",", " ", "x", "]", ";", "\n", "\n", "numericFields", " ", "=", " ", "Join", "[", "\n", "  ", "{", "\"Seed\"", ",", " ", "\"Rounds\"", ",", " ", "\"WeightFactor\"", ",", " ", "\"PowerSign\"", ",", " ", "\"LearningRate\"", ",", " ", "\"InitializationSeed\"", ",", "\n", "   ", "\"TrainingSeed\"", ",", " ", "\"SplitSeed\"", ",", " ", "\"BatchSize\"", ",", " ", "\"Parameters\"", ",", " ", "\"TrainCount\"", ",", " ", "\"ValidationCount\"", ",", "\n", "   ", "\"TestCount\"", ",", " ", "\"Seconds\"", ",", " ", "\"BestValidationRound\"", ",", " ", "\"TotalRounds\"", ",", " ", "\"HiddenLayers\"", ",", " ", "\"Width\"", ",", "\n", "   ", "\"ParameterSampleRatio\"", ",", " ", "\"PaperTable\"", ",", " ", "\"Rows\"", ",", " ", "\"DistinctPowers\"", ",", " ", "\"DuplicatePowerCount\"", ",", "\n", "   ", "\"PowerMin\"", ",", " ", "\"PowerMax\"", ",", " ", "\"Count\"", ",", " ", "\"RMSE\"", ",", " ", "\"MAPE\"", "}", ",", "\n", "  ", "Flatten", "[", "Table", "[", "p", " ", "<>", " ", "m", ",", " ", "{", "p", ",", " ", "{", "\"Train\"", ",", " ", "\"Validation\"", ",", " ", "\"Test\"", "}", "}", ",", "\n", "    ", "{", "m", ",", " ", "{", "\"Loss\"", ",", " ", "\"RMSE\"", ",", " ", "\"MAE\"", ",", " ", "\"NRMSE\"", ",", " ", "\"MAPE\"", ",", " ", "\"MAPENonzero\"", ",", " ", "\"MAPEN\"", ",", "\n", "          ", "\"ZeroTargetCount\"", ",", " ", "\"NonfinitePredictionCount\"", "}", "}", "]", "]", "]", ";", "\n", "readRows", "[", "path", "_", "String", "]", " ", ":=", " ", "Module", "[", "{", "table", ",", " ", "headers", "}", ",", "\n", "  ", "If", "[", "!", "FileExistsQ", "[", "path", "]", ",", " ", "Return", "[", "Failure", "[", "\"MissingFile\"", ",", " ", "<|", "\"Path\"", " ", "->", " ", "path", "|>", "]", "]", "]", ";", "\n", "  ", "table", " ", "=", " ", "Import", "[", "path", ",", " ", "\"CSV\"", "]", ";", "\n", "  ", "If", "[", "table", " ", "===", " ", "{", "}", " ", "||", " ", "table", " ", "===", " ", "{", "{", "}", "}", ",", " ", "Return", "[", "{", "}", "]", "]", ";", "\n", "  ", "If", "[", "!", "ListQ", "[", "table", "]", " ", "||", " ", "!", "AllTrue", "[", "table", ",", " ", "ListQ", "]", ",", "\n", "    ", "Return", "[", "Failure", "[", "\"CSVFormat\"", ",", " ", "<|", "\"Path\"", " ", "->", " ", "path", "|>", "]", "]", "]", ";", "\n", "  ", "headers", " ", "=", " ", "ToString", " ", "/@", " ", "First", "[", "table", "]", ";", "\n", "  ", "If", "[", "!", "DuplicateFreeQ", "[", "headers", "]", " ", "||", " ", "!", "AllTrue", "[", "Rest", "[", "table", "]", ",", " ", "Length", "[", "#", "]", " ", "==", " ", "Length", "[", "headers", "]", " ", "&", "]", ",", "\n", "    ", "Return", "[", "Failure", "[", "\"CSVColumns\"", ",", " ", "<|", "\"Path\"", " ", "->", " ", "path", "|>", "]", "]", "]", ";", "\n", "  ", "Map", "[", "Function", "[", "row", ",", " ", "AssociationThread", "[", "headers", ",", "\n", "    ", "MapThread", "[", "If", "[", "MemberQ", "[", "numericFields", ",", " ", "#", "1", "]", ",", " ", "readNumber", "[", "#", "2", "]", ",", " ", "ToString", "[", "#", "2", "]", "]", " ", "&", ",", "\n", "      ", "{", "headers", ",", " ", "row", "}", "]", "]", "]", ",", " ", "Rest", "[", "table", "]", "]", "\n", "]", ";"}]], "Input" , CellTags -> "input-8", InitializationCell -> True],

Cell[BoxData[RowBox[{"manifest", " ", "=", " ", "readRows", "[", "FileNameJoin", "[", "{", "resultsDirectory", ",", " ", "\"experiment_manifest.csv\"", "}", "]", "]", ";", "\n", "metricsByCheckpoint", " ", "=", " ", "AssociationMap", "[", "\n", "  ", "readRows", "[", "FileNameJoin", "[", "{", "resultsDirectory", ",", " ", "\"metrics_\"", " ", "<>", " ", "ToLowerCase", "[", "#", "]", " ", "<>", " ", "\".csv\"", "}", "]", "]", " ", "&", ",", "\n", "  ", "{", "\"Best\"", ",", " ", "\"Final\"", "}", "]", ";", "\n", "If", "[", "FailureQ", "[", "manifest", "]", " ", "||", " ", "AnyTrue", "[", "Values", "[", "metricsByCheckpoint", "]", ",", " ", "FailureQ", "]", ",", "\n", "  ", "Print", "[", "\"Results could not be loaded. Check resultsDirectory and the required CSV files.\"", "]", ";", "\n", "  ", "Abort", "[", "]", "]", ";", "\n", "If", "[", "!", "MemberQ", "[", "{", "\"Best\"", ",", " ", "\"Final\"", "}", ",", " ", "checkpoint", "]", ",", " ", "Print", "[", "\"Choose Best or Final.\"", "]", ";", " ", "Abort", "[", "]", "]", ";", "\n", "metrics", " ", "=", " ", "metricsByCheckpoint", "[", "checkpoint", "]", ";"}]], "Input" , CellTags -> "input-9"],

Cell["Check the recorded runs", "Subsection"],

Cell["A run is identified by its experiment ID, seed and checkpoint, with a signature linking the model, predictions and curves. The following checks reject duplicate runs, inconsistent settings within a seed group, and missing planned runs. If you intentionally analyse a partial study, first save a manifest containing exactly the runs under consideration; do not count incomplete repetitions as a three-seed result.", "Text"],

Cell[BoxData[RowBox[{"ClearAll", "[", "checkRecords", "]", ";", "\n", "configurationFields", " ", "=", " ", "{", "\"ExperimentID\"", ",", " ", "\"Study\"", ",", " ", "\"Dataset\"", ",", " ", "\"Model\"", ",", " ", "\"Optimizer\"", ",", "\n", "  ", "\"Rounds\"", ",", " ", "\"InputTransform\"", ",", " ", "\"TargetTransform\"", ",", " ", "\"LayerWidths\"", ",", " ", "\"FeaturePositions\"", ",", "\n", "  ", "\"LearningRate\"", ",", " ", "\"LearningRateSchedule\"", ",", " ", "\"MethodOptions\"", ",", " ", "\"BatchSize\"", ",", " ", "\"Initializer\"", ",", "\n", "  ", "\"SplitSeed\"", ",", " ", "\"Parameters\"", ",", " ", "\"TargetDevice\"", ",", " ", "\"WorkingPrecision\"", "}", ";", "\n", "checkRecords", "[", "rows", "_", "List", ",", " ", "cp", "_", "String", "]", " ", ":=", " ", "Module", "[", "{", "groups", ",", " ", "expected", ",", " ", "actual", ",", " ", "common", "}", ",", "\n", "  ", "If", "[", "rows", " ", "===", " ", "{", "}", " ", "||", " ", "manifest", " ", "===", " ", "{", "}", ",", " ", "Return", "[", "Failure", "[", "\"EmptyStudy\"", ",", " ", "<|", "|>", "]", "]", "]", ";", "\n", "  ", "If", "[", "!", "AllTrue", "[", "rows", ",", " ", "NumberQ", "[", "Lookup", "[", "#", ",", " ", "\"TotalRounds\"", "]", "]", " ", "&&", " ", "NumberQ", "[", "Lookup", "[", "#", ",", " ", "\"Rounds\"", "]", "]", " ", "&&", "\n", "      ", "#", "[", "\"TotalRounds\"", "]", " ", ">=", " ", "#", "[", "\"Rounds\"", "]", " ", "&", "]", ",", " ", "Return", "[", "Failure", "[", "\"IncompleteTrainingBudget\"", ",", " ", "<|", "|>", "]", "]", "]", ";", "\n", "  ", "expected", " ", "=", " ", "Sort", "[", "Lookup", "[", "#", ",", " ", "{", "\"ExperimentID\"", ",", " ", "\"Seed\"", "}", "]", " ", "&", " ", "/@", " ", "manifest", "]", ";", "\n", "  ", "actual", " ", "=", " ", "Sort", "[", "Lookup", "[", "#", ",", " ", "{", "\"ExperimentID\"", ",", " ", "\"Seed\"", "}", "]", " ", "&", " ", "/@", " ", "rows", "]", ";", "\n", "  ", "If", "[", "!", "DuplicateFreeQ", "[", "actual", "]", ",", " ", "Return", "[", "Failure", "[", "\"DuplicateRuns\"", ",", " ", "<|", "|>", "]", "]", "]", ";", "\n", "  ", "If", "[", "actual", " ", "=!=", " ", "expected", ",", " ", "Return", "[", "Failure", "[", "\"ManifestMismatch\"", ",", " ", "<|", "\n", "      ", "\"Missing\"", " ", "->", " ", "Complement", "[", "expected", ",", " ", "actual", "]", ",", " ", "\"Unexpected\"", " ", "->", " ", "Complement", "[", "actual", ",", " ", "expected", "]", "|>", "]", "]", "]", ";", "\n", "  ", "If", "[", "!", "AllTrue", "[", "rows", ",", " ", "Lookup", "[", "#", ",", " ", "\"Checkpoint\"", ",", " ", "\"\"", "]", " ", "===", " ", "cp", " ", "&&", "\n", "      ", "Lookup", "[", "#", ",", " ", "\"Status\"", ",", " ", "\"\"", "]", " ", "===", " ", "\"Complete\"", " ", "&", "]", ",", "\n", "    ", "Return", "[", "Failure", "[", "\"RunStatus\"", ",", " ", "<|", "|>", "]", "]", "]", ";", "\n", "  ", "groups", " ", "=", " ", "Values", "[", "GroupBy", "[", "rows", ",", " ", "#", "[", "\"ExperimentID\"", "]", " ", "&", "]", "]", ";", "\n", "  ", "If", "[", "!", "AllTrue", "[", "groups", ",", " ", "Sort", "[", "Lookup", "[", "#", ",", " ", "\"Seed\"", "]", "]", " ", "===", " ", "Sort", "[", "expectedSeeds", "]", " ", "&", "]", ",", "\n", "    ", "Return", "[", "Failure", "[", "\"SeedCounts\"", ",", " ", "<|", "\"ExpectedSeeds\"", " ", "->", " ", "expectedSeeds", "|>", "]", "]", "]", ";", "\n", "  ", "If", "[", "!", "AllTrue", "[", "groups", ",", " ", "Length", "[", "DeleteDuplicates", "[", "KeyTake", "[", "#", ",", " ", "configurationFields", "]", " ", "&", " ", "/@", " ", "#", "]", "]", " ", "==", " ", "1", " ", "&", "]", ",", "\n", "    ", "Return", "[", "Failure", "[", "\"MixedConfiguration\"", ",", " ", "<|", "|>", "]", "]", "]", ";", "\n", "  ", "common", " ", "=", " ", "Intersection", "[", "configurationFields", ",", " ", "Keys", "[", "First", "[", "manifest", "]", "]", "]", ";", "\n", "  ", "If", "[", "!", "AllTrue", "[", "rows", ",", " ", "Function", "[", "r", ",", "\n", "      ", "With", "[", "{", "planned", " ", "=", " ", "SelectFirst", "[", "manifest", ",", "\n", "        ", "#", "[", "\"ExperimentID\"", "]", " ", "===", " ", "r", "[", "\"ExperimentID\"", "]", " ", "&&", " ", "#", "[", "\"Seed\"", "]", " ", "===", " ", "r", "[", "\"Seed\"", "]", " ", "&", "]", "}", ",", "\n", "        ", "Lookup", "[", "r", ",", " ", "common", "]", " ", "===", " ", "Lookup", "[", "planned", ",", " ", "common", "]", "]", "]", "]", ",", "\n", "    ", "Return", "[", "Failure", "[", "\"SettingsMismatch\"", ",", " ", "<|", "|>", "]", "]", "]", ";", "\n", "  ", "<|", "\"Checkpoint\"", " ", "->", " ", "cp", ",", " ", "\"Fits\"", " ", "->", " ", "Length", "[", "rows", "]", ",", " ", "\"Configurations\"", " ", "->", " ", "Length", "[", "groups", "]", ",", "\n", "    ", "\"Seeds\"", " ", "->", " ", "Sort", "[", "DeleteDuplicates", "[", "Lookup", "[", "rows", ",", " ", "\"Seed\"", "]", "]", "]", ",", "\n", "    ", "\"TrainingRounds\"", " ", "->", " ", "Sort", "[", "DeleteDuplicates", "[", "Lookup", "[", "rows", ",", " ", "\"TotalRounds\"", "]", "]", "]", "|>", "\n", "]", ";", "\n", "checks", " ", "=", " ", "AssociationMap", "[", "checkRecords", "[", "metricsByCheckpoint", "[", "#", "]", ",", " ", "#", "]", " ", "&", ",", " ", "{", "\"Best\"", ",", " ", "\"Final\"", "}", "]", ";", "\n", "If", "[", "AnyTrue", "[", "Values", "[", "checks", "]", ",", " ", "FailureQ", "]", ",", " ", "Print", "[", "checks", "]", ";", " ", "Abort", "[", "]", "]", ";", "\n", "Dataset", "[", "Values", "[", "checks", "]", "]"}]], "Input" , CellTags -> "input-12"],

Cell["The supplied study contains 78 width/depth fits and 96 CHL-table fits, using three training seeds on fixed data partitions. Best and Final CSV files each contain these same 174 fits. The summary bundle contains numerical exports and provenance; its historical model-cache paths need not exist on this computer.", "Text"],

Cell[BoxData[RowBox[{"(* Change this ID to inspect any row in experiment_manifest.csv. *)", "\n", "experimentToInspect", " ", "=", " ", "\"wd_eta_negative_Depth3Width128_ADAM\"", ";", "\n", "If", "[", "!", "MemberQ", "[", "Lookup", "[", "metrics", ",", " ", "\"ExperimentID\"", "]", ",", " ", "experimentToInspect", "]", ",", "\n", "  ", "experimentToInspect", " ", "=", " ", "First", "[", "Lookup", "[", "metrics", ",", " ", "\"ExperimentID\"", "]", "]", "]", ";", "\n", "Dataset", "[", "KeyTake", "[", "#", ",", " ", "Join", "[", "configurationFields", ",", "\n", "  ", "{", "\"Seed\"", ",", " ", "\"InitializationSeed\"", ",", " ", "\"TrainingSeed\"", ",", " ", "\"BestValidationRound\"", ",", " ", "\"TotalRounds\"", ",", "\n", "   ", "\"Signature\"", ",", " ", "\"InitialArraysHash\"", ",", " ", "\"BatchPermutationHash\"", ",", " ", "\"Version\"", ",", " ", "\"RunFile\"", "}", "]", "]", " ", "&", " ", "/@", "\n", "  ", "Select", "[", "metrics", ",", " ", "#", "[", "\"ExperimentID\"", "]", " ", "===", " ", "experimentToInspect", " ", "&", "]", "]"}]], "Input" , CellTags -> "input-14"]
}, Open]],

Cell[CellGroupData[{
Cell["2. Metrics and seed summaries", "Section"],

Cell["MAPE = 100 Mean[Abs[(predicted weight - true weight)/true weight]]; RMSE = Sqrt[Mean[(predicted weight - true weight)^2]]. Both refer to signed physical weights after undoing the target transformation. TrainLoss and ValidationLoss are mean squared errors in the fitted target space: standardized weights for the eta capacity study, and log absolute powers for the CHL study. Loss magnitudes from different target transformations are not directly comparable. MAPE is undefined for a zero target; missing values are retained rather than silently removed.", "Text"],

Cell["Each table averages the per-run metric over training seeds. The displayed spread is the sample standard deviation across those seeds on the same split. It is neither the standard error of the mean nor uncertainty from alternative train/test splits. Checkpoint choice uses validation loss; comparisons of test errors below are descriptive and do not tune hyperparameters.", "Text"],

Cell[BoxData[RowBox[{"ClearAll", "[", "metricStats", ",", " ", "summarizeRuns", ",", " ", "architectureLabel", "]", ";", "\n", "metricStats", "[", "rows", "_", "List", ",", " ", "key", "_", "String", "]", " ", ":=", " ", "Module", "[", "{", "v", " ", "=", " ", "Lookup", "[", "rows", ",", " ", "key", ",", " ", "Missing", "[", "\"Absent\"", "]", "]", "}", ",", "\n", "  ", "If", "[", "v", " ", "===", " ", "{", "}", " ", "||", " ", "!", "AllTrue", "[", "v", ",", " ", "NumberQ", "]", ",", "\n", "    ", "<|", "\"Mean\"", " ", "->", " ", "Missing", "[", "\"IncompleteMetric\"", "]", ",", " ", "\"SD\"", " ", "->", " ", "Missing", "[", "\"IncompleteMetric\"", "]", "|>", ",", "\n", "    ", "<|", "\"Mean\"", " ", "->", " ", "Mean", "[", "v", "]", ",", " ", "\"SD\"", " ", "->", " ", "If", "[", "Length", "[", "v", "]", " ", ">", " ", "1", ",", " ", "StandardDeviation", "[", "v", "]", ",", " ", "Missing", "[", "\"SingleSeed\"", "]", "]", "|>", "]", "\n", "]", ";", "\n", "summaryMetrics", " ", "=", " ", "{", "\"TrainLoss\"", ",", " ", "\"ValidationLoss\"", ",", " ", "\"TrainRMSE\"", ",", " ", "\"TestRMSE\"", ",", " ", "\"TrainNRMSE\"", ",", "\n", "  ", "\"TestNRMSE\"", ",", " ", "\"TestMAPE\"", ",", " ", "\"Seconds\"", ",", " ", "\"BestValidationRound\"", "}", ";", "\n", "summarizeRuns", "[", "rows", "_", "List", "]", " ", ":=", " ", "SortBy", "[", "\n", "  ", "Map", "[", "Function", "[", "group", ",", " ", "Join", "[", "\n", "    ", "KeyTake", "[", "First", "[", "group", "]", ",", " ", "Join", "[", "configurationFields", ",", "\n", "      ", "{", "\"N\"", ",", " ", "\"PaperTable\"", ",", " ", "\"HiddenLayers\"", ",", " ", "\"Width\"", ",", " ", "\"TrainCount\"", ",", " ", "\"ValidationCount\"", ",", " ", "\"TestCount\"", ",", " ", "\"Checkpoint\"", "}", "]", "]", ",", "\n", "    ", "<|", "\"Seeds\"", " ", "->", " ", "Sort", "[", "Lookup", "[", "group", ",", " ", "\"Seed\"", "]", "]", ",", " ", "\"SeedCount\"", " ", "->", " ", "Length", "[", "group", "]", "|>", ",", "\n", "    ", "AssociationMap", "[", "metricStats", "[", "group", ",", " ", "#", "]", " ", "&", ",", " ", "summaryMetrics", "]", "]", "]", ",", "\n", "    ", "Values", "[", "GroupBy", "[", "rows", ",", " ", "#", "[", "\"ExperimentID\"", "]", " ", "&", "]", "]", "]", ",", "\n", "  ", "{", "#", "[", "\"Dataset\"", "]", " ", "&", ",", " ", "#", "[", "\"Parameters\"", "]", " ", "&", ",", " ", "#", "[", "\"Optimizer\"", "]", " ", "&", "}", "]", ";", "\n", "architectureLabel", "[", "r", "_", "Association", "]", " ", ":=", " ", "If", "[", "NumberQ", "[", "Lookup", "[", "r", ",", " ", "\"Width\"", "]", "]", ",", "\n", "  ", "ToString", "[", "r", "[", "\"HiddenLayers\"", "]", "]", " ", "<>", " ", "\" x \"", " ", "<>", " ", "ToString", "[", "r", "[", "\"Width\"", "]", "]", ",", " ", "ToString", "[", "r", "[", "\"Model\"", "]", "]", "]", ";", "\n", "summaryByCheckpoint", " ", "=", " ", "Map", "[", "summarizeRuns", ",", " ", "metricsByCheckpoint", "]", ";", "\n", "summary", " ", "=", " ", "summaryByCheckpoint", "[", "checkpoint", "]", ";", "\n", "widthDepthSummary", " ", "=", " ", "Select", "[", "summary", ",", " ", "#", "[", "\"Study\"", "]", " ", "===", " ", "\"width_depth\"", " ", "&", "]", ";", "\n", "Dataset", "[", "Map", "[", "Function", "[", "r", ",", " ", "<|", "\"Dataset\"", " ", "->", " ", "r", "[", "\"Dataset\"", "]", ",", " ", "\"Architecture\"", " ", "->", " ", "architectureLabel", "[", "r", "]", ",", "\n", "  ", "\"Optimizer\"", " ", "->", " ", "r", "[", "\"Optimizer\"", "]", ",", " ", "\"Parameters\"", " ", "->", " ", "r", "[", "\"Parameters\"", "]", ",", " ", "\"Seeds\"", " ", "->", " ", "r", "[", "\"Seeds\"", "]", ",", "\n", "  ", "\"Train MSE\"", " ", "->", " ", "r", "[", "\"TrainLoss\"", "]", "[", "\"Mean\"", "]", ",", " ", "\"Validation MSE\"", " ", "->", " ", "r", "[", "\"ValidationLoss\"", "]", "[", "\"Mean\"", "]", ",", "\n", "  ", "\"Test MAPE (%)\"", " ", "->", " ", "r", "[", "\"TestMAPE\"", "]", ",", " ", "\"Test RMSE\"", " ", "->", " ", "r", "[", "\"TestRMSE\"", "]", "|>", "]", ",", " ", "widthDepthSummary", "]", "]"}]], "Input" , CellTags -> "input-18"],

Cell["Analytic reference values", "Subsection"],

Cell["The coefficient-ratio references use the exact coefficients at q^0 and q^1. They measure an analytic identity available within each known family. They do not use the same information as a model whose input is a fixed slice omitting these positions. The family and sign are known in the separate family datasets.", "Text"],

Cell[BoxData[RowBox[{"baselineFile", " ", "=", " ", "FileNameJoin", "[", "{", "resultsDirectory", ",", " ", "\"analytic_baselines.csv\"", "}", "]", ";", "\n", "If", "[", "FileExistsQ", "[", "baselineFile", "]", ",", "\n", "  ", "Dataset", "[", "Select", "[", "readRows", "[", "baselineFile", "]", ",", " ", "Lookup", "[", "#", ",", " ", "\"Split\"", ",", " ", "\"\"", "]", " ", "===", " ", "\"Test\"", " ", "&", "]", "]", ",", "\n", "  ", "\"No analytic baseline CSV in this results directory.\"", "]"}]], "Input" , CellTags -> "input-21"]
}, Open]],

Cell[CellGroupData[{
Cell["3. Width, depth and optimizer comparisons", "Section"],

Cell["The capacity curves first vary the width of a single hidden layer, keeping the optimizer fixed. A separate plot compares depths at width 128. Net1 and Net3 have tapered layer widths, so they are tabulated rather than placed on a uniform-width depth curve. Points are seed means; their standard deviations are given in the tables. For a fixed-budget capacity study, use the Final checkpoint to avoid a different stopping round at each capacity.", "Text"],

Cell[BoxData[RowBox[{"ClearAll", "[", "capacityPlot", ",", " ", "depthPlot", "]", ";", "\n", "plotCheckpoint", " ", "=", " ", "\"Final\"", ";", "\n", "widthDepthDatasets", " ", "=", " ", "DeleteDuplicates", "[", "Lookup", "[", "\n", "  ", "Select", "[", "metricsByCheckpoint", "[", "plotCheckpoint", "]", ",", " ", "#", "[", "\"Study\"", "]", " ", "===", " ", "\"width_depth\"", " ", "&", "]", ",", " ", "\"Dataset\"", "]", "]", ";", "\n", "primaryOptimizer", " ", "=", " ", "Join", "[", "\n", "  ", "AssociationMap", "[", "Function", "[", "ds", ",", " ", "First", "[", "Lookup", "[", "Select", "[", "metricsByCheckpoint", "[", "plotCheckpoint", "]", ",", "\n", "    ", "#", "[", "\"Study\"", "]", " ", "===", " ", "\"width_depth\"", " ", "&&", " ", "#", "[", "\"Dataset\"", "]", " ", "===", " ", "ds", " ", "&", "]", ",", " ", "\"Optimizer\"", "]", "]", "]", ",", " ", "widthDepthDatasets", "]", ",", "\n", "  ", "KeyTake", "[", "<|", "\"eta_negative\"", " ", "->", " ", "\"ADAM\"", ",", " ", "\"chl_N3_positive_integer\"", " ", "->", " ", "\"RMSProp\"", "|>", ",", " ", "widthDepthDatasets", "]", "]", ";", "\n", "capacityDatasets", " ", "=", " ", "Select", "[", "widthDepthDatasets", ",", " ", "Function", "[", "ds", ",", "\n", "  ", "AnyTrue", "[", "summaryByCheckpoint", "[", "plotCheckpoint", "]", ",", " ", "#", "[", "\"Study\"", "]", " ", "===", " ", "\"width_depth\"", " ", "&&", " ", "#", "[", "\"Dataset\"", "]", " ", "===", " ", "ds", " ", "&&", "\n", "    ", "#", "[", "\"Optimizer\"", "]", " ", "===", " ", "primaryOptimizer", "[", "ds", "]", " ", "&&", " ", "#", "[", "\"HiddenLayers\"", "]", " ", "===", " ", "1", " ", "&", "]", "]", "]", ";", "\n", "depthDatasets", " ", "=", " ", "Select", "[", "widthDepthDatasets", ",", " ", "Function", "[", "ds", ",", "\n", "  ", "AnyTrue", "[", "summaryByCheckpoint", "[", "plotCheckpoint", "]", ",", " ", "#", "[", "\"Study\"", "]", " ", "===", " ", "\"width_depth\"", " ", "&&", " ", "#", "[", "\"Dataset\"", "]", " ", "===", " ", "ds", " ", "&&", "\n", "    ", "#", "[", "\"Optimizer\"", "]", " ", "===", " ", "primaryOptimizer", "[", "ds", "]", " ", "&&", " ", "Lookup", "[", "#", ",", " ", "\"Width\"", "]", " ", "===", " ", "128", " ", "&", "]", "]", "]", ";", "\n", "capacityPlot", "[", "ds", "_", "String", "]", " ", ":=", " ", "Module", "[", "{", "s", ",", " ", "points", "}", ",", "\n", "  ", "s", " ", "=", " ", "SortBy", "[", "Select", "[", "summaryByCheckpoint", "[", "plotCheckpoint", "]", ",", "\n", "    ", "#", "[", "\"Study\"", "]", " ", "===", " ", "\"width_depth\"", " ", "&&", " ", "#", "[", "\"Dataset\"", "]", " ", "===", " ", "ds", " ", "&&", "\n", "    ", "#", "[", "\"Optimizer\"", "]", " ", "===", " ", "primaryOptimizer", "[", "ds", "]", " ", "&&", " ", "#", "[", "\"HiddenLayers\"", "]", " ", "===", " ", "1", " ", "&", "]", ",", " ", "#", "[", "\"Parameters\"", "]", " ", "&", "]", ";", "\n", "  ", "points", "[", "key", "_", "]", " ", ":=", " ", "(", "{", "N", "[", "#", "[", "\"Parameters\"", "]", "/", "#", "[", "\"TrainCount\"", "]", "]", ",", " ", "#", "[", "key", "]", "[", "\"Mean\"", "]", "}", " ", "&", " ", "/@", " ", "s", ")", ";", "\n", "  ", "ListLogLogPlot", "[", "{", "points", "[", "\"TrainNRMSE\"", "]", ",", " ", "points", "[", "\"TestNRMSE\"", "]", "}", ",", " ", "Joined", " ", "->", " ", "True", ",", "\n", "    ", "PlotMarkers", " ", "->", " ", "Automatic", ",", " ", "Frame", " ", "->", " ", "True", ",", " ", "FrameLabel", " ", "->", " ", "{", "\"Parameters / training examples\"", ",", " ", "\"Weight NRMSE\"", "}", ",", "\n", "    ", "PlotLegends", " ", "->", " ", "{", "\"Training\"", ",", " ", "\"Test\"", "}", ",", " ", "PlotLabel", " ", "->", " ", "ds", " ", "<>", " ", "\" | one hidden layer | \"", " ", "<>", " ", "plotCheckpoint", ",", "\n", "    ", "PlotStyle", " ", "->", " ", "{", "RGBColor", "[", "0.2", ",", " ", "0.35", ",", " ", "0.6", "]", ",", " ", "RGBColor", "[", "0.75", ",", " ", "0.35", ",", " ", "0.15", "]", "}", ",", " ", "ImageSize", " ", "->", " ", "520", "]", "\n", "]", ";", "\n", "depthPlot", "[", "ds", "_", "String", ",", " ", "width", "_", "Integer", " ", ":", " ", "128", "]", " ", ":=", " ", "Module", "[", "{", "s", ",", " ", "points", "}", ",", "\n", "  ", "s", " ", "=", " ", "SortBy", "[", "Select", "[", "summaryByCheckpoint", "[", "plotCheckpoint", "]", ",", "\n", "    ", "#", "[", "\"Study\"", "]", " ", "===", " ", "\"width_depth\"", " ", "&&", " ", "#", "[", "\"Dataset\"", "]", " ", "===", " ", "ds", " ", "&&", "\n", "    ", "#", "[", "\"Optimizer\"", "]", " ", "===", " ", "primaryOptimizer", "[", "ds", "]", " ", "&&", " ", "Lookup", "[", "#", ",", " ", "\"Width\"", "]", " ", "===", " ", "width", " ", "&", "]", ",", " ", "#", "[", "\"HiddenLayers\"", "]", " ", "&", "]", ";", "\n", "  ", "points", "[", "key", "_", "]", " ", ":=", " ", "(", "{", "#", "[", "\"HiddenLayers\"", "]", ",", " ", "#", "[", "key", "]", "[", "\"Mean\"", "]", "}", " ", "&", " ", "/@", " ", "s", ")", ";", "\n", "  ", "ListLogPlot", "[", "{", "points", "[", "\"TrainRMSE\"", "]", ",", " ", "points", "[", "\"TestRMSE\"", "]", "}", ",", " ", "Joined", " ", "->", " ", "True", ",", "\n", "    ", "PlotMarkers", " ", "->", " ", "Automatic", ",", " ", "Frame", " ", "->", " ", "True", ",", " ", "FrameLabel", " ", "->", " ", "{", "\"Hidden layers\"", ",", " ", "\"Weight RMSE\"", "}", ",", "\n", "    ", "PlotLegends", " ", "->", " ", "{", "\"Training\"", ",", " ", "\"Test\"", "}", ",", " ", "PlotLabel", " ", "->", " ", "ds", " ", "<>", " ", "\" | width \"", " ", "<>", " ", "ToString", "[", "width", "]", " ", "<>", " ", "\" | \"", " ", "<>", " ", "plotCheckpoint", ",", "\n", "    ", "PlotStyle", " ", "->", " ", "{", "RGBColor", "[", "0.2", ",", " ", "0.35", ",", " ", "0.6", "]", ",", " ", "RGBColor", "[", "0.75", ",", " ", "0.35", ",", " ", "0.15", "]", "}", ",", " ", "ImageSize", " ", "->", " ", "520", "]", "\n", "]", ";", "\n", "capacityFigures", " ", "=", " ", "AssociationMap", "[", "capacityPlot", ",", " ", "capacityDatasets", "]", ";", "\n", "depthFigures", " ", "=", " ", "AssociationMap", "[", "depthPlot", ",", " ", "depthDatasets", "]", ";", "\n", "If", "[", "capacityDatasets", " ", "===", " ", "{", "}", " ", "&&", " ", "depthDatasets", " ", "===", " ", "{", "}", ",", " ", "\"No matching width/depth plots in this study.\"", ",", "\n", "  ", "Column", "[", "Join", "[", "Values", "[", "capacityFigures", "]", ",", " ", "Values", "[", "depthFigures", "]", "]", ",", " ", "Spacings", " ", "->", " ", "2", "]", "]"}]], "Input" , CellTags -> "input-24"],

Cell["Changing depth at fixed width also changes parameter count. These comparisons therefore do not isolate depth at fixed capacity. A double-descent interpretation additionally requires a reproducible test-error peak near a resolved interpolation transition and a subsequent decline; parameter count exceeding sample count is insufficient. Inspect individual seeds and training errors before drawing that conclusion.", "Text"],

Cell["Paired optimizer differences", "Subsection"],

Cell["For architectures evaluated with both optimizers, pair runs by training seed. The reported difference is ADAM minus RMSProp, so a negative number favours ADAM for that metric. Verify identical split, initialization and minibatch permutation hashes before interpreting the comparison. The comparison concerns the recorded learning-rate settings, not separately optimized families of optimizers.", "Text"],

Cell[BoxData[RowBox[{"ClearAll", "[", "pairedOptimizerRows", "]", ";", "\n", "pairedOptimizerRows", "[", "rows", "_", "List", "]", " ", ":=", " ", "Module", "[", "{", "groups", ",", " ", "out", " ", "=", " ", "{", "}", ",", " ", "adam", ",", " ", "rms", ",", " ", "seeds", ",", " ", "a", ",", " ", "b", ",", " ", "delta", "}", ",", "\n", "  ", "groups", " ", "=", " ", "Values", "[", "GroupBy", "[", "Select", "[", "rows", ",", " ", "#", "[", "\"Study\"", "]", " ", "===", " ", "\"width_depth\"", " ", "&", "]", ",", "\n", "    ", "Lookup", "[", "#", ",", " ", "{", "\"Dataset\"", ",", " ", "\"Model\"", "}", "]", " ", "&", "]", "]", ";", "\n", "  ", "Do", "[", "\n", "    ", "adam", " ", "=", " ", "Select", "[", "g", ",", " ", "#", "[", "\"Optimizer\"", "]", " ", "===", " ", "\"ADAM\"", " ", "&", "]", ";", "\n", "    ", "rms", " ", "=", " ", "Select", "[", "g", ",", " ", "#", "[", "\"Optimizer\"", "]", " ", "===", " ", "\"RMSProp\"", " ", "&", "]", ";", "\n", "    ", "seeds", " ", "=", " ", "Intersection", "[", "Lookup", "[", "adam", ",", " ", "\"Seed\"", "]", ",", " ", "Lookup", "[", "rms", ",", " ", "\"Seed\"", "]", "]", ";", "\n", "    ", "If", "[", "seeds", " ", "=!=", " ", "{", "}", ",", "\n", "      ", "a", " ", "=", " ", "Table", "[", "SelectFirst", "[", "adam", ",", " ", "#", "[", "\"Seed\"", "]", " ", "===", " ", "seed", " ", "&", "]", ",", " ", "{", "seed", ",", " ", "seeds", "}", "]", ";", "\n", "      ", "b", " ", "=", " ", "Table", "[", "SelectFirst", "[", "rms", ",", " ", "#", "[", "\"Seed\"", "]", " ", "===", " ", "seed", " ", "&", "]", ",", " ", "{", "seed", ",", " ", "seeds", "}", "]", ";", "\n", "      ", "delta", "[", "key", "_", "]", " ", ":=", " ", "MapThread", "[", "#", "1", "[", "key", "]", " ", "-", " ", "#", "2", "[", "key", "]", " ", "&", ",", " ", "{", "a", ",", " ", "b", "}", "]", ";", "\n", "      ", "AppendTo", "[", "out", ",", " ", "<|", "\"Dataset\"", " ", "->", " ", "First", "[", "a", "]", "[", "\"Dataset\"", "]", ",", "\n", "        ", "\"Architecture\"", " ", "->", " ", "architectureLabel", "[", "First", "[", "a", "]", "]", ",", " ", "\"Seeds\"", " ", "->", " ", "seeds", ",", "\n", "        ", "\"PairingVerified\"", " ", "->", " ", "And", " ", "@@", " ", "MapThread", "[", "\n", "          ", "Lookup", "[", "#", "1", ",", " ", "{", "\"SplitSeed\"", ",", " ", "\"InitialArraysHash\"", ",", " ", "\"BatchPermutationHash\"", "}", "]", " ", "===", "\n", "          ", "Lookup", "[", "#", "2", ",", " ", "{", "\"SplitSeed\"", ",", " ", "\"InitialArraysHash\"", ",", " ", "\"BatchPermutationHash\"", "}", "]", " ", "&", ",", " ", "{", "a", ",", " ", "b", "}", "]", ",", "\n", "        ", "\"MAPE difference mean\"", " ", "->", " ", "Mean", "[", "delta", "[", "\"TestMAPE\"", "]", "]", ",", "\n", "        ", "\"MAPE difference SD\"", " ", "->", " ", "If", "[", "Length", "[", "seeds", "]", " ", ">", " ", "1", ",", " ", "StandardDeviation", "[", "delta", "[", "\"TestMAPE\"", "]", "]", ",", " ", "Missing", "[", "\"SingleSeed\"", "]", "]", ",", "\n", "        ", "\"RMSE difference mean\"", " ", "->", " ", "Mean", "[", "delta", "[", "\"TestRMSE\"", "]", "]", "|>", "]", "]", ",", "\n", "    ", "{", "g", ",", " ", "groups", "}", "]", ";", " ", "out", "\n", "]", ";", "\n", "optimizerPairs", " ", "=", " ", "pairedOptimizerRows", "[", "metrics", "]", ";", "\n", "Dataset", "[", "optimizerPairs", "]"}]], "Input" , CellTags -> "input-28"]
}, Open]],

Cell[CellGroupData[{
Cell["4. CHL tables", "Section"],

Cell["The table numbers below identify the experiment groups corresponding to manuscript Tables 2–7. The full seed-level settings remain in experiment_manifest.csv. The tables include the eta comparison rows where these were scheduled, and retain each row's recorded optimizer. Percentages are computed on physical weights; the training and validation losses retain their fitted-target definition.", "Text"],

Cell[BoxData[RowBox[{"chlTableDescriptions", " ", "=", " ", "<|", "\n", "  ", "2", " ", "->", " ", "\"Positive integer powers; coefficient positions 0 through 29\"", ",", "\n", "  ", "3", " ", "->", " ", "\"Negative integer powers; coefficient positions 0 through 29\"", ",", "\n", "  ", "4", " ", "->", " ", "\"Positive rational powers; coefficient positions 0 through 29\"", ",", "\n", "  ", "5", " ", "->", " ", "\"Negative rational powers; coefficient positions 0 through 29\"", ",", "\n", "  ", "6", " ", "->", " ", "\"Positive integer powers; recorded fixed slice of 15 coefficient positions\"", ",", "\n", "  ", "7", " ", "->", " ", "\"Negative integer powers; recorded fixed slice of 15 coefficient positions\"", "|>", ";", "\n", "ClearAll", "[", "experimentLabel", ",", " ", "chlGroups", "]", ";", "\n", "experimentLabel", "[", "r", "_", "]", " ", ":=", " ", "If", "[", "ToString", "[", "Lookup", "[", "r", ",", " ", "\"N\"", ",", " ", "\"\"", "]", "]", " ", "===", " ", "\"eta\"", ",", " ", "\"eta\"", ",", "\n", "  ", "\"N=\"", " ", "<>", " ", "ToString", "[", "Lookup", "[", "r", ",", " ", "\"N\"", ",", " ", "\"?\"", "]", "]", "]", ";", "\n", "chlGroups", "[", "table", "_", "Integer", ",", " ", "cp", "_", "String", "]", " ", ":=", " ", "SortBy", "[", "\n", "  ", "Select", "[", "summaryByCheckpoint", "[", "cp", "]", ",", " ", "#", "[", "\"Study\"", "]", " ", "===", " ", "\"chl\"", " ", "&&", " ", "Lookup", "[", "#", ",", " ", "\"PaperTable\"", "]", " ", "===", " ", "table", " ", "&", "]", ",", "\n", "  ", "If", "[", "ToString", "[", "Lookup", "[", "#", ",", " ", "\"N\"", ",", " ", "\"\"", "]", "]", " ", "===", " ", "\"eta\"", ",", " ", "-", "1", ",", " ", "readNumber", "[", "Lookup", "[", "#", ",", " ", "\"N\"", ",", " ", "\"\"", "]", "]", "]", " ", "&", "]", ";", "\n", "availableCHLTables", " ", "=", " ", "Select", "[", "Range", "[", "2", ",", " ", "7", "]", ",", " ", "chlGroups", "[", "#", ",", " ", "checkpoint", "]", " ", "=!=", " ", "{", "}", " ", "&", "]", ";", "\n", "Column", "[", "Table", "[", "Column", "[", "{", "Style", "[", "\"Table \"", " ", "<>", " ", "ToString", "[", "t", "]", " ", "<>", " ", "\": \"", " ", "<>", " ", "chlTableDescriptions", "[", "t", "]", ",", " ", "Bold", "]", ",", "\n", "  ", "Dataset", "[", "Map", "[", "Function", "[", "r", ",", " ", "<|", "\"Experiment\"", " ", "->", " ", "experimentLabel", "[", "r", "]", ",", " ", "\"Optimizer\"", " ", "->", " ", "r", "[", "\"Optimizer\"", "]", ",", "\n", "    ", "\"Architecture\"", " ", "->", " ", "architectureLabel", "[", "r", "]", ",", " ", "\"Seeds\"", " ", "->", " ", "r", "[", "\"SeedCount\"", "]", ",", "\n", "    ", "\"Training loss\"", " ", "->", " ", "r", "[", "\"TrainLoss\"", "]", "[", "\"Mean\"", "]", ",", " ", "\"Validation loss\"", " ", "->", " ", "r", "[", "\"ValidationLoss\"", "]", "[", "\"Mean\"", "]", ",", "\n", "    ", "\"Test MAPE (%)\"", " ", "->", " ", "r", "[", "\"TestMAPE\"", "]", ",", " ", "\"Test RMSE\"", " ", "->", " ", "r", "[", "\"TestRMSE\"", "]", "|>", "]", ",", " ", "chlGroups", "[", "t", ",", " ", "checkpoint", "]", "]", "]", "}", "]", ",", "\n", "  ", "{", "t", ",", " ", "availableCHLTables", "}", "]", ",", " ", "Spacings", " ", "->", " ", "2", "]"}]], "Input" , CellTags -> "input-31"]
}, Open]],

Cell[CellGroupData[{
Cell["5. Export TeX tables and a standalone report", "Section"],

Cell["The following small exporter uses only Wolfram Language. It creates booktabs tables with captions, a depth/width appendix fragment, a full standalone report, and the four capacity/depth plots. Both checkpoint conventions are exported separately. Numerical conclusions are restricted to recorded comparisons; the report does not choose a network by its test error. Set exportReports = True in Section 1 and reevaluate this section to write files. Existing report files in outputDirectory are replaced.", "Text"],

Cell[BoxData[RowBox[{"ClearAll", "[", "texEscape", ",", " ", "texNumber", ",", " ", "texMetric", ",", " ", "texTable", ",", " ", "checkpointText", "]", ";", "\n", "texEscape", "[", "x", "_", "]", " ", ":=", " ", "StringReplace", "[", "ToString", "[", "x", "]", ",", " ", "{", "\n", "  ", "\"\\\\\"", " ", "->", " ", "\"\\\\textbackslash{}\"", ",", " ", "\"&\"", " ", "->", " ", "\"\\\\&\"", ",", " ", "\"%\"", " ", "->", " ", "\"\\\\%\"", ",", " ", "\"$\"", " ", "->", " ", "\"\\\\$\"", ",", " ", "\"#\"", " ", "->", " ", "\"\\\\#\"", ",", "\n", "  ", "\"_\"", " ", "->", " ", "\"\\\\_\"", ",", " ", "\"{\"", " ", "->", " ", "\"\\\\{\"", ",", " ", "\"}\"", " ", "->", " ", "\"\\\\}\"", ",", " ", "\"~\"", " ", "->", " ", "\"\\\\textasciitilde{}\"", ",", " ", "\"^\"", " ", "->", " ", "\"\\\\textasciicircum{}\"", "}", "]", ";", "\n", "texNumber", "[", "x", "_", "?", "NumberQ", "]", " ", ":=", " ", "Module", "[", "{", "e", ",", " ", "show", "}", ",", "\n", "  ", "show", "[", "y", "_", "]", " ", ":=", " ", "StringTrim", "[", "ToString", "[", "NumberForm", "[", "N", "[", "y", "]", ",", " ", "3", ",", " ", "ExponentFunction", " ", "->", " ", "(", "Null", " ", "&", ")", "]", ",", " ", "OutputForm", "]", "]", ";", "\n", "  ", "If", "[", "x", " ", "==", " ", "0", ",", " ", "Return", "[", "\"0\"", "]", "]", ";", "\n", "  ", "If", "[", "Abs", "[", "x", "]", " ", "<", " ", "0.001", " ", "||", " ", "Abs", "[", "x", "]", " ", ">=", " ", "10000", ",", "\n", "    ", "e", " ", "=", " ", "Floor", "[", "Log", "[", "10", ",", " ", "Abs", "[", "x", "]", "]", "]", ";", " ", "show", "[", "x", "/", "10", "^", "e", "]", " ", "<>", " ", "\"\\\\times 10^{\"", " ", "<>", " ", "ToString", "[", "e", "]", " ", "<>", " ", "\"}\"", ",", " ", "show", "[", "x", "]", "]", "\n", "]", ";", "\n", "texNumber", "[", "_", "]", " ", ":=", " ", "\"\\\\text{---}\"", ";", "\n", "texMetric", "[", "r", "_", ",", " ", "key", "_", ",", " ", "spread", "_", " ", ":", " ", "True", "]", " ", ":=", " ", "Module", "[", "{", "s", " ", "=", " ", "r", "[", "key", "]", "}", ",", "\n", "  ", "\"$\"", " ", "<>", " ", "texNumber", "[", "s", "[", "\"Mean\"", "]", "]", " ", "<>", "\n", "    ", "If", "[", "TrueQ", "[", "spread", "]", " ", "&&", " ", "NumberQ", "[", "s", "[", "\"SD\"", "]", "]", ",", " ", "\"\\\\pm \"", " ", "<>", " ", "texNumber", "[", "s", "[", "\"SD\"", "]", "]", ",", " ", "\"\"", "]", " ", "<>", " ", "\"$\"", "\n", "]", ";", "\n", "checkpointText", "[", "cp", "_", "]", " ", ":=", " ", "If", "[", "cp", " ", "===", " ", "\"Best\"", ",", " ", "\"validation-selected checkpoint\"", ",", " ", "\"final checkpoint\"", "]", ";", "\n", "texTable", "[", "headers", "_", "List", ",", " ", "rows", "_", "List", ",", " ", "caption", "_", "String", ",", " ", "label", "_", "String", "]", " ", ":=", " ", "StringRiffle", "[", "Join", "[", "\n", "  ", "{", "\"\\\\begin{table}[!htbp]\"", ",", " ", "\"\\\\centering\"", ",", " ", "\"\\\\small\"", ",", " ", "\"\\\\renewcommand{\\\\arraystretch}{1.18}\"", ",", "\n", "   ", "\"\\\\setlength{\\\\tabcolsep}{4pt}\"", ",", " ", "\"\\\\resizebox{\\\\textwidth}{!}{%\"", ",", "\n", "   ", "\"\\\\begin{tabular}{@{}\"", " ", "<>", " ", "StringRepeat", "[", "\"l\"", ",", " ", "Length", "[", "headers", "]", "]", " ", "<>", " ", "\"@{}}\"", ",", " ", "\"\\\\toprule\"", ",", "\n", "   ", "StringRiffle", "[", "headers", ",", " ", "\" & \"", "]", " ", "<>", " ", "\" \\\\\\\\\"", ",", " ", "\"\\\\midrule\"", "}", ",", "\n", "  ", "(", "StringRiffle", "[", "#", ",", " ", "\" & \"", "]", " ", "<>", " ", "\" \\\\\\\\\"", " ", "&", " ", "/@", " ", "rows", ")", ",", "\n", "  ", "{", "\"\\\\bottomrule\"", ",", " ", "\"\\\\end{tabular}}\"", ",", " ", "\"\\\\caption{\\\\textsf{\"", " ", "<>", " ", "caption", " ", "<>", " ", "\"}}\"", ",", "\n", "   ", "\"\\\\label{\"", " ", "<>", " ", "label", " ", "<>", " ", "\"}\"", ",", " ", "\"\\\\end{table}\"", ",", " ", "\"\"", "}", "]", ",", " ", "\"\\n\"", "]", ";"}]], "Input" , CellTags -> "input-34", InitializationCell -> True],

Cell[BoxData[RowBox[{"ClearAll", "[", "chlTableTeX", ",", " ", "depthTableTeX", "]", ";", "\n", "chlTableTeX", "[", "t", "_", "Integer", ",", " ", "cp", "_", "String", "]", " ", ":=", " ", "Module", "[", "{", "g", " ", "=", " ", "chlGroups", "[", "t", ",", " ", "cp", "]", ",", " ", "body", ",", " ", "rounds", "}", ",", "\n", "  ", "If", "[", "g", " ", "===", " ", "{", "}", ",", " ", "Return", "[", "\"\"", "]", "]", ";", "\n", "  ", "body", " ", "=", " ", "Map", "[", "Function", "[", "r", ",", " ", "{", "If", "[", "experimentLabel", "[", "r", "]", " ", "===", " ", "\"eta\"", ",", " ", "\"$\\\\eta$\"", ",", " ", "\"$\"", " ", "<>", " ", "experimentLabel", "[", "r", "]", " ", "<>", " ", "\"$\"", "]", ",", "\n", "    ", "texEscape", "[", "r", "[", "\"Optimizer\"", "]", "]", ",", " ", "texMetric", "[", "r", ",", " ", "\"TrainLoss\"", ",", " ", "False", "]", ",", " ", "texMetric", "[", "r", ",", " ", "\"ValidationLoss\"", ",", " ", "False", "]", ",", "\n", "    ", "texMetric", "[", "r", ",", " ", "\"TestMAPE\"", "]", ",", " ", "texMetric", "[", "r", ",", " ", "\"TestRMSE\"", "]", "}", "]", ",", " ", "g", "]", ";", "\n", "  ", "rounds", " ", "=", " ", "StringRiffle", "[", "ToString", " ", "/@", " ", "DeleteDuplicates", "[", "Lookup", "[", "g", ",", " ", "\"Rounds\"", "]", "]", ",", " ", "\", \"", "]", ";", "\n", "  ", "texTable", "[", "{", "\"Experiment\"", ",", " ", "\"Optimizer\"", ",", " ", "\"Training loss\"", ",", " ", "\"Val.\\\\ loss\"", ",", " ", "\"Test MAPE (\\\\%)\"", ",", " ", "\"Test RMSE\"", "}", ",", "\n", "    ", "body", ",", " ", "texEscape", "[", "chlTableDescriptions", "[", "t", "]", "]", " ", "<>", " ", "\". \"", " ", "<>", " ", "texEscape", "[", "checkpointText", "[", "cp", "]", "]", " ", "<>", "\n", "    ", "\"; training budget \"", " ", "<>", " ", "rounds", " ", "<>", " ", "\" rounds. Losses are means in the fitted target space. \"", " ", "<>", "\n", "    ", "\"Test errors use signed physical weights after decoding the predictions. Test entries give the mean \"", " ", "<>", "\n", "    ", "\"$\\\\pm$ sample standard deviation across \"", " ", "<>", " ", "ToString", "[", "Length", "[", "expectedSeeds", "]", "]", " ", "<>", "\n", "    ", "\" training seeds on a fixed data split. Architectures and all remaining settings are recorded with the runs.\"", ",", "\n", "    ", "\"tab:chl-\"", " ", "<>", " ", "ToString", "[", "t", "]", " ", "<>", " ", "\"-\"", " ", "<>", " ", "ToLowerCase", "[", "cp", "]", "]", "\n", "]", ";", "\n", "depthTableTeX", "[", "ds", "_", "String", ",", " ", "cp", "_", "String", "]", " ", ":=", " ", "Module", "[", "{", "g", ",", " ", "body", "}", ",", "\n", "  ", "g", " ", "=", " ", "Select", "[", "summaryByCheckpoint", "[", "cp", "]", ",", " ", "#", "[", "\"Study\"", "]", " ", "===", " ", "\"width_depth\"", " ", "&&", " ", "#", "[", "\"Dataset\"", "]", " ", "===", " ", "ds", " ", "&", "]", ";", "\n", "  ", "If", "[", "g", " ", "===", " ", "{", "}", ",", " ", "Return", "[", "\"\"", "]", "]", ";", "\n", "  ", "body", " ", "=", " ", "Map", "[", "Function", "[", "r", ",", " ", "{", "texEscape", "[", "architectureLabel", "[", "r", "]", "]", ",", " ", "texEscape", "[", "r", "[", "\"Optimizer\"", "]", "]", ",", "\n", "    ", "ToString", "[", "r", "[", "\"Parameters\"", "]", "]", ",", " ", "ToString", "[", "r", "[", "\"SeedCount\"", "]", "]", ",", " ", "texMetric", "[", "r", ",", " ", "\"TrainLoss\"", ",", " ", "False", "]", ",", "\n", "    ", "texMetric", "[", "r", ",", " ", "\"ValidationLoss\"", ",", " ", "False", "]", ",", " ", "texMetric", "[", "r", ",", " ", "\"TestMAPE\"", "]", ",", " ", "texMetric", "[", "r", ",", " ", "\"TestRMSE\"", "]", "}", "]", ",", " ", "g", "]", ";", "\n", "  ", "texTable", "[", "{", "\"Depth x width / model\"", ",", " ", "\"Optimizer\"", ",", " ", "\"$P$\"", ",", " ", "\"$n$\"", ",", " ", "\"Train loss\"", ",", " ", "\"Val.\\\\ loss\"", ",", " ", "\"MAPE (\\\\%)\"", ",", " ", "\"RMSE\"", "}", ",", "\n", "    ", "body", ",", " ", "texEscape", "[", "ds", "]", " ", "<>", " ", "\", \"", " ", "<>", " ", "checkpointText", "[", "cp", "]", " ", "<>", " ", "\". Uniform architectures are labelled by \"", " ", "<>", "\n", "    ", "\"hidden-layer count and width; Net1 and Net3 retain their tapered widths. $P$ denotes trainable \"", " ", "<>", "\n", "    ", "\"parameters and $n$ training seeds. Losses use the fitted target. Test MAPE and RMSE use physical \"", " ", "<>", "\n", "    ", "\"weights and show mean $\\\\pm$ sample standard deviation across seeds.\"", ",", "\n", "    ", "\"tab:depth-\"", " ", "<>", " ", "StringReplace", "[", "ds", ",", " ", "\"_\"", " ", "->", " ", "\"-\"", "]", " ", "<>", " ", "\"-\"", " ", "<>", " ", "ToLowerCase", "[", "cp", "]", "]", "\n", "]", ";"}]], "Input" , CellTags -> "input-35", InitializationCell -> True],

Cell[BoxData[RowBox[{"ClearAll", "[", "findDepthGroup", ",", " ", "comparisonParagraphs", ",", " ", "appendixTeX", "]", ";", "\n", "findDepthGroup", "[", "ds", "_", ",", " ", "d", "_", ",", " ", "w", "_", ",", " ", "cp", "_", "]", " ", ":=", " ", "SelectFirst", "[", "summaryByCheckpoint", "[", "cp", "]", ",", "\n", "  ", "#", "[", "\"Study\"", "]", " ", "===", " ", "\"width_depth\"", " ", "&&", " ", "#", "[", "\"Dataset\"", "]", " ", "===", " ", "ds", " ", "&&", "\n", "  ", "#", "[", "\"Optimizer\"", "]", " ", "===", " ", "primaryOptimizer", "[", "ds", "]", " ", "&&", " ", "#", "[", "\"HiddenLayers\"", "]", " ", "===", " ", "d", " ", "&&", " ", "Lookup", "[", "#", ",", " ", "\"Width\"", "]", " ", "===", " ", "w", " ", "&", ",", "\n", "  ", "Missing", "[", "\"NotScheduled\"", "]", "]", ";", "\n", "comparisonParagraphs", "[", "cp", "_", "String", "]", " ", ":=", " ", "Module", "[", "{", "paragraphs", " ", "=", " ", "{", "}", ",", " ", "a", ",", " ", "b", ",", " ", "pairs", "}", ",", "\n", "  ", "Do", "[", "\n", "    ", "a", " ", "=", " ", "findDepthGroup", "[", "ds", ",", " ", "1", ",", " ", "width", ",", " ", "cp", "]", ";", " ", "b", " ", "=", " ", "findDepthGroup", "[", "ds", ",", " ", "3", ",", " ", "width", ",", " ", "cp", "]", ";", "\n", "    ", "If", "[", "AssociationQ", "[", "a", "]", " ", "&&", " ", "AssociationQ", "[", "b", "]", ",", " ", "AppendTo", "[", "paragraphs", ",", "\n", "      ", "\"For \"", " ", "<>", " ", "texEscape", "[", "ds", "]", " ", "<>", " ", "\" at width $\"", " ", "<>", " ", "ToString", "[", "width", "]", " ", "<>", " ", "\"$ with \"", " ", "<>", "\n", "      ", "texEscape", "[", "primaryOptimizer", "[", "ds", "]", "]", " ", "<>", " ", "\", increasing the number of hidden layers from one to three \"", " ", "<>", "\n", "      ", "\"changes mean test MAPE from $\"", " ", "<>", " ", "texNumber", "[", "a", "[", "\"TestMAPE\"", "]", "[", "\"Mean\"", "]", "]", " ", "<>", " ", "\"\\\\%$ to $\"", " ", "<>", "\n", "      ", "texNumber", "[", "b", "[", "\"TestMAPE\"", "]", "[", "\"Mean\"", "]", "]", " ", "<>", " ", "\"\\\\%$, and mean test RMSE from $\"", " ", "<>", "\n", "      ", "texNumber", "[", "a", "[", "\"TestRMSE\"", "]", "[", "\"Mean\"", "]", "]", " ", "<>", " ", "\"$ to $\"", " ", "<>", " ", "texNumber", "[", "b", "[", "\"TestRMSE\"", "]", "[", "\"Mean\"", "]", "]", " ", "<>", " ", "\"$.\"", "]", "]", ",", "\n", "    ", "{", "ds", ",", " ", "widthDepthDatasets", "}", ",", " ", "{", "width", ",", " ", "{", "16", ",", " ", "128", "}", "}", "]", ";", "\n", "  ", "pairs", " ", "=", " ", "pairedOptimizerRows", "[", "metricsByCheckpoint", "[", "cp", "]", "]", ";", "\n", "  ", "Do", "[", "AppendTo", "[", "paragraphs", ",", " ", "\"For \"", " ", "<>", " ", "texEscape", "[", "p", "[", "\"Dataset\"", "]", "]", " ", "<>", " ", "\", \"", " ", "<>", "\n", "    ", "texEscape", "[", "p", "[", "\"Architecture\"", "]", "]", " ", "<>", " ", "\", the paired mean ADAM-minus-RMSProp test MAPE difference is $\"", " ", "<>", "\n", "    ", "texNumber", "[", "p", "[", "\"MAPE difference mean\"", "]", "]", " ", "<>", " ", "\"$ percentage points\"", " ", "<>", "\n", "    ", "If", "[", "NumberQ", "[", "p", "[", "\"MAPE difference SD\"", "]", "]", ",", " ", "\" (sample standard deviation $\"", " ", "<>", "\n", "      ", "texNumber", "[", "p", "[", "\"MAPE difference SD\"", "]", "]", " ", "<>", " ", "\"$)\"", ",", " ", "\"\"", "]", " ", "<>", " ", "\". \"", " ", "<>", "\n", "    ", "If", "[", "TrueQ", "[", "p", "[", "\"PairingVerified\"", "]", "]", ",", " ", "\"The recorded split, initialization and minibatch hashes agree within each pair.\"", ",", "\n", "      ", "\"The recorded pairing hashes differ; treat this as an unpaired descriptive comparison.\"", "]", "]", ",", " ", "{", "p", ",", " ", "pairs", "}", "]", ";", "\n", "  ", "StringRiffle", "[", "paragraphs", ",", " ", "\"\\n\\n\"", "]", "\n", "]", ";", "\n", "appendixTeX", "[", "cp", "_", "String", "]", " ", ":=", " ", "Module", "[", "{", "r", ",", " ", "counts", ",", " ", "budget", ",", " ", "initializers", ",", " ", "nNear", ",", " ", "nTotal", "}", ",", "\n", "  ", "r", " ", "=", " ", "Select", "[", "metricsByCheckpoint", "[", "cp", "]", ",", " ", "#", "[", "\"Study\"", "]", " ", "===", " ", "\"width_depth\"", " ", "&", "]", ";", "\n", "  ", "If", "[", "r", " ", "===", " ", "{", "}", ",", " ", "Return", "[", "\"\"", "]", "]", ";", "\n", "  ", "counts", " ", "=", " ", "Counts", "[", "Lookup", "[", "r", ",", " ", "\"Dataset\"", "]", "]", ";", "\n", "  ", "budget", " ", "=", " ", "StringRiffle", "[", "ToString", " ", "/@", " ", "DeleteDuplicates", "[", "Lookup", "[", "r", ",", " ", "\"Rounds\"", "]", "]", ",", " ", "\", \"", "]", ";", "\n", "  ", "initializers", " ", "=", " ", "StringRiffle", "[", "texEscape", " ", "/@", " ", "DeleteDuplicates", "[", "Lookup", "[", "r", ",", " ", "\"Initializer\"", "]", "]", ",", " ", "\", \"", "]", ";", "\n", "  ", "nTotal", " ", "=", " ", "Length", "[", "Select", "[", "metricsByCheckpoint", "[", "\"Final\"", "]", ",", " ", "#", "[", "\"Study\"", "]", " ", "===", " ", "\"width_depth\"", " ", "&", "]", "]", ";", "\n", "  ", "nNear", " ", "=", " ", "Count", "[", "Select", "[", "metricsByCheckpoint", "[", "\"Final\"", "]", ",", " ", "#", "[", "\"Study\"", "]", " ", "===", " ", "\"width_depth\"", " ", "&", "]", ",", "\n", "    ", "x", "_", " ", "/;", " ", "NumberQ", "[", "Lookup", "[", "x", ",", " ", "\"TrainNRMSE\"", "]", "]", " ", "&&", " ", "x", "[", "\"TrainNRMSE\"", "]", " ", "<=", " ", "0.001", "]", ";", "\n", "  ", "\"\\\\section{Additional validation: \"", " ", "<>", " ", "checkpointText", "[", "cp", "]", " ", "<>", " ", "\"}\\n\"", " ", "<>", "\n", "  ", "\"The study compares architectures on \"", " ", "<>", " ", "StringRiffle", "[", "texEscape", " ", "/@", " ", "Keys", "[", "counts", "]", ",", " ", "\", \"", "]", " ", "<>", "\n", "  ", "\". Each configuration uses \"", " ", "<>", " ", "ToString", "[", "Length", "[", "expectedSeeds", "]", "]", " ", "<>", " ", "\" training seeds on a fixed \"", " ", "<>", "\n", "  ", "\"data partition and a budget of \"", " ", "<>", " ", "budget", " ", "<>", " ", "\" training rounds. Recorded initialization: \"", " ", "<>", " ", "initializers", " ", "<>", " ", "\". The \"", " ", "<>", "\n", "  ", "\"initialization and training seeds, split, learning rate and full architecture are stored with every run. \"", " ", "<>", "\n", "  ", "\"The present section reports the \"", " ", "<>", " ", "checkpointText", "[", "cp", "]", " ", "<>", " ", "\". Validation selection minimizes \"", " ", "<>", "\n", "  ", "\"validation MSE in the fitted target space and does not use test errors.\\n\\n\"", " ", "<>", "\n", "  ", "\"Recorded input transformations: \"", " ", "<>", " ", "StringRiffle", "[", "texEscape", " ", "/@", " ", "DeleteDuplicates", "[", "Lookup", "[", "r", ",", " ", "\"InputTransform\"", "]", "]", ",", " ", "\", \"", "]", " ", "<>", "\n", "  ", "\". Recorded target transformations: \"", " ", "<>", " ", "StringRiffle", "[", "texEscape", " ", "/@", " ", "DeleteDuplicates", "[", "Lookup", "[", "r", ",", " ", "\"TargetTransform\"", "]", "]", ",", " ", "\", \"", "]", " ", "<>", "\n", "  ", "\". Standardized weights use only the training-set mean and sample standard deviation; \"", " ", "<>", "\n", "  ", "\"log absolute powers use the recorded sign and family weight when decoded. Predictions are decoded to \"", " ", "<>", "\n", "  ", "\"signed physical weights before MAPE and RMSE are computed. Sample standard deviations over seeds \"", " ", "<>", "\n", "  ", "\"describe training variability on the fixed split.\\n\\n\"", " ", "<>", "\n", "  ", "StringRiffle", "[", "depthTableTeX", "[", "#", ",", " ", "cp", "]", " ", "&", " ", "/@", " ", "widthDepthDatasets", ",", " ", "\"\\n\\\\clearpage\\n\"", "]", " ", "<>", "\n", "  ", "\"\\n\\\\clearpage\\n\\\\subsection*{Recorded comparisons}\\n\"", " ", "<>", " ", "comparisonParagraphs", "[", "cp", "]", " ", "<>", "\n", "  ", "\"\\n\\nChanging depth at fixed width also changes parameter count. These are descriptive comparisons \"", " ", "<>", "\n", "  ", "\"within the scheduled grid, not a depth comparison at fixed capacity. Optimizer differences refer \"", " ", "<>", "\n", "  ", "\"to the recorded settings rather than independently optimized learning-rate searches.\\n\\n\"", " ", "<>", "\n", "  ", "\"At the final checkpoint, \"", " ", "<>", " ", "ToString", "[", "nNear", "]", " ", "<>", " ", "\" of \"", " ", "<>", " ", "ToString", "[", "nTotal", "]", " ", "<>", "\n", "  ", "\" width/depth fits have training NRMSE at most $10^{-3}$. This is only a numerical convention \"", " ", "<>", "\n", "  ", "\"for near interpolation. A double-descent claim would additionally require a reproducible \"", " ", "<>", "\n", "  ", "\"test-error peak near a resolved interpolation transition followed by a decline. Neither a \"", " ", "<>", "\n", "  ", "\"parameter count larger than the training sample nor an isolated non-monotone curve establishes it.\\n\"", "\n", "]", ";"}]], "Input" , CellTags -> "input-36", InitializationCell -> True],

Cell[BoxData[RowBox[{"reportPreamble", " ", "=", " ", "\"\\\\documentclass[11pt,a4paper]{article}\\n\"", " ", "<>", "\n", "  ", "\"\\\\usepackage[margin=20mm]{geometry}\\n\\\\usepackage[T1]{fontenc}\\n\\\\usepackage{lmodern}\\n\"", " ", "<>", "\n", "  ", "\"\\\\usepackage{amsmath,booktabs,graphicx}\\n\\\\usepackage[hidelinks]{hyperref}\\n\"", " ", "<>", "\n", "  ", "\"\\\\setlength{\\\\parindent}{0pt}\\n\\\\setlength{\\\\parskip}{6pt}\\n\"", " ", "<>", "\n", "  ", "\"\\\\title{Additional validation and CHL experiments}\\n\\\\author{}\\n\\\\date{}\\n\\\\begin{document}\\n\\\\maketitle\\n\"", ";", "\n", "metricProtocolTeX", " ", "=", " ", "\"All test errors use the signed physical weight $w$:\\n\"", " ", "<>", "\n", "  ", "\"\\\\[\\\\mathrm{MAPE}=\\\\frac{100}{n}\\\\sum_{i=1}^{n}\\\\frac{|\\\\widehat w_i-w_i|}{|w_i|},\"", " ", "<>", "\n", "  ", "\"\\\\qquad\\\\mathrm{RMSE}=\\\\sqrt{\\\\frac1n\\\\sum_{i=1}^{n}(\\\\widehat w_i-w_i)^2}.\\\\]\\n\"", " ", "<>", "\n", "  ", "\"Training and validation losses remain in the fitted target space. They must not be compared \"", " ", "<>", "\n", "  ", "\"across different target transformations. The two checkpoint conventions are reported separately. \"", " ", "<>", "\n", "  ", "\"They reuse the same fits and do not double the number of seeds.\\n\"", ";", "\n", "ClearAll", "[", "figureTeX", "]", ";", "\n", "figureTeX", "[", "kind", "_", "String", ",", " ", "ds", "_", "String", "]", " ", ":=", "\n", "  ", "\"\\\\begin{figure}[!htbp]\\\\centering\\n\\\\includegraphics[width=.88\\\\textwidth]{\"", " ", "<>", "\n", "  ", "kind", " ", "<>", " ", "\"_\"", " ", "<>", " ", "ds", " ", "<>", " ", "\".pdf}\\n\\\\caption{\\\\textsf{\"", " ", "<>", " ", "texEscape", "[", "ds", "]", " ", "<>", " ", "\", \"", " ", "<>", "\n", "  ", "kind", " ", "<>", " ", "\" comparison at the \"", " ", "<>", " ", "checkpointText", "[", "plotCheckpoint", "]", " ", "<>", " ", "\". Points show means across training seeds. \"", " ", "<>", "\n", "  ", "If", "[", "kind", " ", "===", " ", "\"capacity\"", ",", " ", "\"One hidden layer; width varies.\"", ",", " ", "\"Width 128; depth varies.\"", "]", " ", "<>", "\n", "  ", "\"}}\\\\end{figure}\\n\"", ";", "\n", "If", "[", "TrueQ", "[", "exportReports", "]", ",", "\n", "  ", "If", "[", "!", "DirectoryQ", "[", "outputDirectory", "]", ",", " ", "CreateDirectory", "[", "outputDirectory", ",", " ", "CreateIntermediateDirectories", " ", "->", " ", "True", "]", "]", ";", "\n", "  ", "Do", "[", "If", "[", "chlGroups", "[", "t", ",", " ", "cp", "]", " ", "=!=", " ", "{", "}", ",", "\n", "    ", "Export", "[", "FileNameJoin", "[", "{", "outputDirectory", ",", " ", "\"chl_table_\"", " ", "<>", " ", "ToString", "[", "t", "]", " ", "<>", " ", "\"_\"", " ", "<>", " ", "ToLowerCase", "[", "cp", "]", " ", "<>", " ", "\".tex\"", "}", "]", ",", "\n", "      ", "chlTableTeX", "[", "t", ",", " ", "cp", "]", ",", " ", "\"Text\"", "]", "]", ",", " ", "{", "cp", ",", " ", "{", "\"Best\"", ",", " ", "\"Final\"", "}", "}", ",", " ", "{", "t", ",", " ", "2", ",", " ", "7", "}", "]", ";", "\n", "  ", "If", "[", "widthDepthDatasets", " ", "=!=", " ", "{", "}", ",", "\n", "    ", "Do", "[", "Export", "[", "FileNameJoin", "[", "{", "outputDirectory", ",", " ", "\"additional_validation_\"", " ", "<>", " ", "ToLowerCase", "[", "cp", "]", " ", "<>", " ", "\".tex\"", "}", "]", ",", "\n", "      ", "appendixTeX", "[", "cp", "]", ",", " ", "\"Text\"", "]", ",", " ", "{", "cp", ",", " ", "{", "\"Best\"", ",", " ", "\"Final\"", "}", "}", "]", "]", ";", "\n", "  ", "KeyValueMap", "[", "Export", "[", "FileNameJoin", "[", "{", "outputDirectory", ",", " ", "\"capacity_\"", " ", "<>", " ", "#", "1", " ", "<>", " ", "\".pdf\"", "}", "]", ",", " ", "#", "2", ",", " ", "\"PDF\"", "]", " ", "&", ",", " ", "capacityFigures", "]", ";", "\n", "  ", "KeyValueMap", "[", "Export", "[", "FileNameJoin", "[", "{", "outputDirectory", ",", " ", "\"depth_\"", " ", "<>", " ", "#", "1", " ", "<>", " ", "\".pdf\"", "}", "]", ",", " ", "#", "2", ",", " ", "\"PDF\"", "]", " ", "&", ",", " ", "depthFigures", "]", ";", "\n", "  ", "reportBody", " ", "=", " ", "reportPreamble", " ", "<>", " ", "metricProtocolTeX", " ", "<>", "\n", "    ", "StringRiffle", "[", "Table", "[", "\n", "      ", "If", "[", "widthDepthDatasets", " ", "=!=", " ", "{", "}", ",", " ", "\"\\\\clearpage\\n\"", " ", "<>", " ", "appendixTeX", "[", "cp", "]", ",", " ", "\"\"", "]", " ", "<>", "\n", "      ", "With", "[", "{", "tables", " ", "=", " ", "Select", "[", "Range", "[", "2", ",", " ", "7", "]", ",", " ", "chlGroups", "[", "#", ",", " ", "cp", "]", " ", "=!=", " ", "{", "}", " ", "&", "]", "}", ",", "\n", "        ", "If", "[", "tables", " ", "===", " ", "{", "}", ",", " ", "\"\"", ",", " ", "\"\\\\clearpage\\n\\\\section{CHL tables: \"", " ", "<>", " ", "checkpointText", "[", "cp", "]", " ", "<>", " ", "\"}\\n\"", " ", "<>", "\n", "          ", "StringRiffle", "[", "chlTableTeX", "[", "#", ",", " ", "cp", "]", " ", "&", " ", "/@", " ", "tables", ",", " ", "\"\\n\\\\clearpage\\n\"", "]", "]", "]", ",", "\n", "      ", "{", "cp", ",", " ", "{", "\"Best\"", ",", " ", "\"Final\"", "}", "}", "]", ",", " ", "\"\\n\"", "]", " ", "<>", "\n", "    ", "If", "[", "capacityDatasets", " ", "===", " ", "{", "}", " ", "&&", " ", "depthDatasets", " ", "===", " ", "{", "}", ",", " ", "\"\"", ",", "\n", "      ", "\"\\n\\\\clearpage\\n\\\\section{Capacity and depth curves}\\n\"", " ", "<>", "\n", "      ", "StringRiffle", "[", "Join", "[", "figureTeX", "[", "\"capacity\"", ",", " ", "#", "]", " ", "&", " ", "/@", " ", "capacityDatasets", ",", "\n", "        ", "figureTeX", "[", "\"depth\"", ",", " ", "#", "]", " ", "&", " ", "/@", " ", "depthDatasets", "]", ",", " ", "\"\\n\"", "]", "]", " ", "<>", "\n", "    ", "\"\\n\\\\end{document}\\n\"", ";", "\n", "  ", "Export", "[", "FileNameJoin", "[", "{", "outputDirectory", ",", " ", "\"report.tex\"", "}", "]", ",", " ", "reportBody", ",", " ", "\"Text\"", "]", ";", "\n", "  ", "Print", "[", "\"Written to \"", ",", " ", "outputDirectory", "]", ",", "\n", "  ", "\"Export is disabled. Set exportReports = True to write the tables, appendix and report.\"", "\n", "]"}]], "Input" , CellTags -> "input-37"],

Cell["To compile the exported standalone document, open a terminal in the printed outputDirectory (by default generated/reports) and run pdflatex report.tex twice. The individual chl_table_*.tex and additional_validation_*.tex files are fragments for inclusion in an existing manuscript with amsmath, booktabs and graphicx loaded. Review the generated prose against the intended manuscript scope before inclusion. Editing the analysis cells changes reporting only; it does not alter any recorded fit.", "Text"]
}, Open]]
},
 WindowSize -> {1100, 850}, WindowMargins -> {{Automatic, Automatic}, {Automatic, Automatic}},
 WindowTitle -> "Results and manuscript tables",
 CellContext -> Notebook, ShowCellBracket -> True, Magnification -> 1.,
 TaggingRules -> <|"Bundle" -> "ModularFormsNotebooks", "NotebookNumber" -> 3|>,
 StyleDefinitions -> Notebook[{
 Cell[StyleData[StyleDefinitions -> "Default.nb"]],
 Cell[StyleData["Title"], FontFamily -> "Helvetica", FontSize -> 28,
  FontWeight -> "Plain", FontColor -> RGBColor[0.16, 0.23, 0.31], CellMargins -> {{36, 24}, {12, 28}}],
 Cell[StyleData["Subtitle"], FontFamily -> "Helvetica", FontSize -> 14,
  FontColor -> GrayLevel[0.4], CellMargins -> {{36, 24}, {18, 0}}],
 Cell[StyleData["Section"], FontFamily -> "Helvetica", FontSize -> 21,
  FontColor -> RGBColor[0.16, 0.23, 0.31], CellMargins -> {{36, 24}, {10, 24}}],
 Cell[StyleData["Subsection"], FontFamily -> "Helvetica", FontSize -> 16,
  FontColor -> GrayLevel[0.22], CellMargins -> {{36, 24}, {8, 18}}],
 Cell[StyleData["Text"], FontFamily -> "Helvetica", FontSize -> 13,
  LineSpacing -> {1.15, 2}, CellMargins -> {{36, 30}, {9, 7}}],
 Cell[StyleData["Input"], FontSize -> 12, CellMargins -> {{54, 24}, {9, 9}}],
 Cell[StyleData["Output"], FontSize -> 12, CellMargins -> {{54, 24}, {9, 5}}]
 }, Visible -> False]]
